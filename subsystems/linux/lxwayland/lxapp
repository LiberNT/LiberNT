# PURPOSE:     Starts a Linux GUI program on the LiberNT Wayland compositor
# COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

LIB=/usr/local/lib/libernt
export WAYLAND_DISPLAY=/run/lxwayland/wayland-0
export XDG_RUNTIME_DIR=/run/user/0
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export HOME="${HOME:-/root}"

[ -e /var/lib/libernt/gui-setup-done ] || "$LIB/gui-setup"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

if [ ! -S "$WAYLAND_DISPLAY" ]; then
    if [ -d /run/systemd/system ] && systemctl -q is-enabled lxwayland.service 2>/dev/null; then
        systemctl start lxwayland.service
    else
        setsid /usr/bin/python3 "$LIB/lxwayland/lxwayland.py" </dev/null >/dev/null 2>&1 &
    fi
    i=0
    while [ ! -S "$WAYLAND_DISPLAY" ] && [ $i -lt 50 ]; do
        sleep 0.1
        i=$((i + 1))
    done
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

[ $# -gt 0 ] || exit 0
exec "$@"
