# PURPOSE:     Runs the package triggers of the GUI packages added to the root file system
# COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

exec 9>/run/lx-gui-setup.lock
flock 9
[ -e /var/lib/libernt/gui-setup-done ] && exit 0
echo "gui-setup: libraries"
ldconfig
echo "gui-setup: schemas, loaders and icons"
[ -d /usr/share/glib-2.0/schemas ] && glib-compile-schemas /usr/share/glib-2.0/schemas
for q in /usr/lib/*/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders; do
    [ -x "$q" ] && "$q" --update-cache
done
for d in /usr/share/icons/*/; do
    [ -f "$d/index.theme" ] && command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t -f "$d"
done
echo "gui-setup: mime database"
command -v update-mime-database >/dev/null && update-mime-database /usr/share/mime
echo "gui-setup: fonts"
command -v fc-cache >/dev/null && fc-cache -s
command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications
mkdir -p /var/lib/libernt
touch /var/lib/libernt/gui-setup-done
echo "gui-setup: done"
