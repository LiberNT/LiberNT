    IDS_SEVERITY_SUCCESS        "Success"
    IDS_SEVERITY_INFORMATIONAL  "System Information"
    IDS_SEVERITY_WARNING        "System Warning"
    IDS_SEVERITY_ERROR          "System Error"
END

STRINGTABLE
BEGIN
    IDS_SYSTEM_PROCESS          "System Process"
    IDS_UNKNOWN_SOFTWARE_EXCEPT "unknown software exception"
    IDS_OK_TERMINATE_PROGRAM    "Click on OK to terminate the program."
    IDS_CANCEL_DEBUG_PROGRAM    "Click on CANCEL to debug the program."
END

STRINGTABLE
BEGIN
    IDS_BLOCK_RESTART_TITLE_ONE               "Closing 1 app and restarting"
    IDS_BLOCK_RESTART_TITLE                   "Closing %u apps and restarting"
    IDS_BLOCK_RESTART_REASON                  "This app is preventing restart."
    IDS_BLOCK_RESTART_FORCE                   "Restart anyway"
    IDS_BLOCK_SHUTDOWN_TITLE_ONE              "Closing 1 app and shutting down"
    IDS_BLOCK_SHUTDOWN_TITLE                  "Closing %u apps and shutting down"
    IDS_BLOCK_SHUTDOWN_REASON                 "This app is preventing shutdown."
    IDS_BLOCK_SHUTDOWN_FORCE                  "Shut down anyway"
    IDS_BLOCK_SIGNOUT_TITLE_ONE               "Closing 1 app and signing out"
    IDS_BLOCK_SIGNOUT_TITLE                   "Closing %u apps and signing out"
    IDS_BLOCK_SIGNOUT_REASON                  "This app is preventing you from signing out."
    IDS_BLOCK_SIGNOUT_FORCE                   "Sign out anyway"
    IDS_BLOCK_HINT                            "To go back and save your work, click Cancel and finish what you need to."
    IDS_BLOCK_CANCEL                          "Cancel"
END
