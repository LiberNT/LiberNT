#define REACTOS_STR_COMPANY_NAME       "eotics.com"
#define REACTOS_STR_FILE_DESCRIPTION   "lntget Package Manager (GPLv3+)"
#define REACTOS_STR_INTERNAL_NAME      "lntget"
#define REACTOS_STR_LEGAL_COPYRIGHT    "Copyright (C) 2026 Ahmed Arif"
#define REACTOS_STR_ORIGINAL_FILENAME  "lntget.exe"
#define REACTOS_STR_PRODUCT_NAME       "lntget"
#include <reactos/version.rc>

#include <windef.h>
#include <winuser.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_LNTGET ICON "res/lntget.ico"
IDR_ICON_SOURCE_NOTICE RCDATA "res/ICON-SOURCE.txt"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "lntget.exe.manifest"
