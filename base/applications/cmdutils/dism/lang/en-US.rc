LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_HEADER "\nDeployment Image Servicing and Management tool\nVersion: %s\n\n"
    IDS_ERROR_DECIMAL "\nError: %lu\n\n"
    IDS_ERROR_HEX "\nError: 0x%08lx\n\n"
    IDS_LOG_LOCATION "\nThe DISM log file can be found at %s\n"
    IDS_UNRECOGNIZED_TOKEN "DISM doesn't recognize the command-line option ""%s"". \nFor more information, refer to the help by running DISM.exe /?.\n"
    IDS_UNKNOWN_OPTION "The %s option is unknown. \nFor more information, refer to the help by running DISM.exe /?.\n"
    IDS_MISSING_OPTION "The command-line is missing the %s option.\nFor more information, refer to the help.\n"
    IDS_OPTIONS_CONFLICT "The %s and %s options cannot be used together on the command-line.\nFor more information, refer to the help.\n"
    IDS_OPTION_REQUIRED "A required option is missing from the command-line.\nEnsure that %s or %s is specified.\n"
    IDS_IMAGE_NOT_FOUND "The specified image does not exist in the specified image container.\nCheck the image container first for existing images.\n"
    IDS_INVALID_ARGUMENTS "An error occurred while processing the command.\nEnsure that the command-line arguments are valid. For more information, review the log file.\n"
END

