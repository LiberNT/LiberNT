    IDS_SP_BUILD "ServicePack Build : %s\n"
    IDS_SP_LEVEL "ServicePack Level : %s\n"
    IDS_EDITION "Edition : %s\n"
    IDS_INSTALLATION "Installation : %s\n"
    IDS_PRODUCT_TYPE "ProductType : %s\n"
    IDS_PRODUCT_SUITE "ProductSuite : %s\n"
    IDS_SYSTEM_ROOT "System Root : %s\n"
    IDS_DIRECTORIES "Directories : %s\n"
    IDS_FILES "Files : %s\n"
    IDS_CREATED "Created : %s\n"
    IDS_MODIFIED "Modified : %s\n"
    IDS_LANGUAGES "Languages :\n"
    IDS_LANGUAGES_UNDEFINED "Languages : <undefined>\n"
    IDS_LANGUAGE "\t%s\n"
    IDS_LANGUAGE_DEFAULT "\t%s (Default)\n"
    IDS_UNDEFINED "<undefined>"
