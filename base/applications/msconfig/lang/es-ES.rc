BEGIN
    IDS_SERVICES_COLUMN_SERVICE "Servicio"
    IDS_SERVICES_COLUMN_REQ "Necesario"
    IDS_SERVICES_COLUMN_VENDOR "Fabricante"
    IDS_SERVICES_COLUMN_STATUS "Estado"
END

