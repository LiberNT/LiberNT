BEGIN
    IDS_MSCONFIG "系统配置程序"
    IDS_TAB_GENERAL "常规"
    IDS_TAB_SERVICES "服务"
    IDS_TAB_STARTUP "启动"
    IDS_TAB_TOOLS "工具"
END

