BEGIN
    IDS_MSCONFIG "การตั้งค่าระบบ"
    IDS_TAB_GENERAL "ทั่วไป"
    IDS_TAB_SERVICES "บริการ"
    IDS_TAB_STARTUP "เริ่มงานเครื่อง"
    IDS_TAB_TOOLS "เครื่องมือ"
END

