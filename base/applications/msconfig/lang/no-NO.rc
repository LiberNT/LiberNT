BEGIN
    IDS_MSCONFIG "Systemkonfigurasjon"
    IDS_TAB_GENERAL "Generelt"
    IDS_TAB_SERVICES "Tjenester"
    IDS_TAB_STARTUP "Oppstart"
    IDS_TAB_TOOLS "Verktøy"
END

