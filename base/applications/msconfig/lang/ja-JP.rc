BEGIN
    IDS_SERVICES_COLUMN_SERVICE "サービス"
    IDS_SERVICES_COLUMN_REQ "必要"
    IDS_SERVICES_COLUMN_VENDOR "ベンダー"
    IDS_SERVICES_COLUMN_STATUS "状態"
END

