BEGIN
    IDS_SERVICES_COLUMN_SERVICE "Serviciu"
    IDS_SERVICES_COLUMN_REQ "Necesare"
    IDS_SERVICES_COLUMN_VENDOR "Furnizor"
    IDS_SERVICES_COLUMN_STATUS "Stare"
END

