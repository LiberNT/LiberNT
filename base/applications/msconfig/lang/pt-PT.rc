BEGIN
    IDS_SERVICES_COLUMN_SERVICE "Serviço"
    IDS_SERVICES_COLUMN_REQ "Essencial"
    IDS_SERVICES_COLUMN_VENDOR "Fabricante"
    IDS_SERVICES_COLUMN_STATUS "Status"
END

