LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_APP_TITLE "Web Browser"
    IDS_TITLE_FORMAT "%s - Web Browser"
    IDS_BACK "Back"
    IDS_FORWARD "Forward"
    IDS_RELOAD "Reload"
    IDS_LOADING "Opening %s..."
    IDS_DONE "Done"
    IDS_LOAD_FAILED "This page could not be opened."
    IDS_CERTIFICATE "The security certificate of this site is not valid, so the page was not opened."
    IDS_UNSUPPORTED "This address is not supported."
    IDS_START_FAILED "The web browser could not be started."
    IDS_SAVED "Saved %s"
    IDS_SAVE_FAILED "The file could not be saved."
    IDS_ALL_FILES "All files"
    IDS_STOP "Stop"
    IDS_MENU "Menu"
    IDS_STOPPED "Stopped"
    IDS_RECEIVED "%s received"
    IDS_RECEIVED_OF "%s of %s received"
    IDS_SECURE "Secure connection"
    IDS_NOT_SECURE "Not secure"
    IDS_NEW_WINDOW "&New window\tCtrl+N"
    IDS_SAVE_PAGE "&Save page as...\tCtrl+S"
    IDS_VIEW_SOURCE "View page &source\tCtrl+U"
    IDS_COPY_ADDRESS "&Copy address"
    IDS_ABOUT "&About Web Browser"
    IDS_ABOUT_TEXT "Web Browser\n\nShows web pages with the LiberNT web view: HTML and CSS by litehtml, JavaScript by QuickJS."
    IDS_WEB_PAGES "Web pages"
    IDS_SUBMIT "Submit"
    IDS_NO_SCRIPTS "This page uses scripts, which this build of the browser does not run, so parts of it may be missing."
END
