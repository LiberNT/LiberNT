LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MENU MENU
BEGIN
    POPUP "&View"
    BEGIN
        MENUITEM "&Standard\tAlt+1", IDM_STANDARD
        MENUITEM "S&cientific\tAlt+2", IDM_SCIENTIFIC
        MENUITEM "&Programmer\tAlt+3", IDM_PROGRAMMER
        MENUITEM SEPARATOR
        MENUITEM "Digit &grouping", IDM_GROUPING
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C", IDM_COPY
        MENUITEM "&Paste\tCtrl+V", IDM_PASTE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Calculator", IDM_ABOUT
    END
END

STRINGTABLE
BEGIN
    IDS_TITLE "Calculator"
    IDS_DIVIDE_BY_ZERO "Cannot divide by zero"
    IDS_INVALID_INPUT "Invalid input"
    IDS_OVERFLOW "Overflow"
    IDS_UNDEFINED "Result is undefined"
END
