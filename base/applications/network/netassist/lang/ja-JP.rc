LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_ASSIST DIALOGEX 0, 0, 264, 204
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ネットワーク支援"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON IDI_ASSIST, -1, 12, 12, 20, 20
    LTEXT "", IDC_STATE, 40, 16, 212, 12
    LTEXT "", IDC_DETAIL, 12, 40, 240, 82
    EDITTEXT IDC_KEY, 12, 126, 240, 14, ES_CENTER | ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "キーをコピー(&C)", IDC_COPY, 12, 146, 64, 14
    CONTROL "まずチームに連絡してください: <a href=""https://discord.gg/BpcKg7FZ2"">Discord</a> または <a href=""https://matrix.to/#/#libernt:matrix.org"">Matrix</a>。", IDC_LINKS, "SysLink", WS_TABSTOP, 12, 168, 240, 10
    DEFPUSHBUTTON "閉じる", IDCANCEL, 188, 182, 64, 14
END

STRINGTABLE
BEGIN
    IDS_ON "ネットワーク支援はオンです"
    IDS_ON_DETAIL "このブートはネットワーク支援付きで開始されました。下のキーを持つ LiberNT 開発者は、このコンピューターのカーネル デバッガーに接続して調査できます。\n\nサポートしている開発者にプライベート メッセージでキーを送信してください。キーは次回の再起動まで有効です。"
    IDS_OFF "ネットワーク支援はオフです"
    IDS_OFF_DETAIL "このコンピューターをネットワーク支援付きで起動すると、LiberNT 開発者はネットワーク経由で障害を調査できます:\n\n1. コンピューターを再起動します。\n2. ブート メニューで F8 キーを押します。\n3. ""Debugging"" を選択します。\n4. このプログラムをもう一度起動し、キーを開発者に送信します。"
    IDS_DENIED_DETAIL "このブートはネットワーク支援付きで開始されましたが、このアカウントにはキーを読み取る権限がありません。キーはデスクトップの隅にも表示されています。"
    IDS_COPIED "コピーしました"
    IDS_LINK_FAILED "このアドレスはここでは開けません。別のデバイスで開いてください:\n\n%s"
END
