LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_ASSIST DIALOGEX 0, 0, 264, 204
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "网络协助"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON IDI_ASSIST, -1, 12, 12, 20, 20
    LTEXT "", IDC_STATE, 40, 16, 212, 12
    LTEXT "", IDC_DETAIL, 12, 40, 240, 82
    EDITTEXT IDC_KEY, 12, 126, 240, 14, ES_CENTER | ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "复制密钥(&C)", IDC_COPY, 12, 146, 64, 14
    CONTROL "请先联系团队: <a href=""https://discord.gg/BpcKg7FZ2"">Discord</a> 或 <a href=""https://matrix.to/#/#libernt:matrix.org"">Matrix</a>。", IDC_LINKS, "SysLink", WS_TABSTOP, 12, 168, 240, 10
    DEFPUSHBUTTON "关闭", IDCANCEL, 188, 182, 64, 14
END

STRINGTABLE
BEGIN
    IDS_ON "网络协助已开启"
    IDS_ON_DETAIL "本次启动已开启网络协助。持有下方密钥的 LiberNT 开发人员可以连接到此计算机的内核调试器并对其进行检查。\n\n请通过私信将密钥发送给正在帮助你的开发人员。密钥在下次重新启动之前有效。"
    IDS_OFF "网络协助已关闭"
    IDS_OFF_DETAIL "当此计算机以网络协助方式启动时，LiberNT 开发人员可以通过网络检查此计算机上的故障:\n\n1. 重新启动计算机。\n2. 在启动菜单中按 F8。\n3. 选择 ""Debugging""。\n4. 再次启动此程序，并将密钥发送给开发人员。"
    IDS_DENIED_DETAIL "本次启动已开启网络协助，但此帐户无权读取密钥。密钥也显示在桌面的角落中。"
    IDS_COPIED "已复制"
    IDS_LINK_FAILED "无法在此处打开此地址。请在其他设备上打开:\n\n%s"
END
