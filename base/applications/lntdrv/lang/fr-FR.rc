LANGUAGE LANG_FRENCH, SUBLANG_NEUTRAL

IDD_FRAME DIALOGEX 0, 0, 420, 240
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Installateur de pilotes LiberNT"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_FRAME_TITLE, 120, 10, 290, 14, SS_NOPREFIX
    LTEXT "", IDC_FRAME_SUBTITLE, 120, 26, 290, 18, SS_NOPREFIX
    LTEXT "", IDC_FRAME_PAGE, 120, 48, 290, 160, NOT WS_VISIBLE
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 120, 212, 300, 1
    PUSHBUTTON "&Précédent", IDC_FRAME_BACK, 250, 219, 50, 14
    DEFPUSHBUTTON "&Suivant", IDC_FRAME_NEXT, 305, 219, 50, 14
    PUSHBUTTON "Annuler", IDCANCEL, 360, 219, 50, 14
END

IDD_DEVICES DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_DEVICES_STATUS, 0, 0, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL "", IDC_DEVICES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 12, 290, 116
    LTEXT "", IDC_DEVICES_NOTE, 0, 132, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON "&Détails", IDC_DETAILS, 0, 146, 56, 14
    PUSHBUTTON "&Tout cocher", IDC_SELECT_ALL, 60, 146, 56, 14
    PUSHBUTTON "Tout d&écocher", IDC_SELECT_NONE, 120, 146, 56, 14
    PUSHBUTTON "&Historique", IDC_HISTORY, 234, 146, 56, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_PROGRESS_TEXT, 0, 44, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "", IDC_PROGRESS_DETAIL, 0, 58, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_DONE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_RESULTS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 136
    LTEXT "", IDC_DONE_NOTE, 0, 140, 290, 18, SS_NOPREFIX
END

IDD_HISTORY DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_HISTORY_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 140
    PUSHBUTTON "&Restaurer", IDC_ROLLBACK, 0, 146, 56, 14
    PUSHBUTTON "&Supprimer", IDC_REMOVE, 60, 146, 64, 14
    LTEXT "", IDC_HISTORY_NOTE, 130, 149, 160, 9, SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_DETAILS DIALOGEX 0, 0, 300, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Détails du périphérique"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT IDC_DETAILS_TEXT, 7, 7, 286, 166, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON "OK", IDOK, 243, 179, 50, 14
END

STRINGTABLE
BEGIN
    IDS_CAPTION "Installateur de pilotes LiberNT"
    IDS_BACK "&Précédent"
    IDS_NEXT "&Suivant"
    IDS_CANCEL "Annuler"
    IDS_INSTALL "&Installer"
    IDS_FINISH "&Terminer"
    IDS_DEVICES_TITLE "Pilotes de ce PC"
    IDS_DEVICES_SUBTITLE "Périphériques sans pilote ou avec un pilote tiers pour lesquels le catalogue Microsoft Update a un pilote plus récent. Cochez ceux à installer."
    IDS_INSTALL_TITLE "Installation des pilotes"
    IDS_INSTALL_SUBTITLE "Patientez pendant l'installation des pilotes."
    IDS_DONE_TITLE "Terminé"
    IDS_DONE_SUBTITLE "Le résultat pour chaque périphérique."
    IDS_HISTORY_TITLE "Pilotes installés depuis le catalogue"
    IDS_HISTORY_SUBTITLE "Toutes les modifications faites par l'Installateur de pilotes LiberNT sur ce PC, des plus récentes aux plus anciennes."
    IDS_COL_DEVICE "Périphérique"
    IDS_COL_VERSION "Version"
    IDS_COL_DRIVER "Pilote"
    IDS_COL_RESULT "Résultat"
    IDS_COL_DATE "Date"
    IDS_COL_ACTION "Action"
    IDS_DEVICES_NOTE "%1 périphériques, %2 sans pilote, %3 cochés. Pilotes cherchés pour %4."
    IDS_INSTALL_START "Installation de %1 pilote(s)"
    IDS_INSTALL_STEP "Pilote %1 sur %2 : %3"
    IDS_INSTALL_CANCELLING "Arrêt après l'étape en cours..."
