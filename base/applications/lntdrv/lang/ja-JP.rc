    IDS_PROGRESS_INSTALL "%1 のドライバーをインストールしています"
    IDS_RESULT_INSTALLED "インストール済み"
    IDS_RESULT_REBOOT "インストール済み (再起動が必要)"
    IDS_RESULT_SKIPPED "既にドライバーがあります"
    IDS_RESULT_FILE "%1 (%2)"
