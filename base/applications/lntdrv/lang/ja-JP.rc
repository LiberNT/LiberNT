    IDS_CLI_USAGE "使用法: lntdrv [/list | /scan | /installall | /search <instance id> | /install <instance id> [update id]]"
    IDS_NOTE_OTHER_ARCH "カタログに %1 用のドライバーはありません。%2 用のドライバーのみがあります"
    IDS_NOTE_OTHER_WINDOWS "カタログには他の Windows バージョン用のドライバーのみがあります"
