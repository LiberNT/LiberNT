LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_FRAME DIALOGEX 0, 0, 420, 240
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "LiberNT ドライバー インストーラー"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_FRAME_TITLE, 120, 10, 290, 14, SS_NOPREFIX
    LTEXT "", IDC_FRAME_SUBTITLE, 120, 26, 290, 18, SS_NOPREFIX
    LTEXT "", IDC_FRAME_PAGE, 120, 48, 290, 160, NOT WS_VISIBLE
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 120, 212, 300, 1
    PUSHBUTTON "戻る(&B)", IDC_FRAME_BACK, 250, 219, 50, 14
    DEFPUSHBUTTON "次へ(&N)", IDC_FRAME_NEXT, 305, 219, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 360, 219, 50, 14
END

IDD_DEVICES DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_DEVICES_STATUS, 0, 0, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL "", IDC_DEVICES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 12, 290, 116
    LTEXT "", IDC_DEVICES_NOTE, 0, 132, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON "詳細(&D)", IDC_DETAILS, 0, 146, 56, 14
    PUSHBUTTON "すべて選択(&A)", IDC_SELECT_ALL, 60, 146, 56, 14
    PUSHBUTTON "すべてクリア(&C)", IDC_SELECT_NONE, 120, 146, 56, 14
    PUSHBUTTON "履歴(&H)", IDC_HISTORY, 234, 146, 56, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_PROGRESS_TEXT, 0, 44, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT "", IDC_PROGRESS_DETAIL, 0, 58, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_DONE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_RESULTS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 136
    LTEXT "", IDC_DONE_NOTE, 0, 140, 290, 18, SS_NOPREFIX
END

IDD_HISTORY DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_HISTORY_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 140
    PUSHBUTTON "ロールバック(&R)", IDC_ROLLBACK, 0, 146, 56, 14
    PUSHBUTTON "ドライバーの削除(&V)", IDC_REMOVE, 60, 146, 64, 14
    LTEXT "", IDC_HISTORY_NOTE, 130, 149, 160, 9, SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_DETAILS DIALOGEX 0, 0, 300, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "デバイスの詳細"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT IDC_DETAILS_TEXT, 7, 7, 286, 166, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON "OK", IDOK, 243, 179, 50, 14
END

STRINGTABLE
BEGIN
    IDS_CAPTION "LiberNT ドライバー インストーラー"
    IDS_BACK "戻る(&B)"
    IDS_NEXT "次へ(&N)"
    IDS_CANCEL "キャンセル"
    IDS_INSTALL "インストール(&I)"
    IDS_FINISH "完了(&F)"
    IDS_DEVICES_TITLE "この PC のドライバー"
    IDS_DEVICES_SUBTITLE "ドライバーがないか、サードパーティ製ドライバーを使用していて、Microsoft Update カタログに新しいドライバーがあるデバイスです。インストールするデバイスにチェックを付けてください。"
    IDS_ABOUT_MENU "LiberNT ドライバー インストーラーのバージョン情報(&A)..."
    IDS_ABOUT_TEXT "LiberNT ドライバー インストーラー\nCopyright (C) 2026 Ahmed ARIF\nGNU 一般公衆利用許諾書バージョン 3 以降の条件で配布されています。\n\nドライバーは、Microsoft Corporation のサービスである Microsoft Update カタログからダウンロードされます。\nMicrosoft Update カタログ: Copyright (c) Microsoft Corporation. All rights reserved.\n各ドライバー パッケージは発行元に帰属し、発行元のライセンス条項が適用されます。"
    IDS_INSTALL_TITLE "ドライバーをインストールしています"
    IDS_INSTALL_SUBTITLE "ドライバーのインストールが完了するまでお待ちください。"
    IDS_DONE_TITLE "完了しました"
    IDS_DONE_SUBTITLE "各デバイスの結果です。"
    IDS_HISTORY_TITLE "カタログからインストールされたドライバー"
    IDS_HISTORY_SUBTITLE "LiberNT ドライバー インストーラーがこの PC に加えたすべての変更 (新しい順)。"
    IDS_COL_DEVICE "デバイス"
    IDS_COL_VERSION "バージョン"
    IDS_COL_DRIVER "ドライバー"
    IDS_COL_RESULT "結果"
    IDS_COL_DATE "日付"
    IDS_COL_ACTION "操作"
    IDS_DEVICES_NOTE "デバイス %1 個、ドライバーなし %2 個、チェック済み %3 個。%4 用のドライバーを検索します。"
    IDS_INSTALL_START "%1 個のドライバーをインストールしています"
    IDS_INSTALL_STEP "ドライバー %1/%2: %3"
    IDS_INSTALL_CANCELLING "現在の手順の完了後に停止します..."
    IDS_PROGRESS_QUERY "Microsoft Update カタログにパッケージを問い合わせています"
    IDS_PROGRESS_DOWNLOAD "%1 をダウンロードしています (%2 KB)"
