    IDS_TB_RESIZE "&Resize"
    IDS_TB_ERASE "&Erase"
    IDS_TB_MOUNT "&Mount"
    IDS_TB_UNMOUNT "Un&mount"
    IDS_TB_INFO "&Info"
    IDS_TB_REFRESH "Re&fresh"
    IDS_NEW_VOLUME "New Volume"
    IDS_NEW_TITLE "Add a volume to %s"
    IDS_RESIZE_TITLE "Resize %s"
    IDS_SIZE_RANGE "Between %s and %s"
