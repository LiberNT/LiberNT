    IDS_ERASE_TITLE "Erase %s"
    IDS_ERASE_MAIN "Erase %s?"
    IDS_ERASE_CONTENT "All data stored on this volume is lost."
    IDS_ERASE_DISK_CONTENT "Every partition on this disk is removed and all data stored on it is lost."
    IDS_WORK_CREATE "Creating the volume"
    IDS_WORK_ERASE "Erasing"
    IDS_WORK_CHECK "Checking the volume"
    IDS_WORK_SHRINK "Shrinking the volume"
    IDS_WORK_EXTEND "Extending the volume"
    IDS_STATUS_PARTITION "Writing the partition table..."
    IDS_STATUS_WAITING "Waiting for the volume to appear..."
    IDS_STATUS_FORMATTING "Formatting..."
    IDS_STATUS_ERASING "Erasing the disk..."
    IDS_STATUS_SHRINKING "Moving data and shrinking..."
    IDS_STATUS_EXTENDING "Extending..."
    IDS_STATUS_DONE "Done."
    IDS_STATUS_FAILED "The operation failed."
    IDS_ERR_PARTITION "The partition table could not be updated."
    IDS_ERR_NOVOLUME "The new volume did not appear."
    IDS_ERR_FORMAT "The volume could not be formatted."
    IDS_ERR_LETTER "The drive letter could not be changed."
    IDS_ERR_CHECK "The check found problems on the volume."
    IDS_ERR_RESIZE "The volume could not be resized."
    IDS_ERR_NOROOM "This volume cannot be resized: there is no space to free and no free space after it."
    IDS_ERR_INUSE "The volume is in use. Close the programs using it and try again."
    IDS_ERR_BUSY "The cancelled check is still stopping. Try again in a moment."
    IDS_CLOSE "Close"
END
