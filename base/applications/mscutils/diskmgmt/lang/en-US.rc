LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDM_DISKMGMT MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&Action"
    BEGIN
        MENUITEM "Res&can Disks", IDM_ACTION_RESCAN
        MENUITEM "&Refresh\tF5", IDM_ACTION_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Initialize Disk...", IDM_ACTION_INITIALIZE_DISK
        MENUITEM "Convert to &GPT Disk", IDM_ACTION_CONVERT_GPT
        MENUITEM "Convert to &MBR Disk", IDM_ACTION_CONVERT_MBR
        MENUITEM "Cre&ate Partition...", IDM_ACTION_CREATE_PARTITION
        MENUITEM "De&lete Volume", IDM_ACTION_DELETE_VOLUME
        MENUITEM "E&xtend Volume...", IDM_ACTION_EXTEND_VOLUME
        MENUITEM "Sh&rink Volume...", IDM_ACTION_SHRINK_VOLUME
        MENUITEM "&Format...", IDM_ACTION_FORMAT
        MENUITEM "Assi&gn Drive Letter", IDM_ACTION_ASSIGN_LETTER
        MENUITEM "&Remove Drive Letter", IDM_ACTION_REMOVE_LETTER
        MENUITEM "Change Mount &Path...", IDM_ACTION_CHANGE_MOUNT_PATH
        MENUITEM "Remove Mount Pat&h", IDM_ACTION_REMOVE_MOUNT_PATH
        MENUITEM SEPARATOR
        MENUITEM "&Online", IDM_ACTION_ONLINE
        MENUITEM "O&ffline", IDM_ACTION_OFFLINE
        MENUITEM "Set &Read-only", IDM_ACTION_SET_READ_ONLY
        MENUITEM "C&lear Read-only", IDM_ACTION_CLEAR_READ_ONLY
        MENUITEM "Mark Partition &Active", IDM_ACTION_MARK_ACTIVE
        MENUITEM "Mark Partition &Inactive", IDM_ACTION_MARK_INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "&Properties", IDM_ACTION_PROPERTIES
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Top", IDM_VIEW_TOP
        MENUITEM "&Bottom", IDM_VIEW_BOTTOM
        MENUITEM "&Disk List", IDM_VIEW_DISK_LIST
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Disk Management", IDM_HELP_ABOUT
    END
END

IDA_DISKMGMT ACCELERATORS
BEGIN
    VK_F5, IDM_ACTION_REFRESH, VIRTKEY
    VK_DELETE, IDM_ACTION_DELETE_VOLUME, VIRTKEY
    VK_RETURN, IDM_ACTION_PROPERTIES, VIRTKEY, ALT
    "F", IDM_ACTION_FORMAT, VIRTKEY, ALT
END

IDD_ASSIGN_LETTER DIALOGEX 0, 0, 190, 68
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Assign Drive Letter"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Select the drive letter to assign to the selected volume:", -1, 8, 10, 174, 18
    COMBOBOX IDC_ASSIGN_LETTER_COMBO, 8, 31, 58, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 78, 47, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 132, 47, 50, 14
END

IDD_CREATE_PARTITION DIALOGEX 0, 0, 224, 184
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create Volume"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Enter the size and initial settings for the selected unallocated region:", IDC_CREATE_PARTITION_PROMPT, 8, 10, 206, 18
    LTEXT "Maximum size:", -1, 8, 33, 56, 8
    LTEXT "", IDC_CREATE_PARTITION_MAX, 68, 33, 66, 8
    LTEXT "Partition size (MB):", IDC_CREATE_PARTITION_SIZE_LABEL, 8, 49, 74, 8
    EDITTEXT IDC_CREATE_PARTITION_SIZE, 86, 47, 52, 12, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT "Partition type:", -1, 8, 65, 74, 8
    COMBOBOX IDC_CREATE_PARTITION_TYPE, 86, 62, 104, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Assign the following drive letter:", IDC_CREATE_PARTITION_ASSIGN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 85, 128, 10
    COMBOBOX IDC_CREATE_PARTITION_LETTER, 146, 82, 44, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Format this volume with these settings:", IDC_CREATE_PARTITION_FORMAT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 105, 148, 10
    LTEXT "File system:", -1, 20, 122, 52, 8
    COMBOBOX IDC_CREATE_PARTITION_FS, 86, 119, 88, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Volume label:", -1, 20, 140, 52, 8
    EDITTEXT IDC_CREATE_PARTITION_LABEL, 86, 137, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Perform a quick format", IDC_CREATE_PARTITION_QUICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 158, 102, 10
    DEFPUSHBUTTON "OK", IDOK, 116, 164, 42, 14
    PUSHBUTTON "Cancel", IDCANCEL, 164, 164, 42, 14
END

IDD_FORMAT_VOLUME DIALOGEX 0, 0, 214, 112
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Format"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "File system:", -1, 8, 11, 52, 8
    COMBOBOX IDC_FORMAT_FILESYSTEM, 72, 8, 98, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Volume label:", -1, 8, 31, 52, 8
    EDITTEXT IDC_FORMAT_LABEL, 72, 28, 126, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Perform a quick format", IDC_FORMAT_QUICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 53, 104, 10
    DEFPUSHBUTTON "OK", IDOK, 110, 90, 42, 14
    PUSHBUTTON "Cancel", IDCANCEL, 156, 90, 42, 14
END

IDD_SELECT_MOUNT_PATH DIALOGEX 0, 0, 236, 116
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Mount Path"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Select the existing folder mount path to replace or remove:", IDC_SELECT_MOUNT_PATH_PROMPT, 8, 10, 220, 16
    LISTBOX IDC_SELECT_MOUNT_PATH_LIST, 8, 28, 220, 54, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    CONTROL "Replace the selected existing mount path after assigning the new one", IDC_SELECT_MOUNT_PATH_REPLACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 88, 190, 10
    DEFPUSHBUTTON "OK", IDOK, 140, 98, 40, 14
    PUSHBUTTON "Cancel", IDCANCEL, 186, 98, 40, 14
END

IDD_SHRINK_VOLUME DIALOGEX 0, 0, 300, 170
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shrink"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Total size before shrink in MB:", -1, 7, 13, 190, 8
    EDITTEXT IDC_SHRINK_TOTAL, 203, 10, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "Size of available shrink space in MB:", -1, 7, 32, 190, 8
    EDITTEXT IDC_SHRINK_AVAILABLE, 203, 29, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "&Enter the amount of space to shrink in MB:", -1, 7, 51, 190, 8
    EDITTEXT IDC_SHRINK_AMOUNT, 203, 48, 80, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_SHRINK_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 283, 48, 10, 13
    LTEXT "Total size after shrink in MB:", -1, 7, 70, 190, 8
    EDITTEXT IDC_SHRINK_AFTER, 203, 67, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    ICON "", IDC_SHRINK_ICON, 8, 85, 10, 10, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "You cannot shrink a volume beyond the point where any unmovable files are located. See the ""defrag"" event in the Application log for detailed information about the operation when it has completed.", -1, 25, 86, 268, 26
    LTEXT "See ""Shrink a basic volume"" in Disk Management help for more information", -1, 25, 126, 268, 8
    DEFPUSHBUTTON "&Shrink", IDOK, 180, 149, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 239, 149, 54, 14
END

IDD_SHRINK_QUERY DIALOGEX 0, 0, 220, 40
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Shrink"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Querying volume for available shrink space, please wait...", -1, 10, 15, 200, 10
END

IDD_EXTEND_WELCOME DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Extend Volume Wizard"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Welcome to the Extend Volume Wizard", IDC_EXTEND_TITLE, 115, 8, 195, 24
    LTEXT "This wizard helps you increase the size of simple and spanned volumes. You can extend a volume  by adding space from one or more additional disks.", -1, 115, 40, 195, 30
    LTEXT "To continue, click Next.", -1, 115, 80, 195, 8
END

IDD_EXTEND_SELECT DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Extend Volume Wizard"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Av&ailable:", -1, 21, 7, 100, 8
    LISTBOX IDC_EXTEND_AVAILABLE, 21, 17, 96, 62, LBS_NOINTEGRALHEIGHT | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Add >", IDC_EXTEND_ADD, 127, 21, 62, 14
    PUSHBUTTON "< &Remove", IDC_EXTEND_REMOVE, 127, 41, 62, 14
    PUSHBUTTON "< Remove A&ll", IDC_EXTEND_REMOVE_ALL, 127, 61, 62, 14
    LTEXT "&Selected:", -1, 200, 7, 100, 8
    LISTBOX IDC_EXTEND_SELECTED, 200, 17, 96, 62, LBS_NOINTEGRALHEIGHT | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Total volume size in megabytes (MB):", -1, 21, 87, 170, 8
    EDITTEXT IDC_EXTEND_TOTAL, 200, 85, 96, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "Maximum available space in MB:", -1, 21, 103, 170, 8
    EDITTEXT IDC_EXTEND_MAX, 200, 101, 96, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "S&elect the amount of space in MB:", -1, 21, 119, 170, 8
    EDITTEXT IDC_EXTEND_AMOUNT, 200, 117, 86, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_EXTEND_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 286, 117, 10, 12
END

IDD_EXTEND_FINISH DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Extend Volume Wizard"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Completing the Extend Volume Wizard", IDC_EXTEND_TITLE, 115, 8, 195, 24
    LTEXT "You selected the following settings:", -1, 115, 48, 195, 8
    LISTBOX IDC_EXTEND_SETTINGS, 115, 58, 187, 62, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL
    LTEXT "To close this wizard, click Finish.", -1, 115, 130, 195, 8
END

