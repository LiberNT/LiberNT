LANGUAGE LANG_GERMAN, SUBLANG_NEUTRAL

IDM_DISKMGMT MENU
BEGIN
    POPUP "&Datei"
    BEGIN
        MENUITEM "&Beenden", IDM_FILE_EXIT
    END
    POPUP "&Aktion"
    BEGIN
        MENUITEM "Datentraeger er&neut suchen", IDM_ACTION_RESCAN
        MENUITEM "&Aktualisieren\tF5", IDM_ACTION_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Datentraeger &initialisieren...", IDM_ACTION_INITIALIZE_DISK
        MENUITEM "In &GPT-Datentraeger konvertieren", IDM_ACTION_CONVERT_GPT
        MENUITEM "In &MBR-Datentraeger konvertieren", IDM_ACTION_CONVERT_MBR
        MENUITEM "&Partition erstellen...", IDM_ACTION_CREATE_PARTITION
        MENUITEM "&Volume loeschen", IDM_ACTION_DELETE_VOLUME
        MENUITEM "Volume e&rweitern...", IDM_ACTION_EXTEND_VOLUME
        MENUITEM "Volume ver&kleinern...", IDM_ACTION_SHRINK_VOLUME
        MENUITEM "&Formatieren...", IDM_ACTION_FORMAT
        MENUITEM "Laufwerksbuchstaben &zuweisen", IDM_ACTION_ASSIGN_LETTER
        MENUITEM "Laufwerksbuchstaben &entfernen", IDM_ACTION_REMOVE_LETTER
        MENUITEM "Bereitstellungs&pfad aendern...", IDM_ACTION_CHANGE_MOUNT_PATH
        MENUITEM "Bereitstellungspf&ad entfernen", IDM_ACTION_REMOVE_MOUNT_PATH
        MENUITEM SEPARATOR
        MENUITEM "&Online", IDM_ACTION_ONLINE
        MENUITEM "&Offline", IDM_ACTION_OFFLINE
        MENUITEM "Schreibschutz &setzen", IDM_ACTION_SET_READ_ONLY
        MENUITEM "Schreibschutz &loeschen", IDM_ACTION_CLEAR_READ_ONLY
        MENUITEM "Partition als &aktiv markieren", IDM_ACTION_MARK_ACTIVE
        MENUITEM "Partition als &inaktiv markieren", IDM_ACTION_MARK_INACTIVE
        MENUITEM SEPARATOR
        MENUITEM "&Eigenschaften", IDM_ACTION_PROPERTIES
    END
    POPUP "&Ansicht"
    BEGIN
        MENUITEM "&Oben", IDM_VIEW_TOP
        MENUITEM "&Unten", IDM_VIEW_BOTTOM
        MENUITEM "&Datentraegerliste", IDM_VIEW_DISK_LIST
    END
    POPUP "&Hilfe"
    BEGIN
        MENUITEM "Ueber die &Datentraegerverwaltung", IDM_HELP_ABOUT
    END
END

IDA_DISKMGMT ACCELERATORS
BEGIN
    VK_F5, IDM_ACTION_REFRESH, VIRTKEY
    VK_DELETE, IDM_ACTION_DELETE_VOLUME, VIRTKEY
    VK_RETURN, IDM_ACTION_PROPERTIES, VIRTKEY, ALT
    "F", IDM_ACTION_FORMAT, VIRTKEY, ALT
END

IDD_ASSIGN_LETTER DIALOGEX 0, 0, 190, 68
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Laufwerksbuchstaben zuweisen"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Waehlen Sie den Laufwerksbuchstaben aus, der dem ausgewaehlten Volume zugewiesen werden soll:", -1, 8, 10, 174, 18
    COMBOBOX IDC_ASSIGN_LETTER_COMBO, 8, 31, 58, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 78, 47, 50, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 132, 47, 50, 14
END

IDD_CREATE_PARTITION DIALOGEX 0, 0, 224, 184
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Volume erstellen"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Geben Sie Groesse und Anfangseinstellungen fuer den ausgewaehlten nicht zugeordneten Bereich ein:", IDC_CREATE_PARTITION_PROMPT, 8, 10, 206, 18
    LTEXT "Maximale Groesse:", -1, 8, 33, 70, 8
    LTEXT "", IDC_CREATE_PARTITION_MAX, 82, 33, 66, 8
    LTEXT "Partitionsgroesse (MB):", IDC_CREATE_PARTITION_SIZE_LABEL, 8, 49, 74, 8
    EDITTEXT IDC_CREATE_PARTITION_SIZE, 86, 47, 52, 12, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT "Partitionstyp:", -1, 8, 65, 74, 8
    COMBOBOX IDC_CREATE_PARTITION_TYPE, 86, 62, 104, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Diesen Laufwerksbuchstaben zuweisen:", IDC_CREATE_PARTITION_ASSIGN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 85, 132, 10
    COMBOBOX IDC_CREATE_PARTITION_LETTER, 146, 82, 44, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Dieses Volume mit diesen Einstellungen formatieren:", IDC_CREATE_PARTITION_FORMAT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 105, 176, 10
    LTEXT "Dateisystem:", -1, 20, 122, 52, 8
    COMBOBOX IDC_CREATE_PARTITION_FS, 86, 119, 88, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Volumebezeichnung:", -1, 20, 140, 60, 8
    EDITTEXT IDC_CREATE_PARTITION_LABEL, 86, 137, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Schnellformatierung durchfuehren", IDC_CREATE_PARTITION_QUICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 158, 130, 10
    DEFPUSHBUTTON "OK", IDOK, 116, 164, 42, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 164, 164, 42, 14
END

IDD_FORMAT_VOLUME DIALOGEX 0, 0, 214, 112
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Formatieren"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Dateisystem:", -1, 8, 11, 52, 8
    COMBOBOX IDC_FORMAT_FILESYSTEM, 72, 8, 98, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Volumebezeichnung:", -1, 8, 31, 60, 8
    EDITTEXT IDC_FORMAT_LABEL, 72, 28, 126, 14, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Schnellformatierung durchfuehren", IDC_FORMAT_QUICK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 53, 130, 10
    DEFPUSHBUTTON "OK", IDOK, 110, 90, 42, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 156, 90, 42, 14
END

IDD_SELECT_MOUNT_PATH DIALOGEX 0, 0, 236, 116
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Bereitstellungspfad auswaehlen"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Waehlen Sie den vorhandenen Ordner-Bereitstellungspfad aus, der ersetzt oder entfernt werden soll:", IDC_SELECT_MOUNT_PATH_PROMPT, 8, 10, 220, 16
    LISTBOX IDC_SELECT_MOUNT_PATH_LIST, 8, 28, 220, 54, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    CONTROL "Den ausgewaehlten vorhandenen Bereitstellungspfad nach dem Zuweisen des neuen Pfads ersetzen", IDC_SELECT_MOUNT_PATH_REPLACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 88, 210, 10
    DEFPUSHBUTTON "OK", IDOK, 140, 98, 40, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 186, 98, 40, 14
END

IDD_SHRINK_VOLUME DIALOGEX 0, 0, 300, 170
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Verkleinern"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Gesamtgröße vor der Verkleinerung in MB:", -1, 7, 13, 190, 8
    EDITTEXT IDC_SHRINK_TOTAL, 203, 10, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "Für die Verkleinerung verfügbarer Speicherplatz in MB:", -1, 7, 32, 190, 8
    EDITTEXT IDC_SHRINK_AVAILABLE, 203, 29, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "&Zu verkleinernder Speicherplatz in MB:", -1, 7, 51, 190, 8
    EDITTEXT IDC_SHRINK_AMOUNT, 203, 48, 80, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_SHRINK_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 283, 48, 10, 13
    LTEXT "Gesamtgröße nach der Verkleinerung in MB:", -1, 7, 70, 190, 8
    EDITTEXT IDC_SHRINK_AFTER, 203, 67, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    ICON "", IDC_SHRINK_ICON, 8, 85, 10, 10, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "Ein Volume kann nicht über den Punkt hinaus verkleinert werden, an dem sich nicht verschiebbare Dateien befinden. Ausführliche Informationen zum Vorgang finden Sie nach Abschluss im Ereignis ""defrag"" im Anwendungsprotokoll.", -1, 25, 86, 268, 26
    LTEXT "Weitere Informationen finden Sie unter ""Verkleinern eines Basisvolumes"" in der Hilfe zur Datenträgerverwaltung.", -1, 25, 126, 268, 8
    DEFPUSHBUTTON "&Verkleinern", IDOK, 180, 149, 54, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 239, 149, 54, 14
END

IDD_SHRINK_QUERY DIALOGEX 0, 0, 220, 40
STYLE DS_MODALFRAME | DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Verkleinern"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Volume wird nach verfügbarem Speicherplatz für die Verkleinerung abgefragt, bitte warten...", -1, 10, 15, 200, 10
END

IDD_EXTEND_WELCOME DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Assistent zum Erweitern von Volumes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Willkommen beim Assistenten zum Erweitern von Volumes", IDC_EXTEND_TITLE, 115, 8, 195, 24
    LTEXT "Mit diesem Assistenten können Sie die Größe von einfachen und übergreifenden Volumes erhöhen. Sie können ein Volume erweitern, indem Sie Speicherplatz von einem oder mehreren zusätzlichen Datenträgern hinzufügen.", -1, 115, 40, 195, 30
    LTEXT "Klicken Sie auf Weiter, um fortzufahren.", -1, 115, 80, 195, 8
END

IDD_EXTEND_SELECT DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Assistent zum Erweitern von Volumes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Verfügbar:", -1, 21, 7, 100, 8
    LISTBOX IDC_EXTEND_AVAILABLE, 21, 17, 96, 62, LBS_NOINTEGRALHEIGHT | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Hinzufügen >", IDC_EXTEND_ADD, 127, 21, 62, 14
    PUSHBUTTON "< &Entfernen", IDC_EXTEND_REMOVE, 127, 41, 62, 14
    PUSHBUTTON "< &Alle entfernen", IDC_EXTEND_REMOVE_ALL, 127, 61, 62, 14
    LTEXT "&Ausgewählt:", -1, 200, 7, 100, 8
    LISTBOX IDC_EXTEND_SELECTED, 200, 17, 96, 62, LBS_NOINTEGRALHEIGHT | LBS_USETABSTOPS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Gesamtgröße des Volumes in MB:", -1, 21, 87, 170, 8
    EDITTEXT IDC_EXTEND_TOTAL, 200, 85, 96, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "Maximal verfügbarer Speicherplatz in MB:", -1, 21, 103, 170, 8
    EDITTEXT IDC_EXTEND_MAX, 200, 101, 96, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "&Speicherplatz in MB:", -1, 21, 119, 170, 8
    EDITTEXT IDC_EXTEND_AMOUNT, 200, 117, 86, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_EXTEND_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 286, 117, 10, 12
END

IDD_EXTEND_FINISH DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Assistent zum Erweitern von Volumes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Fertigstellen des Assistenten", IDC_EXTEND_TITLE, 115, 8, 195, 24
    LTEXT "Sie haben die folgenden Einstellungen ausgewählt:", -1, 115, 48, 195, 8
    LISTBOX IDC_EXTEND_SETTINGS, 115, 58, 187, 62, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL
    LTEXT "Klicken Sie auf Fertig stellen, um den Assistenten zu schließen.", -1, 115, 130, 195, 8
END

