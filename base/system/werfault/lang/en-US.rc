LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_RECOVERY DIALOGEX 0, 0, 260, 64
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_VISIBLE
EXSTYLE WS_EX_TOPMOST
CAPTION "Windows Error Reporting"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_RECOVERY_TEXT, 8, 8, 244, 28
    PUSHBUTTON "Cancel", IDCANCEL, 202, 42, 50, 14
END

STRINGTABLE
BEGIN
    IDS_RECOVERING "Recovering your information from %s..."
    IDS_CANCELLING "Cancelling the recovery of %s..."
END
