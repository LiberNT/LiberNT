LANGUAGE LANG_ARABIC, SUBLANG_NEUTRAL

STRINGTABLE
{
    WCMD_CALL, "يُستخدم CALL <batchfilename> داخل ملف دفعي لتنفيذ أوامر من ملف دفعي\n\
آخر. عند انتهاء الملف الدفعي يعود التحكم إلى الملف الذي استدعاه.\n\
ويمكن للأمر CALL تمرير معاملات إلى الإجراء المستدعى.\n\
\n\
التغييرات التي يجريها الإجراء المستدعى على الدليل الافتراضي ومتغيرات\n\
البيئة وغيرها يرثها المستدعي.\n"
    WCMD_CD, "CD <directory> هو الصيغة المختصرة لـ CHDIR. يغيّر الدليل الافتراضي\n\
الحالي.\n"
    WCMD_CHDIR, "CHDIR <directory> يغيّر الدليل الافتراضي الحالي.\n"
    WCMD_CLS, "CLS يمسح شاشة وحدة التحكم.\n"
    WCMD_COPY, "COPY <filename> يقوم بنسخ الملفات.\n"
    WCMD_DATE, "DATE يقوم بإظهار أو تعديل التاريخ.\n"
    WCMD_DEL, "DEL <filename> يقوم بحذف ملف أو مجموعة ملفات.\n"
    WCMD_DIR, "DIR يسرد محتويات دليل.\n"
    WCMD_ECHO, "ECHO <string> يعرض <string> على جهاز الطرفية الحالي.\n\
\n\
يجعل ECHO ON جميع الأوامر التالية في الملف الدفعي تُعرض على جهاز\n\
الطرفية قبل تنفيذها.\n\
\n\
يلغي ECHO OFF أثر أمر ECHO ON سابق (الوضع الافتراضي هو ECHO OFF).\n\
ويمكن منع عرض الأمر ECHO OFF نفسه بوضع العلامة @ قبله.\n"
    WCMD_ERASE, "ERASE <filename> يقوم بحذف ملف أو مجموعة ملفات.\n"
    WCMD_FOR, "يُستخدم الأمر FOR لتنفيذ أمر على كل ملف من مجموعة ملفات.\n\
\n\
الاستخدام: FOR %variable IN (set) DO command\n\
\n\
يجب مضاعفة العلامة % عند استخدام FOR داخل ملف دفعي.\n"
    WCMD_GOTO, "ينقل الأمر GOTO التنفيذ إلى عبارة أخرى داخل الملف الدفعي.\n\
\n\
يمكن أن يصل طول التسمية التي يستهدفها GOTO إلى 255 حرفًا، لكن لا يجوز\n\
أن تحتوي على مسافات (وهذا يختلف عن أنظمة التشغيل الأخرى). إذا وُجدت\n\
تسميتان متطابقتان أو أكثر في الملف الدفعي فستُنفَّذ الأولى دائمًا.\n\
ومحاولة الانتقال بـ GOTO إلى تسمية غير موجودة تنهي تنفيذ الملف الدفعي.\n\
\n\
ليس للأمر GOTO أي أثر عند استخدامه بشكل تفاعلي.\n"
    WCMD_HELP, "HELP <command> يعرض تفاصيل تعليمات موجزة عن موضوع.\n\
يعرض HELP دون وسيطة جميع الأوامر المضمّنة في CMD.\n"
    WCMD_IF, "يُستخدم IF لتنفيذ أمر بشكل شرطي.\n\
\n\
الصيغة: IF [NOT] EXIST filename command\n\
        IF [NOT] string1==string2 command\n\
        IF [NOT] ERRORLEVEL number command\n\
\n\
في الصيغة الثانية من الأمر يجب أن تكون string1 وstring2 بين علامتي\n\
اقتباس مزدوجتين. المقارنة غير حساسة لحالة الأحرف.\n"
    WCMD_LABEL, "يُستخدم LABEL لتعيين تسمية وحدة تخزين القرص.\n\
\n\
الصيغة: LABEL [drive:]\n\
سيطلب منك الأمر إدخال تسمية وحدة التخزين الجديدة للمحرك المحدد.\n\
يمكنك عرض تسمية وحدة تخزين القرص بالأمر VOL.\n"
    WCMD_MD, "MD <name> هو الصيغة المختصرة لـ MKDIR. ينشئ دليلًا فرعيًا.\n"
    WCMD_MKDIR, "MKDIR <name> ينشئ دليلًا فرعيًا.\n"
    WCMD_MOVE, "ينقل MOVE ملفًا أو دليلًا إلى موضع جديد داخل نظام الملفات.\n\
\n\
إذا كان العنصر المنقول دليلًا فستُنقل معه أيضًا جميع الملفات والأدلة\n\
الفرعية الموجودة تحته.\n\
\n\
يفشل MOVE إذا كان الموضعان القديم والجديد على حرفي محرك أقراص DOS\n\
مختلفين.\n"
    WCMD_PATH, "يعرض PATH مسار بحث cmd أو يغيّره.\n\
\n\
إدخال PATH وحده يعرض إعداد PATH الحالي (المأخوذ في البداية من السجل).\n\
لتغيير الإعداد اكتب القيمة الجديدة بعد الأمر PATH.\n\
\n\
يمكن أيضًا تعديل PATH باستخدام متغير البيئة PATH، على سبيل المثال:\n\
PATH %PATH%;c:\\temp\n"
    WCMD_PAUSE, "يعرض PAUSE رسالة على الشاشة تطلب من المستخدم الضغط على مفتاح.\n\
\n\
يفيد أساسًا في الملفات الدفعية للسماح للمستخدم بقراءة مخرجات الأمر\n\
السابق قبل أن تخرج من الشاشة.\n"
    WCMD_PROMPT, "يضبط PROMPT موجّه سطر الأوامر.\n\
\n\
يظهر النص الذي يلي الأمر PROMPT (والمسافة التي تليه مباشرة) في بداية\n\
السطر عندما ينتظر cmd الإدخال.\n\
\n\
لسلاسل الأحرف التالية المعاني الخاصة المبيّنة:\n\
\n\
$$    علامة الدولار $_    سطر جديد      $b    علامة الأنبوب (|)\n\
$d    التاريخ الحالي$e    حرف الهروب    $g    العلامة >\n\
$l    العلامة <     $n    المحرك الحالي $p    المسار الحالي\n\
$q    علامة المساواة$t    الوقت الحالي  $v    إصدار cmd\n\
\n\
لاحظ أن إدخال الأمر PROMPT دون نص للموجّه يعيد الموجّه إلى الوضع\n\
الافتراضي، وهو الدليل الحالي (بما في ذلك حرف المحرك الحالي) متبوعًا\n\
بعلامة أكبر من (>).\n\
(مثل الأمر PROMPT $p$g).\n\
\n\
يمكن أيضًا تغيير الموجّه بتعديل متغير البيئة PROMPT، لذا فإن للأمر\n\
'SET PROMPT=text' الأثر نفسه الذي للأمر 'PROMPT text'.\n"
    WCMD_REM, "سطر الأوامر الذي يبدأ بـ REM (متبوعة بمسافة) لا ينفّذ أي إجراء، ولذلك\n\
يمكن استخدامه كتعليق في ملف دفعي.\n"
    WCMD_REN, "REN <filename> هو الصيغة المختصرة لـ RENAME. يعيد تسمية ملف.\n"
    WCMD_RENAME, "RENAME <filename> يعيد تسمية ملف.\n"
    WCMD_RD, "RD <directory> هو الصيغة المختصرة لـ RMDIR. يحذف دليلًا.\n"
    WCMD_RMDIR, "RMDIR <directory> يحذف دليلًا.\n"
    WCMD_START, "يشغّل برنامجًا، أو يفتح مستندًا بالبرنامج المستخدم عادةً للملفات ذات\n\
هذه اللاحقة.\n\
الاستخدام:\n\
start [options] program_filename [...]\n\
start [options] document_filename\n\
\n\
الخيارات:\n\
""title""        يحدد عنوان النوافذ الفرعية.\n\
/d directory   يشغّل البرنامج في الدليل المحدد.\n\
/b             لا ينشئ وحدة تحكم جديدة للبرنامج.\n\
/i             يشغّل البرنامج بمتغيرات بيئة جديدة.\n\
/min           يشغّل البرنامج مصغّرًا.\n\
/max           يشغّل البرنامج مكبّرًا.\n\
/low           يشغّل البرنامج بفئة الأولوية الخاملة.\n\
/normal        يشغّل البرنامج بفئة الأولوية العادية.\n\
/high          يشغّل البرنامج بفئة الأولوية العالية.\n\
/realtime      يشغّل البرنامج بفئة أولوية الوقت الحقيقي.\n\
/abovenormal   يشغّل البرنامج بفئة الأولوية الأعلى من العادية.\n\
/belownormal   يشغّل البرنامج بفئة الأولوية الأدنى من العادية.\n\
/node n        يشغّل البرنامج على عقدة NUMA المحددة.\n\
/affinity mask يشغّل البرنامج بقناع التقارب المحدد.\n\
/wait          ينتظر انتهاء البرنامج المشغَّل، ثم يخرج برمز الخروج\n\
الخاص به.\n\
/unix          يستخدم اسم ملف Unix ويفتح الملف كما يفعل مستكشف\n\
Windows.\n\
/ProgIDOpen    يفتح مستندًا باستخدام معرّف progID المحدد.\n\
/?             يعرض هذه التعليمات ثم يخرج.\n"
    WCMD_SET, "يعرض SET متغيرات بيئة cmd أو يغيّرها.\n\
\n\
يعرض SET دون معاملات البيئة الحالية كاملة.\n\
\n\
صيغة إنشاء متغير بيئة أو تعديله هي:\n\
\n\
SET <variable>=<value>\n\
\n\
حيث <variable> و<value> سلسلتا أحرف. يجب ألا تكون هناك مسافة قبل\n\
علامة المساواة، ولا يجوز أن يحتوي اسم المتغير على مسافات.\n\
\n\
في Wine، تُضمَّن بيئة نظام التشغيل الأساسي في بيئة Win32، ولذلك تكون\n\
القيم عادةً أكثر بكثير مما في تطبيق Win32 أصلي. لاحظ أنه لا يمكن\n\
التأثير في بيئة نظام التشغيل من داخل cmd.\n"
    WCMD_SHIFT, "يُستخدم SHIFT في ملف دفعي لإزالة معامل واحد من بداية القائمة، فيصبح\n\
المعامل 2 هو المعامل 1 وهكذا. ليس له أي أثر عند استدعائه من سطر\n\
الأوامر.\n"
    WCMD_TIME, "TIME لعرض أو ضبط توقيت النظام.\n"
    WCMD_TITLE, "TITLE <string> لضبط عنوان نافذة سطر الأوامر.\n"
    WCMD_TYPE, "ينسخ TYPE <filename> الملف <filename> إلى جهاز وحدة التحكم (أو إلى\n\
مكان آخر عند إعادة التوجيه). لا يُتحقَّق من أن الملف نص قابل للقراءة.\n"
    WCMD_VERIFY, "يُستخدم VERIFY لتعيين علامة التحقق أو مسحها أو اختبارها. الصيغ الصالحة هي:\n\
\n\
VERIFY ON\tتعيين العلامة.\n\
VERIFY OFF\tمسح العلامة.\n\
VERIFY\t\tعرض ON أو OFF حسب الحالة.\n\
\n\
ليس لعلامة التحقق أي وظيفة في Wine.\n"
    WCMD_VER, "VER يظهر إصدارة سطر الأوامر الحالية.\n"
    WCMD_VOL, "VOL يعرض تسمية وحدة التخزين لجهاز قرص.\n"
    WCMD_ENDLOCAL, "ينهي ENDLOCAL حصر تغييرات البيئة محليًا في ملف دفعي، وهي التغييرات\n\
التي بدأها أمر SETLOCAL سابق.\n"
    WCMD_SETLOCAL, "يبدأ SETLOCAL حصر تغييرات البيئة محليًا في ملف دفعي.\n\
\n\
تغييرات البيئة التي تُجرى بعد SETLOCAL تكون محلية في الملف الدفعي، وتبقى\n\
سارية حتى مصادفة ENDLOCAL التالي (أو نهاية الملف، أيهما أسبق)، وعندها\n\
تُستعاد إعدادات البيئة السابقة.\n"
    WCMD_PUSHD, "يحفظ PUSHD <directory> الدليل الحالي في مكدس، ثم يغيّر الدليل الحالي\n\
إلى الدليل المعطى.\n"
    WCMD_POPD, "POPD يقوم بتغيير المجلد الحالي إلى نظيره المحفوظ بواسطة PUSHD.\n"
    WCMD_ASSOC, "يعرض ASSOC اقترانات امتدادات الملفات أو يعدّلها.\n\
\n\
الصيغة: ASSOC [.ext[=[fileType]]]\n\
\n\
يعرض ASSOC دون معاملات اقترانات الملفات الحالية.\n\
إذا استُخدم مع امتداد ملف فقط، يعرض الاقتران الحالي.\n\
عدم تحديد نوع ملف بعد علامة المساواة يزيل الاقتران الحالي، إن وُجد.\n"
    WCMD_FTYPE, "يعرض FTYPE أوامر الفتح المقترنة بأنواع الملفات أو يعدّلها.\n\
\n\
الصيغة: FTYPE [fileType[=[openCommand]]]\n\
\n\
دون معاملات، يعرض أنواع الملفات المعرّفة لها حاليًا سلاسل أوامر فتح.\n\
إذا استُخدم مع نوع ملف فقط، يعرض سلسلة أمر الفتح المقترنة به، إن\n\
وُجدت.\n\
عدم تحديد أمر فتح بعد علامة المساواة يزيل سلسلة الأمر المقترنة بنوع\n\
الملف المحدد.\n"
    WCMD_MORE, "MORE يقوم بعرض المخرجات سواء من ملف أو من القنوات في صفحات.\n"
    WCMD_CHOICE, "يعرض CHOICE نصًا وينتظر حتى يضغط المستخدم مفتاحًا مسموحًا به من قائمة\n\
قابلة للاختيار.\n\
يُستخدم CHOICE أساسًا لإنشاء قائمة اختيار في ملف دفعي.\n"
    WCMD_EXIT, "ينهي EXIT جلسة الأوامر الحالية ويعود إلى نظام التشغيل أو الواجهة التي\n\
استدعيت منها cmd.\n"
    WCMD_MKLINK, "ينشئ ارتباطًا رمزيًا.\n\
\n\
الصيغة: MKLINK [options] link_name target\n\
\n\
الخيارات:\n\
/d             ينشئ ارتباطًا رمزيًا لدليل.\n\
/h             ينشئ ارتباطًا ثابتًا.\n\
/j             ينشئ نقطة وصل لدليل.\n\
link_name هو اسم الارتباط الرمزي الجديد.\n\
target هو المسار الذي يشير إليه link_name.\n"
    WCMD_ALLHELP, "الأوامر المضمّنة في CMD هي:\n\
ASSOC\t\tعرض اقترانات امتدادات الملفات أو تعديلها\n\
ATTRIB\t\tعرض سمات ملفات DOS أو تغييرها\n\
CALL\t\tاستدعاء ملف دفعي من داخل ملف آخر\n\
CD (CHDIR)\tتغيير الدليل الافتراضي الحالي\n\
CHOICE\t\tانتظار ضغطة مفتاح من قائمة قابلة للاختيار\n\
CLS\t\tمسح شاشة وحدة التحكم\n\
COPY\t\tنسخ ملف\n\
CTTY\t\tتغيير جهاز الإدخال/الإخراج\n\
DATE\t\tعرض تاريخ النظام أو تغييره\n\
DEL (ERASE)\tحذف ملف أو مجموعة ملفات\n\
DIR\t\tسرد محتويات دليل\n\
ECHO\t\tنسخ نص مباشرة إلى مخرجات وحدة التحكم\n\
ENDLOCAL\tإنهاء حصر تغييرات البيئة محليًا في ملف دفعي\n\
FTYPE\t\tعرض أوامر الفتح المقترنة بأنواع الملفات أو تعديلها\n\
HELP\t\tعرض تعليمات موجزة عن موضوع\n\
MD (MKDIR)\tإنشاء دليل فرعي\n\
MKLINK\tإنشاء ارتباط رمزي\n\
MORE\t\tعرض المخرجات صفحةً صفحة\n\
MOVE\t\tنقل ملف أو مجموعة ملفات أو شجرة أدلة\n\
PATH\t\tضبط مسار البحث أو عرضه\n\
PAUSE\t\tإيقاف تنفيذ ملف دفعي مؤقتًا\n\
POPD\t\tاستعادة الدليل الأخير المحفوظ بواسطة PUSHD\n\
PROMPT\t\tتغيير موجّه الأوامر\n\
PUSHD\t\tالانتقال إلى دليل جديد مع حفظ الدليل الحالي\n\
REN (RENAME)\tإعادة تسمية ملف\n\
RD (RMDIR)\tحذف دليل فرعي\n\
SET\t\tضبط متغيرات البيئة أو عرضها\n\
SETLOCAL\tبدء حصر تغييرات البيئة محليًا في ملف دفعي\n\
START\t\tتشغيل برنامج، أو فتح مستند بالبرنامج المقترن به\n\
TIME\t\tضبط وقت النظام الحالي أو عرضه\n\
TITLE\t\tتعيين عنوان النافذة لجلسة CMD\n\
TYPE\t\tعرض محتويات ملف نصي\n\
VER\t\tعرض إصدار CMD الحالي\n\
VOL\t\tعرض تسمية وحدة التخزين لجهاز قرص\n\
XCOPY\t\tنسخ الملفات المصدر أو أشجار الأدلة إلى وجهة\n\
EXIT\t\tإغلاق CMD\n\
\n\
أدخل HELP <command> لمزيد من المعلومات عن أي من الأوامر أعلاه.\n"
    WCMD_CONFIRM, "هل أنت متأكد؟"
    WCMD_YES, "Y"
    WCMD_NO, "N"
    WCMD_NOASSOC, "اقتران الملف مفقود للامتداد %1\n"
    WCMD_NOFTYPE, "لا يوجد أمر فتح مقترن بنوع الملفات '%1'\n"
    WCMD_OVERWRITE, "هل تريد الكتابة فوق %1؟"
    WCMD_MORESTR, "أكثر..."
    WCMD_TRUNCATEDLINE, "قد يكون السطر في معالجة الملف الدفعي مقطوعًا. سيُستخدم:\n"
    WCMD_NYI, "لم يُنفَّذ بعد\n\
\n"
    WCMD_NOARG, "الوسيطة مفقودة\n"
    WCMD_SYNTAXERR, "خطأ في بناء الجملة\n"
    WCMD_FILENOTFOUND, "%1: الملف غير موجود\n"
    WCMD_NOCMDHELP, "لا تتوفر تعليمات لـ %1\n"
    WCMD_NOTARGET, "لم يتم العثور على هدف GOTO\n"
    WCMD_CURRENTDATE, "التاريخ الحالي هو %1\n"
    WCMD_CURRENTTIME, "الوقت الحالي هو %1\n"
    WCMD_NEWDATE, "أدخل التاريخ الجديد: "
    WCMD_NEWTIME, "أدخل الوقت الجديد: "
    WCMD_MISSINGENV, "متغير البيئة %1 غير معرف\n"
    WCMD_READFAIL, "فشل فتح '%1'\n"
    WCMD_CALLINSCRIPT, "لا يمكن استدعاء تسمية دفعية خارج ملف دفعي\n"
    WCMD_ALL, "A"
    WCMD_DELPROMPT, "هل تريد حذف %1؟"
    WCMD_ECHOPROMPT, "ECHO في وضع %1\n"
    WCMD_VERIFYPROMPT, "VERIFY في وضع %1\n"
    WCMD_VERIFYERR, "يجب أن تكون قيمة VERIFY إما ON أو OFF\n"
    WCMD_ARGERR, "خطأ في المعامل\n"
    WCMD_VOLUMESERIALNO, "الرقم التسلسلي لوحدة التخزين هو %1!04x!-%2!04x!\n\
\n"
    WCMD_VOLUMEPROMPT, "تسمية وحدة التخزين (11 حرفًا، <Enter> لتركها فارغة)؟"
    WCMD_ANYKEY, "اضغط أي مفتاح للاستمرار... "
    WCMD_CONSTITLE, "سطر أوامر واين"
    WCMD_VERSION, "Microsoft Windows [Version %1!S!]\n"
