file(GLOB ICONS "${ICON_DIR}/*.svg")
list(SORT ICONS)
set(content "#include \"shellframe.h\"\n\nnamespace ShellFrame\n{\n\nstruct ICON_SOURCE\n{\n    LPCWSTR Name;\n    const char *Svg;\n};\n\nextern const ICON_SOURCE IconSources[] =\n{\n")
set(count 0)
foreach(icon ${ICONS})
    get_filename_component(name ${icon} NAME_WE)
    string(REGEX REPLACE "^ic_fluent_" "" name ${name})
    file(READ ${icon} svg)
    string(APPEND content "    { L\"${name}\", R\"svg(${svg})svg\" },\n")
    math(EXPR count "${count} + 1")
endforeach()
string(APPEND content "};\n\nextern const unsigned IconSourceCount = ${count};\n\n}\n")
file(WRITE ${OUTPUT}.tmp "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
