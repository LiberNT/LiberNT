STRINGTABLE
BEGIN
    IDS_ACCOUNTTITLE "Name your computer and create your account"
    IDS_CONFIGURE_SYSTEM "Configuring LiberNT..."
    IDS_CONFIG_FOLDERS "Creating the system and profile folders"
    IDS_CONFIG_DEVICES "Installing the device classes"
    IDS_CONFIG_NETWORK "Installing the network protocols"
    IDS_CONFIG_SETTINGS "Applying the computer settings"
    IDS_CONFIG_COMPONENTS "Registering the components"
    IDS_CONFIG_SHORTCUTS "Creating the Start menu shortcuts"
    IDS_CONFIG_SECURITY "Applying the security settings"
