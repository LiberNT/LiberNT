STRINGTABLE
BEGIN
    IDS_TYPETITLE "Tipo de instalação"
    IDS_TYPESUBTITLE "Escolha como o LiberNT partilha este computador."
    IDS_TYPE_FOUND "Este computador tem %s em %s."
    IDS_TYPE_ALONGSIDE "Instalar o LiberNT &ao lado de %s"
    IDS_TYPE_SPLITSIZE "%s: %s"
    IDS_TYPE_SHRINKNOTE "Arraste o controlo de deslize para dividir o espaço. %s mantém os seus programas e ficheiros. A partição é reduzida assim que selecionar Seguinte."
    IDS_TYPE_HIBERNATED "%s está em hibernação ou foi encerrado com o Arranque rápido, por isso a partição não pode ser redimensionada em segurança. Inicie o %s, escolha Reiniciar no menu Iniciar e volte a iniciar a instalação. Também pode desativar o Arranque rápido em Painel de Controlo > Opções de Energia."
    IDS_TYPE_NOSPACE "%s não tem espaço livre suficiente para dar lugar ao LiberNT, que precisa de pelo menos %I64u GB. Liberte espaço ou escolha Outra opção."
    IDS_TYPE_NORESIZE "A partição do %s não pode ser redimensionada. Escolha Outra opção para escolher outro local para o LiberNT."
    IDS_TYPE_PLANNED "%s foi redimensionado para %s. O LiberNT será instalado na nova partição de %s."
    IDS_TYPE_WARNING "%s inicia por predefinição. Para iniciar o LiberNT, abra o menu de arranque do computador durante o arranque, normalmente com F12, F11, F9 ou Esc, e escolha LiberNT Boot Manager. No Windows também pode utilizar Definições > Sistema > Recuperação > Arranque avançado > Utilizar um dispositivo."
    IDS_TYPE_CONFIRM_TITLE "Redimensionar %s agora?"
    IDS_TYPE_CONFIRM "%s é reduzido de %s para %s de imediato, antes do resto da instalação, e o LiberNT fica com %s. Certifique-se de que tem cópia de segurança dos ficheiros que pretende manter."
    IDS_TYPE_WINDOWS11 "Windows 11"
    IDS_TYPE_WINDOWS10 "Windows 10"
    IDS_TYPE_WINDOWS "Windows"
    IDS_READY_DEFAULTOS "Inicia por predefinição: %s"
    IDS_TYPE_LIBERNT "LiberNT"
END
