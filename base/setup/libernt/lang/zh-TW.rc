LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

/* Dialogs */

IDD_RESIZE DIALOGEX 0, 0, 300, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shrink"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_RESIZE_LABEL_TOTAL, 7, 13, 190, 8
    EDITTEXT IDC_RESIZE_TOTAL, 203, 10, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "", IDC_RESIZE_LABEL_AVAILABLE, 7, 32, 190, 8
    EDITTEXT IDC_RESIZE_AVAILABLE, 203, 29, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "", IDC_RESIZE_LABEL_AMOUNT, 7, 51, 190, 8
    EDITTEXT IDC_RESIZE_AMOUNT, 203, 48, 80, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_RESIZE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 283, 48, 10, 13
    LTEXT "", IDC_RESIZE_LABEL_AFTER, 7, 70, 190, 8
    EDITTEXT IDC_RESIZE_AFTER, 203, 67, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    ICON "", IDC_RESIZE_ICON, 8, 85, 10, 10, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "You cannot shrink a volume beyond the point where any unmovable files are located.", IDC_RESIZE_NOTE, 25, 86, 268, 26
    DEFPUSHBUTTON "", IDOK, 180, 149, 54, 14
    PUSHBUTTON "Cancel", IDCANCEL, 239, 149, 54, 14
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SHRINK_CAPTION "Shrink %s"
    IDS_EXTEND_CAPTION "Extend %s"
    IDS_SHRINK_TOTAL "Total size before shrink in MB:"
    IDS_SHRINK_AVAILABLE "Size of available shrink space in MB:"
    IDS_SHRINK_AMOUNT "&Enter the amount of space to shrink in MB:"
    IDS_SHRINK_AFTER "Total size after shrink in MB:"
    IDS_SHRINK_BUTTON "&Shrink"
    IDS_EXTEND_TOTAL "Total size before extend in MB:"
    IDS_EXTEND_AVAILABLE "Size of available space in MB:"
    IDS_EXTEND_AMOUNT "&Enter the amount of space to add in MB:"
    IDS_EXTEND_AFTER "Total size after extend in MB:"
    IDS_EXTEND_BUTTON "E&xtend"
    IDS_RESIZE_PENDING "Partition changes are waiting to be applied. Shrink and extend take effect immediately, so do them before creating, deleting or formatting partitions."
    IDS_RESIZE_FAILED "The partition could not be resized."
    IDS_CAPTION "LiberNT 安裝程式"
    IDS_DRIVETITLE "設定安裝磁碟區和系統資料夾"
    IDS_PROCESSTITLE "設定磁碟分割，複製檔案並安裝系統"
    IDS_PROCESSSUBTITLE "建立並格式化磁碟分割，複製檔案，安裝並設定載入程式。"
    IDS_ABORTSETUP "LiberNT 尚未完全安裝在您的電腦上。如果現在結束安裝程式，您將需要重新執行安裝程式來安裝 LiberNT。您確定要結束嗎？"
    IDS_ABORTSETUP2 "終止安裝？"
    IDS_NO_TXTSETUP_SIF "無法找到「txtsetup.sif」。\n安裝程式無法繼續。"
    IDS_FINISH_NO_REBOOT "Setup needs to restart your computer to continue with the second installation step.\n\nClick on Restart to immediately restart your computer.\nClick on Postpone to quit the installer and restart your computer at a later time."
    IDS_ABORT_NO_REBOOT "Click on Restart to immediately restart your computer.\nClick on Close to quit the installer."
    IDS_INSTALLBTN "安裝(&I)"
    IDS_RESTARTBTN "&Restart"
    IDS_POSTPONEBTN "&Postpone"
END

