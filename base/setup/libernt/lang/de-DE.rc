STRINGTABLE
BEGIN
    IDS_SHRINK_CAPTION "%s verkleinern"
    IDS_EXTEND_CAPTION "%s erweitern"
    IDS_SHRINK_TOTAL "Gesamtgröße vor dem Verkleinern in MB:"
    IDS_SHRINK_AVAILABLE "Zum Verkleinern verfügbarer Speicher in MB:"
    IDS_SHRINK_AMOUNT "Zu verkleinernder Speicher in &MB:"
    IDS_SHRINK_AFTER "Gesamtgröße nach dem Verkleinern in MB:"
    IDS_SHRINK_BUTTON "&Verkleinern"
    IDS_EXTEND_TOTAL "Gesamtgröße vor dem Erweitern in MB:"
    IDS_EXTEND_AVAILABLE "Verfügbarer Speicher in MB:"
    IDS_EXTEND_AMOUNT "Hinzuzufügender Speicher in &MB:"
    IDS_EXTEND_AFTER "Gesamtgröße nach dem Erweitern in MB:"
    IDS_EXTEND_BUTTON "&Erweitern"
    IDS_RESIZE_PENDING "Partitionsänderungen stehen noch aus. Verkleinern und Erweitern werden sofort ausgeführt; führen Sie sie daher vor dem Erstellen, Löschen oder Formatieren von Partitionen aus."
    IDS_RESIZE_FAILED "Die Größe der Partition konnte nicht geändert werden."
    IDS_CAPTION "LiberNT-Setup"
    IDS_DRIVETITLE "Wo möchten Sie LiberNT installieren?"
    IDS_PROCESSTITLE "LiberNT wird installiert"
    IDS_PROCESSSUBTITLE "Setup bereitet den Datenträger vor, kopiert die Dateien, konfiguriert LiberNT und installiert den Bootloader. Das kann einige Minuten dauern."
    IDS_ABORTSETUP "LiberNT ist nicht vollständig auf Ihrem Computer installiert. Wenn Sie Setup jetzt beenden, müssen Sie Setup erneut ausführen, um LiberNT zu installieren. Wirklich beenden?"
    IDS_ABORTSETUP2 "Installation abbrechen?"
    IDS_NO_TXTSETUP_SIF "'txtsetup.sif' wurde nicht gefunden.\nSetup kann nicht fortfahren."
    IDS_FINISH_NO_REBOOT "Starten Sie den Computer neu, um LiberNT zu starten. Starten Sie nicht erneut vom Installationsmedium.\n\nKlicken Sie auf Neu starten, um den Computer sofort neu zu starten.\nKlicken Sie auf Später, um Setup zu beenden und den Computer später neu zu starten."
    IDS_ABORT_NO_REBOOT "Klicken Sie auf Neu starten, um den Computer sofort neu zu starten.\nKlicken Sie auf Schließen, um Setup zu beenden."
    IDS_INSTALLBTN "&Installieren"
    IDS_RESTARTBTN "&Neu starten"
    IDS_POSTPONEBTN "&Später"
END

