LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

/* Dialogs */

IDD_SETUPFRAME DIALOGEX 0, 0, 420, 240
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "LiberNT セットアップ"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_FRAME_TITLE, 120, 10, 290, 14, SS_NOPREFIX
    LTEXT "", IDC_FRAME_SUBTITLE, 120, 26, 290, 18, SS_NOPREFIX
    LTEXT "", IDC_FRAME_PAGE, 120, 48, 290, 160, NOT WS_VISIBLE
    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 120, 212, 300, 1
    PUSHBUTTON "戻る(&B)", IDC_FRAME_BACK, 250, 219, 50, 14
    DEFPUSHBUTTON "次へ(&N)", IDC_FRAME_NEXT, 305, 219, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 360, 219, 50, 14
END

IDD_DISKPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_DISKLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 106
    LTEXT "", IDC_DISKINFO, 0, 110, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON "新規(&W)", IDC_DISKNEW, 0, 123, 30, 14
    PUSHBUTTON "削除(&D)", IDC_DISKDELETE, 33, 123, 30, 14
    PUSHBUTTON "フォーマット(&F)", IDC_DISKFORMAT, 66, 123, 56, 14
    PUSHBUTTON "拡張(&X)", IDC_DISKEXTEND, 125, 123, 30, 14
    PUSHBUTTON "縮小(&H)", IDC_DISKSHRINK, 158, 123, 30, 14
    PUSHBUTTON "ドライブ消去(&E)", IDC_DISKERASE, 191, 123, 56, 14
    PUSHBUTTON "更新(&R)", IDC_DISKREFRESH, 250, 123, 40, 14
    LTEXT "", IDC_DISKNOTE, 0, 142, 290, 18, SS_NOPREFIX
END

IDD_NEWPARTITION DIALOGEX 0, 0, 210, 62
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "新しいパーティション"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_NEWSIZE_RANGE, 7, 10, 130, 9
    EDITTEXT IDC_NEWSIZE, 140, 8, 52, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_NEWSIZE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 192, 8, 10, 13
    DEFPUSHBUTTON "OK", IDOK, 97, 41, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 153, 41, 50, 14
END

IDD_LANGUAGEPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "言語と地域(&L):", IDC_STATIC, 0, 4, 95, 9
    COMBOBOX IDC_LANGUAGELIST, 100, 2, 190, 140, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT "キーボード(&K):", IDC_STATIC, 0, 24, 95, 9
    COMBOBOX IDC_LAYOUTLIST, 100, 22, 190, 140, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT "選んだキーボードはセットアップですぐに使えるようになります。アカウント名とパスワードもこのキーボードで入力できます。", IDC_STATIC, 0, 128, 290, 26
END

IDD_APPSPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_APPLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 104
    LTEXT "", IDC_APPSPACE, 0, 108, 290, 10, SS_NOPREFIX
    LTEXT "インストールしないコンポーネントはチェックを外してください。ダウンロードにはインターネット接続を使います。各パッケージは、インストールの前に発行元の署名またはチェックサムで検証されます。", IDC_STATIC, 0, 124, 290, 34
END

IDD_STORAGEPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_STORAGEINFO, 0, 2, 290, 18, SS_NOPREFIX
    AUTORADIOBUTTON "今すぐドライブ C: を拡張して再起動する(&E)", IDC_EXPANDNOW, 0, 28, 290, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "後で行う(&N)", IDC_EXPANDLATER, 0, 42, 290, 10
    LTEXT "LiberNT は拡張を完了するために一度再起動し、その後このセットアップがもう一度開きます。", IDC_STATIC, 0, 60, 290, 18
    LTEXT "後で行うこともできます。管理者としてコマンド プロンプトで lntexpandstorage を実行してください。次に表示されるコンポーネントには、1 GB を超える空き領域が必要です。", IDC_STATIC, 0, 124, 290, 34
END

IDD_ACCOUNTPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "コンピューター名(&M):", IDC_STATIC, 0, 4, 95, 9
    EDITTEXT IDC_COMPUTERNAME, 100, 2, 190, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "ユーザー名(&U):", IDC_STATIC, 0, 22, 95, 9
    EDITTEXT IDC_USERNAME, 100, 20, 190, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "パスワード(&P):", IDC_STATIC, 0, 40, 95, 9
    EDITTEXT IDC_PASSWORD1, 100, 38, 190, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "パスワードの確認(&O):", IDC_STATIC, 0, 58, 95, 9
    EDITTEXT IDC_PASSWORD2, 100, 56, 190, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "パスワードのヒント(&H):", IDC_STATIC, 0, 76, 95, 9
    EDITTEXT IDC_PASSWORDHINT, 100, 74, 190, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "タイム ゾーン(&T):", IDC_STATIC, 0, 96, 95, 9
    COMBOBOX IDC_TIMEZONELIST, 100, 94, 190, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "夏時間に合わせて自動的に調整する(&D)", IDC_AUTODAYLIGHT, 100, 111, 190, 10, WS_TABSTOP
    LTEXT "このアカウントは Administrators グループのメンバーです。パスワードを空にすると、LiberNT はこのアカウントに自動的にサインインします。", IDC_STATIC, 0, 130, 290, 26
END

IDD_READYPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT IDC_READY_SUMMARY, 0, 0, 290, 90, ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT "LiberNT は開発中です。評価とテストに使い、普段使いのオペレーティング システムとしては使わないでください。データが壊れたり、ハードウェアが損傷したりするおそれがあります。", IDC_READY_WARNING, 0, 97, 290, 28
    AUTOCHECKBOX "内容を理解し、残したいデータはバックアップした(&U)", IDC_CONFIRM_INSTALL, 0, 132, 290, 20, BS_MULTILINE | BS_TOP | WS_TABSTOP
END

IDD_PROCESSPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_ACTIVITY, 0, 40, 290, 10, SS_NOPREFIX
    CONTROL "", IDC_PROCESSPROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE | WS_BORDER, 0, 56, 290, 10
    LTEXT "", IDC_ITEM, 0, 72, 290, 20, SS_NOPREFIX
END

IDD_FINISHPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_FINISHLOGO, "Static", SS_OWNERDRAW, 0, 0, 290, 96
    LTEXT "", IDC_FINISHTEXT, 0, 102, 290, 40, SS_NOPREFIX
    CONTROL "", IDC_RESTART_PROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_BORDER, 0, 148, 290, 8
END

IDD_RESIZE DIALOGEX 0, 0, 300, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "縮小"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_RESIZE_LABEL_TOTAL, 7, 13, 190, 8
    EDITTEXT IDC_RESIZE_TOTAL, 203, 10, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "", IDC_RESIZE_LABEL_AVAILABLE, 7, 32, 190, 8
    EDITTEXT IDC_RESIZE_AVAILABLE, 203, 29, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "", IDC_RESIZE_LABEL_AMOUNT, 7, 51, 190, 8
    EDITTEXT IDC_RESIZE_AMOUNT, 203, 48, 80, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_RESIZE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 283, 48, 10, 13
    LTEXT "", IDC_RESIZE_LABEL_AFTER, 7, 70, 190, 8
    EDITTEXT IDC_RESIZE_AFTER, 203, 67, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    ICON "", IDC_RESIZE_ICON, 8, 85, 10, 10, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "移動できないファイルがある位置を超えてボリュームを縮小することはできません。", IDC_RESIZE_NOTE, 25, 86, 268, 26
    DEFPUSHBUTTON "", IDOK, 180, 149, 54, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 239, 149, 54, 14
END

/* Strings */

STRINGTABLE
BEGIN
    IDS_SHRINK_CAPTION "%s の縮小"
    IDS_EXTEND_CAPTION "%s の拡張"
    IDS_SHRINK_TOTAL "縮小前の合計サイズ (MB):"
    IDS_SHRINK_AVAILABLE "縮小可能な領域のサイズ (MB):"
    IDS_SHRINK_AMOUNT "縮小する領域のサイズ (MB)(&E):"
    IDS_SHRINK_AFTER "縮小後の合計サイズ (MB):"
    IDS_SHRINK_BUTTON "縮小(&S)"
    IDS_EXTEND_TOTAL "拡張前の合計サイズ (MB):"
    IDS_EXTEND_AVAILABLE "利用可能な領域のサイズ (MB):"
    IDS_EXTEND_AMOUNT "追加する領域のサイズ (MB)(&E):"
    IDS_EXTEND_AFTER "拡張後の合計サイズ (MB):"
    IDS_EXTEND_BUTTON "拡張(&X)"
    IDS_RESIZE_PENDING "まだ適用されていないパーティションの変更があります。縮小と拡張はすぐに実行されるため、パーティションの作成、削除、フォーマットより先に行ってください。"
    IDS_RESIZE_FAILED "パーティションのサイズを変更できませんでした。"
    IDS_CAPTION "LiberNT セットアップ"
    IDS_DRIVETITLE "LiberNT のインストール場所の選択"
    IDS_PROCESSTITLE "LiberNT をインストールしています"
    IDS_PROCESSSUBTITLE "ディスクを準備し、ファイルをコピーして LiberNT を構成し、ブートローダーをインストールします。数分かかることがあります。"
    IDS_ABORTSETUP "LiberNT のインストールは完了していません。ここでセットアップを終了すると、LiberNT をインストールするにはセットアップをもう一度実行する必要があります。終了しますか?"
    IDS_ABORTSETUP2 "インストールを中断しますか?"
    IDS_NO_TXTSETUP_SIF "'txtsetup.sif'が見つかりません。\nセットアップは続行できません。"
    IDS_FINISH_NO_REBOOT "インストールの 2 番目の段階に進むには、コンピューターを再起動する必要があります。\n\n[再起動] をクリックすると、すぐに再起動します。\n[後で] をクリックすると、再起動せずにセットアップを終了します。"
    IDS_ABORT_NO_REBOOT "[再起動] をクリックすると、すぐに再起動します。\n[閉じる] をクリックすると、セットアップを終了します。"
    IDS_INSTALLBTN "インストール(&I)"
    IDS_RESTARTBTN "再起動(&R)"
    IDS_POSTPONEBTN "後で(&P)"
END

/* Setup window */

STRINGTABLE
BEGIN
    IDS_DISKSUBTITLE "パーティションか未割り当て領域を選んでください。縮小と拡張以外の変更は、[インストール] をクリックしたときに行われます。"
    IDS_ACCOUNTZONESUBTITLE "このアカウントで LiberNT にサインインします。時刻は選んだタイム ゾーンで表示されます。"
    IDS_READYTITLE "インストールの準備ができました"
    IDS_READYSUBTITLE "選んだ内容を確認してください。[インストール] をクリックすると、ディスクの変更が始まります。"
    IDS_DONETITLE "LiberNT がインストールされました"
    IDS_ABORTTITLE "LiberNT はインストールされませんでした"
    IDS_DONE_REBOOT "LiberNT を起動するため、数秒後にコンピューターが再起動します。インストール メディアからはもう起動しないでください。\n\n今すぐ再起動するには [再起動] をクリックしてください。"
    IDS_ABORT_REBOOT "セットアップは完了しませんでした。数秒後にコンピューターが再起動します。\n\n今すぐ再起動するには [再起動] をクリックしてください。"
    IDS_BACKBTN "戻る(&B)"
    IDS_NEXTBTN "次へ(&N)"
    IDS_CANCELBTN "キャンセル"
    IDS_CLOSEBTN "閉じる(&C)"
END

