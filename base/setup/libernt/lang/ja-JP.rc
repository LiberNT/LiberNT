    IDS_TYPE_RECOVERY "回復"
    IDS_TYPE_OEM "OEM (予約済み)"
    IDS_TYPE_LOGICAL "論理"
    IDS_TYPE_EXTENDED "拡張"
END

STRINGTABLE
BEGIN
    IDS_DISK_SELECT "LiberNT のインストール場所を選んでください。"
    IDS_DISK_NO_REGION "この領域は小さすぎるため、新しいパーティションを作成できません。"
    IDS_DISK_NOT_BASIC "このパーティションには LiberNT をインストールできません。プライマリ パーティションか未割り当て領域を選んでください。"
    IDS_DISK_TOO_SMALL "このパーティションは小さすぎるため、LiberNT をインストールできません。"
    IDS_DISK_MBR_ON_UEFI "このディスクには MBR パーティション テーブルがあるため、LiberNT をインストールできません。EFI システムでは GPT ディスクにのみインストールできます。"
    IDS_DISK_GPT_ON_BIOS "このディスクは GPT パーティション形式のため、LiberNT をインストールできません。"
    IDS_DISK_NOT_FIRMWARE "このコンピューターのファームウェアからは選んだドライブが見えないため、LiberNT がこのドライブから起動しない可能性があります。\n\nそれでも使う場合は [OK] をクリックしてください。"
    IDS_DISK_NEW_SYSTEM "LiberNT のすべての機能が正しく動作するよう、システム ファイル用のパーティションも作成されます。"
    IDS_DISK_FORMAT_WARN "このパーティションをフォーマットすると、保存されているデータはすべて失われます。残したいファイルは先にバックアップしてください。"
    IDS_DISK_FORMAT_NTFS "LiberNT は NTFS にインストールされます。このパーティションはフォーマットされ、保存されているデータはすべて失われます。"
    IDS_DISK_FORMAT_EXISTING "このパーティションには Windows か LiberNT がインストールされています。フォーマットするとデータはすべて失われます。残す場合は別のパーティションを選んでください。"
    IDS_DISK_ERASE_WARN "インストールが始まると、ドライブ %lu のすべてのパーティションと、そこに保存されているすべてのデータが削除されます。"
    IDS_NEWPART_RANGE "サイズ (MB、最大 %I64u)(&S):"
END

STRINGTABLE
BEGIN
    IDS_READY_TARGET "LiberNT を %s (%s) にインストールします。"
    IDS_READY_ERASE "ドライブ %lu を消去します。"
    IDS_READY_DELETE "%s を削除します。"
