STRINGTABLE
BEGIN
    IDS_TYPETITLE "インストールの種類"
    IDS_TYPESUBTITLE "このコンピューターで LiberNT をどのように使うか選んでください。"
    IDS_TYPE_FOUND "このコンピューターには %s が %s にインストールされています。"
