    IDS_READY_COMPUTER "コンピューター名: %s"
    IDS_READY_ACCOUNT "アカウント: %s"
    IDS_READY_TIMEZONE "タイム ゾーン: %s"
    IDS_READY_LANGUAGE "言語と地域: %s"
    IDS_READY_KEYBOARD "キーボード: %s"
    IDS_LANGUAGETITLE "言語とキーボードの選択"
    IDS_LANGUAGESUBTITLE "セットアップと LiberNT はこの言語と、その言語の日付、時刻、数値、通貨の形式を使います。"
END

STRINGTABLE
BEGIN
    IDS_INSTALL_FAILED "LiberNT をインストールできませんでした"
    IDS_INSTALL_STEP_FAILED "%s\nこの手順はステータス 0x%08lx で失敗しました。"
