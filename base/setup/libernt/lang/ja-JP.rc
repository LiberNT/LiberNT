    IDS_OOBE_STORAGESUBTITLE "LiberNT は、ドライブ C: を実行中のストレージ デバイス全体に広げることができます。"
    IDS_OOBE_STORAGE_INFO "ドライブ C: は %I64u MB で、空きは %I64u MB です。ストレージ デバイスの残りの部分はまだ使われていません。"
    IDS_OOBE_EXPAND_RESTART "ドライブ C: を拡張するため LiberNT を再起動します"
    IDS_OOBE_EXPAND_RESTART_TEXT "ドライブ C: をストレージ デバイス全体に広げた後、LiberNT が再起動します。再起動後、このセットアップがもう一度開きます。"
    IDS_OOBE_EXPAND_FAILED "ドライブ C: を拡張できませんでした (lntexpandstorage の終了コード %lu)。セットアップは続行します。後でコマンド プロンプトから lntexpandstorage を実行して、もう一度試すことができます。"
    IDS_OOBE_APPS_SPACE "選んだコンポーネントには約 %lu MB 必要です。ドライブ C: の空きは %I64u MB です。"
    IDS_OOBE_APPS_NOSPACE "選んだコンポーネントに必要な空き領域が足りません"
    IDS_OOBE_APPS_NOSPACE_TEXT "約 %lu MB 必要ですが、ドライブ C: の空きは %I64u MB です。続行するには、いくつかのチェックを外してください。後でインストールするには、コマンド プロンプトで lntexpandstorage を実行してドライブ C: を拡張してから、%%SystemRoot%%\\system32\\oobe\\oobe.exe /components を実行してください。"
    IDS_OOBE_INSTALL_DRIVERS "デバイスのドライバーをインストールしています..."
END

/* Progress Strings */

STRINGTABLE
BEGIN
    IDS_FORMATTING_PROGRESS1 "ボリューム %c: (%s) をフォーマット中 (%s 内)..."
    IDS_FORMATTING_PROGRESS2 "ボリューム %s をフォーマット中 (%s 内)..."

    IDS_CHECKING_PROGRESS1 "ボリューム %c: (%s) をチェック中 ..."
    IDS_CHECKING_PROGRESS2 "ボリューム %s をチェック中..."

    IDS_COPYING  "コピーしています (%s)"
    IDS_MOVING   "移動しています (%s から %s へ)"
    IDS_RENAMING "名前を変更しています (%s から %s へ)"
    IDS_DELETING "削除しています (%s)"

