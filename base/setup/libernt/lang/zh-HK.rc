STRINGTABLE
BEGIN
    IDS_UPGRADETITLE "Upgrade LiberNT"
    IDS_UPGRADESUBTITLE "LiberNT is already installed on this computer."
    IDS_UPGRADE_NEW_INSTALL "&Custom: install a new copy of LiberNT (advanced)"
    IDS_UPGRADE_NEW_COPY "&Don't upgrade: set up this copy of LiberNT instead"
