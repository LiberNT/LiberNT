STRINGTABLE
BEGIN
    IDS_UPDATE_CHECKTITLE "LiberNT Update"
    IDS_UPDATE_CHECKSUBTITLE "LiberNT looks for a newer version."
    IDS_UPDATE_CHECKING "Checking for updates..."
    IDS_UPDATE_UPTODATE "LiberNT is up to date (build %lu)."
    IDS_UPDATE_CHECKFAILED "LiberNT could not check for updates (error 0x%08lx). Check the network connection and try again later."
    IDS_UPDATE_TITLE "A LiberNT update is available"
    IDS_UPDATE_SUBTITLE "%s (update %lu)"
    IDS_UPDATE_SIZE "Download size: %s"
    IDS_UPDATE_DOWNLOADBTN "&Download"
    IDS_UPDATE_LATERBTN "Restart &later"
    IDS_UPDATE_DOWNLOADTITLE "Getting the update ready"
    IDS_UPDATE_DOWNLOADSUBTITLE "You can keep using your computer while LiberNT downloads and prepares the update."
    IDS_UPDATE_DOWNLOADING "Downloading %s"
    IDS_UPDATE_DOWNLOADED "%s of %s"
    IDS_UPDATE_VERIFYING "Checking the download of %s"
    IDS_UPDATE_EXTRACTING "Unpacking %s"
    IDS_UPDATE_PREPARING "Preparing the restart into Setup for %s"
    IDS_UPDATE_STAGEFAILED "The update could not be prepared (error 0x%08lx)."
    IDS_UPDATE_READYTITLE "Restart to install the update"
    IDS_UPDATE_READYSUBTITLE "LiberNT installs the update while it restarts."
    IDS_UPDATE_READYTEXT "%s is ready. When your computer restarts, LiberNT installs it before it starts, keeps your files, apps and settings, and restarts once more to finish. This takes a few minutes.\n\nSave your work before you restart."
    IDS_UPDATE_NOTIFYTITLE "LiberNT update available"
    IDS_UPDATE_NOTIFYTEXT "%s is available. Select this notification to see what is new and download it."
    IDS_UPDATE_NOTIFYSTAGED "%s is ready to install. Restart your computer to install it."
    IDS_UPDATE_COMPLETETITLE "Finishing the LiberNT update"
    IDS_UPDATE_COMPLETESUBTITLE "Your files, apps and settings are kept. Your computer restarts when this is done."
    IDS_UPDATE_COMPLETE_REGISTRY "Updating system settings"
    IDS_UPDATE_COMPLETE_COMPONENTS "Configuring system components"
    IDS_UPDATE_COMPLETE_CLEANUP "Cleaning up"
    IDS_UPDATE_COMPLETE_FAILED "%s could not be installed. LiberNT keeps the version you had."
    IDS_UPDATE_COMPLETE_RETRYBOOT "LiberNT could not finish installing %s. It tries again when you restart your computer."
    IDS_UPDATE_COMPLETE_RETRYLOGON "LiberNT could not finish setting up %s. It tries again the next time an administrator signs in."
    IDS_UPDATE_COMPLETE_NOSPACE "%s could not be installed because the system drive does not have enough free space. LiberNT keeps the version you had and offers the update again."
    IDS_UPDATE_COMPLETE_DAMAGED "%s could not be installed because the downloaded copy is damaged. LiberNT keeps the version you had and downloads the update again."
END

STRINGTABLE
BEGIN
    IDS_HOST_STARTTITLE "Install or upgrade LiberNT"
    IDS_HOST_STARTSUBTITLE "LiberNT is already installed on this computer."
    IDS_HOST_INSTALLNEW "&Install a new copy of LiberNT alongside %s"
    IDS_HOST_UPGRADENOTE "Upgrade replaces the LiberNT system files with this version and keeps your files, the apps you installed, the user accounts and the settings. The computer restarts, and LiberNT installs the upgrade while it starts.\n\nThis version: %s"
    IDS_HOST_INSTALLNOTE "%s gives part of its space to a new partition, and the computer restarts into LiberNT Setup, which installs LiberNT there.\n\nThis version: %s"
    IDS_HOST_SHRINKNOTE "Drag the slider to share the space. %s keeps its programs and files. Windows shrinks its partition when you start the installation."
    IDS_HOST_NOSPACE "%s does not have enough free space to make room for LiberNT, which needs at least %I64u GB. Free some space in %s, then start Setup again."
    IDS_HOST_NORESIZE "Windows cannot tell how far the %s partition can shrink (error 0x%08lx), so Setup cannot make room for LiberNT."
    IDS_HOST_READYSUBTITLE "Review your choices. Setup starts changing your disk when you click Install."
    IDS_HOST_READY_SHRINK "%s (%s) shrinks from %s to %s."
    IDS_HOST_READY_CREATE "A new %s partition is created for LiberNT after it."
    IDS_HOST_READY_PREPARED "LiberNT is installed in the %s partition that Setup prepared earlier."
    IDS_HOST_READY_RESTART "Setup copies the LiberNT image (%s) to that partition, then restarts the computer into LiberNT Setup, which installs LiberNT there. Until then, nothing else changes."
    IDS_HOST_READY_UPGRADE "Setup copies the LiberNT image (%s) to the LiberNT partition and restarts the computer. LiberNT installs the upgrade while it starts, and finishes it when an administrator signs in."
    IDS_HOST_PROCESSTITLE "Preparing LiberNT Setup"
    IDS_HOST_PROCESSSUBTITLE "Setup prepares the disk and the boot menu. The computer restarts when this is done."
    IDS_HOST_STEP_SHRINK "Shrinking %s..."
    IDS_HOST_STEP_CREATE "Creating the LiberNT partition..."
    IDS_HOST_STEP_FORMAT "Formatting the LiberNT partition..."
    IDS_HOST_STEP_COPY "Copying the LiberNT image..."
    IDS_HOST_STEP_CHECK "Checking the copied image..."
    IDS_HOST_STEP_BOOT "Adding LiberNT Setup to the boot menu..."
    IDS_HOST_STEP_STAGE "Preparing the upgrade..."
    IDS_HOST_PROGRESS "%I64u MB of %I64u MB"
    IDS_HOST_DONETITLE "LiberNT Setup is ready"
    IDS_HOST_DONE "Setup prepared the installation. The computer restarts into LiberNT Setup in a few seconds. Save your work in other apps first, or select Postpone: LiberNT Setup then starts the next time the computer restarts."
    IDS_HOST_UPGRADEDONETITLE "The upgrade is ready"
    IDS_HOST_UPGRADEDONE "Setup prepared the upgrade. The computer restarts in a few seconds, and LiberNT installs the upgrade while it starts. Save your work in other apps first, or select Postpone: the upgrade then starts the next time the computer restarts."
    IDS_HOST_FAILEDTITLE "Setup could not prepare LiberNT"
    IDS_HOST_FAILED "Setup stopped at this step: %s\n\nError %lu (0x%08lx)."
    IDS_HOST_CANNOTTITLE "LiberNT cannot be installed from Windows"
    IDS_HOST_NOTMEDIA "Start Setup from the LiberNT image: open the LiberNT .iso file in File Explorer, then run setup.exe from the drive that opens."
    IDS_HOST_WRONGARCH "This LiberNT image is made for another processor architecture than this computer. Download the LiberNT image made for this computer."
    IDS_HOST_NOUEFI "Windows started this computer in legacy BIOS mode. Setup can install LiberNT from Windows only on computers that start in UEFI mode. Start the computer from the LiberNT image instead."
    IDS_HOST_NOGPT "Windows is on a disk that does not use the GPT partition style. Setup can install LiberNT from Windows only on GPT disks. Start the computer from the LiberNT image instead."
    IDS_HOST_NOESP "Setup cannot find the EFI system partition that starts Windows (error %lu)."
    IDS_HOST_ESPFULL "The EFI system partition needs %s of free space for the LiberNT Setup boot files."
    IDS_HOST_SECUREBOOT_TITLE "Turn off Secure Boot first"
    IDS_HOST_SECUREBOOT "Secure Boot is on. The LiberNT boot loader is not signed for Secure Boot, so this computer would refuse to start it. Turn off Secure Boot in the firmware settings, start Windows, then start Setup again."
    IDS_HOST_FIRMWAREBTN "Restart to the firmware settings"
    IDS_HOST_PENDING_TITLE "LiberNT Setup is ready to continue"
    IDS_HOST_PENDING "Setup already prepared a %s partition for LiberNT on this computer. Continue to copy the image again and restart into LiberNT Setup, or undo the preparation to give the space back to %s."
    IDS_HOST_CONTINUEBTN "Continue the installation"
    IDS_HOST_UNDOBTN "Undo the preparation"
    IDS_HOST_UNDONE "The preparation was undone, and %s has its space back."
    IDS_HOST_UNDOFAILED "The preparation could not be undone completely (error %lu, 0x%08lx). Use Disk Management to delete the LiberNT partition and to extend %s."
    IDS_HOST_INUSE "An upgrade of LiberNT on %s is not finished. Start LiberNT to finish it or to roll it back, then start Setup again."
    IDS_HOST_NOSTORE "Setup cannot find the boot configuration of the LiberNT installation on %s, so it cannot upgrade it from Windows. Start LiberNT and upgrade it with LiberNT Update, or start the computer from the LiberNT image."
    IDS_HOST_NOTADMIN "Setup needs administrator rights. Start it again and accept the administrator prompt."
    IDS_HOST_LOWSPACE "The LiberNT partition on %s needs %s of free space for the upgrade image."
    IDS_HOST_VOLUMEERRORS "%s has file system errors, so Windows cannot shrink it. Run ""chkdsk %s /f"" as an administrator, restart the computer so that Windows repairs the drive, then start Setup again."
    IDS_HOST_CHECKINGSIZE "Windows is checking how much space %s can give to LiberNT..."
END
