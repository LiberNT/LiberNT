    IDS_SHRINK_AVAILABLE "可以騰出嘅空間 (MB):"
    IDS_SHRINK_AMOUNT "輸入要縮細幾多空間 (MB)(&E):"
    IDS_SHRINK_AFTER "縮細後嘅總容量 (MB):"
    IDS_SHRINK_BUTTON "縮細(&S)"
    IDS_EXTEND_TOTAL "延伸前嘅總容量 (MB):"
    IDS_EXTEND_AVAILABLE "可以用嘅空間 (MB):"
    IDS_EXTEND_AMOUNT "輸入要加幾多空間 (MB)(&E):"
    IDS_EXTEND_AFTER "延伸後嘅總容量 (MB):"
    IDS_EXTEND_BUTTON "延伸(&X)"
    IDS_RESIZE_PENDING "仲有未套用嘅分割區改動。「縮細」同「延伸」會即刻生效，所以請喺新增、刪除或者格式化分割區之前做咗先。"
    IDS_RESIZE_FAILED "改唔到呢個分割區嘅大細。"
    IDS_CAPTION "LiberNT 安裝程式"
    IDS_DRIVETITLE "你想將 LiberNT 裝落邊度？"
    IDS_PROCESSTITLE "安裝緊 LiberNT"
    IDS_PROCESSSUBTITLE "安裝程式準備緊隻磁碟、複製緊檔案、設定緊 LiberNT 同埋安裝開機載入程式，可能要等幾分鐘。"
    IDS_ABORTSETUP "LiberNT 仲未喺你部電腦度裝完。如果而家退出安裝程式，下次就要重新行過安裝程式先裝到 LiberNT。真係要退出？"
    IDS_ABORTSETUP2 "中止安裝？"
    IDS_NO_TXTSETUP_SIF "搵唔到「txtsetup.sif」。\n安裝程式繼續唔到。"
    IDS_FINISH_NO_REBOOT "請重新啟動部電腦嚟啟動 LiberNT，唔好再用安裝媒體開機。\n\n撳「重新啟動」即刻重啟部電腦。\n撳「遲啲先」退出安裝程式，遲啲自己再重啟。"
    IDS_ABORT_NO_REBOOT "撳「重新啟動」即刻重啟部電腦。\n撳「關閉」退出安裝程式。"
    IDS_INSTALLBTN "安裝(&I)"
    IDS_RESTARTBTN "重新啟動(&R)"
    IDS_POSTPONEBTN "遲啲先(&P)"
END

/* Setup window */

STRINGTABLE
BEGIN
    IDS_DISKSUBTITLE "揀個分割區或者未分配空間。除咗「縮細」同「延伸」之外，安裝程式要等你撳「安裝」之後先會改動你隻磁碟。"
    IDS_ACCOUNTZONESUBTITLE "你會用呢個帳戶登入 LiberNT，系統亦會跟呢個時區顯示時間。"
    IDS_READYTITLE "準備好安裝"
    IDS_READYSUBTITLE "請核對清楚你揀嘅設定。一撳「安裝」，安裝程式就會開始改動你隻磁碟。"
    IDS_DONETITLE "LiberNT 已經裝好"
    IDS_ABORTTITLE "LiberNT 未裝好"
    IDS_DONE_REBOOT "部電腦會喺幾秒後重新啟動並進入 LiberNT，唔好再用安裝媒體開機。\n\n想即刻重啟就撳「重新啟動」。"
    IDS_ABORT_REBOOT "安裝未完成，部電腦會喺幾秒後重新啟動。\n\n想即刻重啟就撳「重新啟動」。"
    IDS_BACKBTN "上一步(&B)"
    IDS_NEXTBTN "下一步(&N)"
    IDS_CANCELBTN "取消"
    IDS_CLOSEBTN "關閉(&C)"
    IDS_SKIPBTN "跳過(&S)"
END

