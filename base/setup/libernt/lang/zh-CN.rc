STRINGTABLE
BEGIN
    IDS_HOST_STARTTITLE "安装或升级 LiberNT"
    IDS_HOST_STARTSUBTITLE "这台计算机上已安装 LiberNT。"
    IDS_HOST_INSTALLNEW "与 %s 并存安装新的 LiberNT 副本(&I)"
    IDS_HOST_UPGRADENOTE "升级会将 LiberNT 系统文件替换为此版本，并保留你的文件、已安装的应用、用户帐户和设置。计算机将重新启动，LiberNT 会在启动期间安装升级。\n\n此版本: %s"
    IDS_HOST_INSTALLNOTE "%s 会划出一部分空间创建新分区，随后计算机重新启动进入 LiberNT 安装程序并在该分区安装 LiberNT。\n\n此版本: %s"
    IDS_HOST_SHRINKNOTE "拖动滑块分配空间。%s 会保留其程序和文件。开始安装时，Windows 会压缩其分区。"
    IDS_HOST_NOSPACE "%s 没有足够的可用空间来容纳 LiberNT，LiberNT 至少需要 %I64u GB。请在 %s 中释放一些空间，然后重新启动安装程序。"
    IDS_HOST_NORESIZE "Windows 无法确定 %s 分区可压缩的空间量(错误 0x%08lx)，因此安装程序无法为 LiberNT 腾出空间。"
    IDS_HOST_READYSUBTITLE "请检查你的选择。单击“安装”后，安装程序开始更改你的磁盘。"
    IDS_HOST_READY_SHRINK "%s (%s) 将从 %s 压缩到 %s。"
    IDS_HOST_READY_CREATE "随后将为其创建一个新的 %s 分区用于安装 LiberNT。"
    IDS_HOST_READY_PREPARED "LiberNT 将安装在安装程序先前准备好的 %s 分区中。"
    IDS_HOST_READY_RESTART "安装程序会将 LiberNT 映像 (%s) 复制到该分区，然后重新启动计算机进入 LiberNT 安装程序完成安装。在此之前不会更改其他内容。"
    IDS_HOST_READY_UPGRADE "安装程序会将 LiberNT 映像 (%s) 复制到 LiberNT 分区并重新启动计算机。LiberNT 会在启动期间安装升级，并在管理员登录时完成收尾。"
    IDS_HOST_PROCESSTITLE "正在准备 LiberNT 安装程序"
