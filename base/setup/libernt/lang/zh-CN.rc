    IDS_HOST_STEP_CHECK "正在校验已复制的映像..."
    IDS_HOST_STEP_BOOT "正在将 LiberNT 安装程序添加到启动菜单..."
    IDS_HOST_STEP_STAGE "正在准备升级..."
    IDS_HOST_PROGRESS "%I64u MB / %I64u MB"
    IDS_HOST_DONETITLE "LiberNT 安装程序已准备就绪"
    IDS_HOST_DONE "安装程序已完成安装准备。计算机将在几秒钟后重新启动进入 LiberNT 安装程序。请先保存其他应用中的工作，或选择“推迟”以便在下次重新启动计算机时再启动 LiberNT 安装程序。"
    IDS_HOST_UPGRADEDONETITLE "升级已准备就绪"
    IDS_HOST_UPGRADEDONE "安装程序已完成升级准备。计算机将在几秒钟后重新启动，LiberNT 会在启动期间安装升级。请先保存其他应用中的工作，或选择“推迟”以便在下次重新启动计算机时再开始升级。"
    IDS_HOST_FAILEDTITLE "安装程序无法准备 LiberNT"
    IDS_HOST_FAILED "安装程序在此步骤停止: %s\n\n错误 %lu (0x%08lx)。"
    IDS_HOST_CANNOTTITLE "无法从 Windows 安装 LiberNT"
    IDS_HOST_NOTMEDIA "请从 LiberNT 映像启动安装程序：在文件资源管理器中打开 LiberNT .iso 文件，然后从打开的驱动器运行 setup.exe。"
    IDS_HOST_WRONGARCH "此 LiberNT 映像适用于其他处理器架构，与这台计算机不匹配。请下载适用于这台计算机的 LiberNT 映像。"
    IDS_HOST_NOUEFI "Windows 是以传统 BIOS 模式启动这台计算机的。安装程序只能在以 UEFI 模式启动的计算机上从 Windows 安装 LiberNT。请改为直接从 LiberNT 映像启动计算机。"
    IDS_HOST_NOGPT "Windows 所在的磁盘未使用 GPT 分区形式。安装程序只能在 GPT 磁盘上从 Windows 安装 LiberNT。请改为直接从 LiberNT 映像启动计算机。"
    IDS_HOST_NOESP "安装程序找不到启动 Windows 的 EFI 系统分区(错误 %lu)。"
    IDS_HOST_ESPFULL "EFI 系统分区需要 %s 的可用空间来存放 LiberNT 安装程序启动文件。"
    IDS_HOST_SECUREBOOT_TITLE "请先关闭安全启动"
    IDS_HOST_SECUREBOOT "安全启动(Secure Boot)已开启。LiberNT 启动加载程序未针对安全启动进行签名，因此计算机会拒绝启动它。请在固件设置中关闭安全启动，启动 Windows，然后重新运行安装程序。"
    IDS_HOST_FIRMWAREBTN "重新启动进入固件设置"
    IDS_HOST_PENDING_TITLE "LiberNT 安装程序已准备好继续"
    IDS_HOST_PENDING "安装程序先前已在这台计算机上为 LiberNT 准备了一个 %s 分区。你可以继续重新复制映像并重新启动进入 LiberNT 安装程序，也可以撤销准备以将空间归还给 %s。"
    IDS_HOST_CONTINUEBTN "继续安装"
    IDS_HOST_UNDOBTN "撤销准备"
    IDS_HOST_UNDONE "已撤销准备，空间已归还给 %s。"
    IDS_HOST_UNDOFAILED "无法完全撤销准备(错误 %lu，0x%08lx)。请使用“磁盘管理”删除 LiberNT 分区并扩展 %s。"
    IDS_HOST_INUSE "%s 上的 LiberNT 升级尚未完成。请先启动 LiberNT 以完成或回滚升级，然后重新运行安装程序。"
    IDS_HOST_NOSTORE "安装程序找不到 %s 上 LiberNT 安装的启动配置，因此无法从 Windows 对其升级。请启动 LiberNT 并使用“LiberNT 更新”进行升级，或从 LiberNT 映像启动计算机。"
    IDS_HOST_NOTADMIN "安装程序需要管理员权限。请重新启动安装程序并接受管理员权限提示。"
    IDS_HOST_LOWSPACE "%s 上的 LiberNT 分区需要 %s 的可用空间来存放升级映像。"
    IDS_HOST_VOLUMEERRORS "%s 存在文件系统错误，Windows 无法将其压缩。请以管理员身份运行 ""chkdsk %s /f""，重新启动计算机让 Windows 修复该驱动器，然后重新运行安装程序。"
    IDS_HOST_CHECKINGSIZE "Windows 正在检查 %s 可为 LiberNT 腾出多少空间..."
    IDS_HOST_IMAGENOTE "%s 会划出一部分空间创建新分区，安装程序将从此映像把 LiberNT 安装到该分区，随后计算机重新启动进入 LiberNT。\n\n此版本: %s"
    IDS_HOST_READY_IMAGE "安装程序会将映像 (%s) 中的 LiberNT 安装到该分区并添加到启动菜单，然后重新启动计算机进入 LiberNT。"
    IDS_HOST_IMAGEPROCESSTITLE "正在安装 LiberNT"
    IDS_HOST_STEP_INSTALLBOOT "正在将 LiberNT 添加到启动菜单..."
    IDS_HOST_INSTALLEDTITLE "LiberNT 已安装"
    IDS_HOST_INSTALLED "安装程序已安装 LiberNT。计算机将在几秒钟后重新启动进入 LiberNT。请先保存其他应用中的工作，或选择“推迟”以便在下次重新启动计算机时再启动 LiberNT。"
END
