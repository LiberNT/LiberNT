LANGUAGE LANG_ITALIAN, SUBLANG_NEUTRAL

/* Dialogs */

IDD_SETUPFRAME DIALOGEX 0, 0, 420, 240
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Installazione di LiberNT"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_FRAME_TITLE, 120, 10, 290, 14, SS_NOPREFIX
    LTEXT "", IDC_FRAME_SUBTITLE, 120, 26, 290, 18, SS_NOPREFIX
    LTEXT "", IDC_FRAME_PAGE, 120, 48, 290, 160, NOT WS_VISIBLE
    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 120, 212, 300, 1
    PUSHBUTTON "&Indietro", IDC_FRAME_BACK, 250, 219, 50, 14
    DEFPUSHBUTTON "&Avanti", IDC_FRAME_NEXT, 305, 219, 50, 14
    PUSHBUTTON "Annulla", IDCANCEL, 360, 219, 50, 14
END

IDD_DISKPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_DISKLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 106
    LTEXT "", IDC_DISKINFO, 0, 110, 290, 9, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON "&Nuova", IDC_DISKNEW, 0, 123, 36, 14
    PUSHBUTTON "&Elimina", IDC_DISKDELETE, 39, 123, 36, 14
    PUSHBUTTON "&Formatta", IDC_DISKFORMAT, 78, 123, 36, 14
    PUSHBUTTON "E&stendi", IDC_DISKEXTEND, 117, 123, 36, 14
    PUSHBUTTON "&Riduci", IDC_DISKSHRINK, 156, 123, 36, 14
    PUSHBUTTON "&Cancella disco", IDC_DISKERASE, 195, 123, 50, 14
    PUSHBUTTON "Aggi&orna", IDC_DISKREFRESH, 250, 123, 40, 14
    LTEXT "", IDC_DISKNOTE, 0, 142, 290, 18, SS_NOPREFIX
END

IDD_NEWPARTITION DIALOGEX 0, 0, 210, 62
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nuova partizione"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_NEWSIZE_RANGE, 7, 10, 130, 9
    EDITTEXT IDC_NEWSIZE, 140, 8, 52, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_NEWSIZE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 192, 8, 10, 13
    DEFPUSHBUTTON "OK", IDOK, 97, 41, 50, 14
    PUSHBUTTON "Annulla", IDCANCEL, 153, 41, 50, 14
END

IDD_LANGUAGEPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Lingua e area geografica:", IDC_STATIC, 0, 4, 95, 9
    COMBOBOX IDC_LANGUAGELIST, 100, 2, 190, 140, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Tastiera o metodo di input:", IDC_STATIC, 0, 24, 95, 9
    COMBOBOX IDC_LAYOUTLIST, 100, 22, 190, 140, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT "La tastiera funziona nell'installazione appena la scegli, così puoi usarla per digitare il nome e la password del tuo account.", IDC_STATIC, 0, 128, 290, 26
END

IDD_APPSPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_APPLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 0, 0, 290, 104
    LTEXT "", IDC_APPSPACE, 0, 108, 290, 10, SS_NOPREFIX
    LTEXT "Deseleziona una casella per saltare un componente. I download usano la connessione Internet e ogni pacchetto viene verificato con la firma o il checksum dell'editore prima dell'installazione.", IDC_STATIC, 0, 124, 290, 34
END

IDD_STORAGEPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_STORAGEINFO, 0, 2, 290, 18, SS_NOPREFIX
    AUTORADIOBUTTON "&Espandi l'unità C: ora e riavvia", IDC_EXPANDNOW, 0, 28, 290, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Non ora", IDC_EXPANDLATER, 0, 42, 290, 10
    LTEXT "LiberNT si riavvia una volta per completare, poi questa configurazione si riapre.", IDC_STATIC, 0, 60, 290, 18
    LTEXT "Puoi farlo anche più tardi: esegui lntexpandstorage nel Prompt dei comandi come amministratore. I componenti proposti in seguito richiedono più di 1 GB di spazio libero.", IDC_STATIC, 0, 124, 290, 34
END

IDD_ACCOUNTPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "No&me computer:", IDC_STATIC, 0, 4, 95, 9
    EDITTEXT IDC_COMPUTERNAME, 100, 2, 190, 13, ES_UPPERCASE | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Nome &utente:", IDC_STATIC, 0, 22, 95, 9
    EDITTEXT IDC_USERNAME, 100, 20, 190, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Password:", IDC_STATIC, 0, 40, 95, 9
    EDITTEXT IDC_PASSWORD1, 100, 38, 190, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "C&onferma password:", IDC_STATIC, 0, 58, 95, 9
    EDITTEXT IDC_PASSWORD2, 100, 56, 190, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Suggerimento password:", IDC_STATIC, 0, 76, 95, 9
    EDITTEXT IDC_PASSWORDHINT, 100, 74, 190, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&Fuso orario:", IDC_STATIC, 0, 96, 95, 9
    COMBOBOX IDC_TIMEZONELIST, 100, 94, 190, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Regola automaticamente l'ora &legale", IDC_AUTODAYLIGHT, 100, 111, 190, 10, WS_TABSTOP
    LTEXT "Questo account fa parte del gruppo Administrators. Se lasci vuota la password, LiberNT accede automaticamente a questo account.", IDC_STATIC, 0, 130, 290, 26
END

IDD_READYPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT IDC_READY_SUMMARY, 0, 0, 290, 90, ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT "LiberNT è in fase di sviluppo attivo. Usalo per valutazioni e test, non come sistema operativo principale. Può danneggiare i tuoi dati o il tuo hardware.", IDC_READY_WARNING, 0, 97, 290, 28
    AUTOCHECKBOX "Ho &capito e ho eseguito il backup dei dati che voglio conservare.", IDC_CONFIRM_INSTALL, 0, 132, 290, 20, BS_MULTILINE | BS_TOP | WS_TABSTOP
END

IDD_PROCESSPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_ACTIVITY, 0, 40, 290, 10, SS_NOPREFIX
    CONTROL "", IDC_PROCESSPROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE | WS_BORDER, 0, 56, 290, 10
    LTEXT "", IDC_ITEM, 0, 72, 290, 20, SS_NOPREFIX
END

IDD_FINISHPAGE DIALOGEX 0, 0, 290, 160
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_FINISHLOGO, "Static", SS_OWNERDRAW, 0, 0, 290, 96
    LTEXT "", IDC_FINISHTEXT, 0, 102, 290, 40, SS_NOPREFIX
    CONTROL "", IDC_RESTART_PROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_BORDER, 0, 148, 290, 8
END

IDD_RESIZE DIALOGEX 0, 0, 300, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Riduci"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_RESIZE_LABEL_TOTAL, 7, 13, 190, 8
    EDITTEXT IDC_RESIZE_TOTAL, 203, 10, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "", IDC_RESIZE_LABEL_AVAILABLE, 7, 32, 190, 8
    EDITTEXT IDC_RESIZE_AVAILABLE, 203, 29, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    LTEXT "", IDC_RESIZE_LABEL_AMOUNT, 7, 51, 190, 8
    EDITTEXT IDC_RESIZE_AMOUNT, 203, 48, 80, 13, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "", IDC_RESIZE_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 283, 48, 10, 13
    LTEXT "", IDC_RESIZE_LABEL_AFTER, 7, 70, 190, 8
    EDITTEXT IDC_RESIZE_AFTER, 203, 67, 90, 13, ES_READONLY | ES_AUTOHSCROLL | NOT WS_TABSTOP
    ICON "", IDC_RESIZE_ICON, 8, 85, 10, 10, SS_ICON | SS_REALSIZEIMAGE
    LTEXT "Non puoi ridurre un volume oltre il punto in cui si trovano file non spostabili.", IDC_RESIZE_NOTE, 25, 86, 268, 26
    DEFPUSHBUTTON "", IDOK, 180, 149, 54, 14
    PUSHBUTTON "Annulla", IDCANCEL, 239, 149, 54, 14
END

