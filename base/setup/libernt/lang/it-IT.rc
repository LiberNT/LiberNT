    IDS_EXTEND_TOTAL "Dimensione totale prima dell'estensione in MB:"
    IDS_EXTEND_AVAILABLE "Spazio disponibile in MB:"
    IDS_EXTEND_AMOUNT "Spazio da aggiungere in &MB:"
    IDS_EXTEND_AFTER "Dimensione totale dopo l'estensione in MB:"
