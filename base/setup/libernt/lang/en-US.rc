STRINGTABLE
BEGIN
    IDS_DISK_SELECT "Select where to install LiberNT."
    IDS_DISK_NO_REGION "This space is too small to hold a new partition."
    IDS_DISK_NOT_BASIC "LiberNT cannot be installed on this partition. Select a primary partition or unallocated space."
    IDS_DISK_NOT_FIRMWARE "The firmware of this computer does not see the selected drive, so LiberNT may not start from it.\n\nClick OK to use it anyway."
    IDS_DISK_NEW_SYSTEM "To make sure that all LiberNT features work correctly, Setup also creates partitions for system files."
    IDS_DISK_FORMAT_WARN "If you format this partition, all data stored on it will be lost. Back up any files you want to keep first."
    IDS_DISK_FORMAT_NTFS "LiberNT is installed on NTFS. Setup formats this partition, and all data stored on it will be lost."
    IDS_DISK_FORMAT_EXISTING "This partition already contains a Windows or LiberNT installation. Setup formats it, and all data stored on it will be lost. Select another partition to keep it."
    IDS_DISK_ERASE_WARN "All partitions on Drive %lu, and all data stored on them, are deleted when the installation starts."
    IDS_NEWPART_RANGE "&Size in MB (up to %I64u):"
END

STRINGTABLE
BEGIN
    IDS_READY_TARGET "LiberNT is installed on %s (%s)."
    IDS_READY_ERASE "Drive %lu is erased."
    IDS_READY_DELETE "%s is deleted."
    IDS_READY_CREATE "%s (%s) is created and formatted as %s."
    IDS_READY_FORMAT "%s (%s) is formatted as %s."
