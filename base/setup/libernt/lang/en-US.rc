END

STRINGTABLE
BEGIN
    IDS_OOBE_REGIONTITLE "Choose your region format and keyboard"
    IDS_OOBE_REGIONSUBTITLE "LiberNT uses this format for dates, times, numbers and currency, and this keyboard for typing."
