-	                                     UINT32 offset);
+	                                     UINT64 offset);
 	typedef UINT (*psRdpdrDriveWriteFile)(RdpdrServerContext* context, void* callbackData,
 	                                      UINT32 deviceId, UINT32 fileId, const char* buffer,
-	                                      UINT32 length, UINT32 offset);
+	                                      UINT32 length, UINT64 offset);
