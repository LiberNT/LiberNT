    IDS_CAB_SHOW_QUICK_ACCESS "Show Quick access"
    IDS_CAB_CUT "Cut"
    IDS_CAB_COPY "Copy"
    IDS_CAB_PASTE "Paste"
    IDS_CAB_RENAME "Rename"
    IDS_CAB_DELETE "Delete"
    IDS_CAB_BACK "Back"
    IDS_CAB_FORWARD "Forward"
    IDS_CAB_UP "Up"
    IDS_CAB_REFRESH "Refresh"
    IDS_CAB_MORE "See more"
