    IDS_COMMONFILES "Fitxategi arruntak"
END

STRINGTABLE
BEGIN
    IDS_DETECTIONDISABLED "Hautematea desgaituta"
    IDS_LOOKFORWHEEL "Detektatu errota"
    IDS_ASSUMEPRESENT "Demagun errota dagoela"
END

