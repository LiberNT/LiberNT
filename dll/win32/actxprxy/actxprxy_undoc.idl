]
interface IShellBrowserService : IUnknown
{
    [local] HRESULT Unknown([in] void *p1, [in] void *p2, [in] void *p3);
    HRESULT GetTravelLog([out] ITravelLog **pptl);
    [local] HRESULT ShowControlWindow([in] UINT id, [in] BOOL fShow);
    [local] HRESULT IsControlWindowShown([in] UINT id, [out] BOOL *pfShown);
    [local] HRESULT DisplayParseError([in] HRESULT hres, [in] LPCWSTR pwszPath);
    [local] HRESULT SetNavigateState([in] BNSTATE bnstate);
    [local] HRESULT GetNavigateState([out] BNSTATE *pbnstate);
    [local] HRESULT UpdateWindowList();
    HRESULT UpdateBackForwardState();
    [local] HRESULT SetFlags([in] DWORD dwFlags, [in] DWORD dwFlagMask);
    [local] HRESULT GetFlags([out] DWORD *pdwFlags);
    [local] HRESULT GetPidl([out] PIDLIST_ABSOLUTE *ppidl);
    [local] DWORD GetBrowserIndex();
    [local] HRESULT GetHistoryObject([out] IOleObject **ppole, [out] IStream **pstm, [out] IBindCtx **ppbc);
    [local] HRESULT GetPalette([out] HPALETTE *hpal);
    [local] HRESULT RegisterWindow([in] BOOL fForceRegister, [in] int swc);
    [local] HRESULT GetPropertyBag([in] DWORD flags, [in] REFIID riid, [out, iid_is(riid)] void **ppv);
    [local] HRESULT SetAsDefFolderSettings();
    [local] HRESULT CreateViewWindow([in] IShellItem *psi, [in] IShellView *psvNew, [in] IShellView *psvOld, [in] RECT *prcView, [out] HWND *phwnd);
}

