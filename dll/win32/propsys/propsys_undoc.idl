#pragma makedep proxy
#pragma makedep register

import "objidl.idl";
import "propsys.idl";

[
    object,
    uuid(fca2857d-1760-4ad3-8c63-c9b602fcbaea),
    pointer_default(unique)
]
interface IFilterCondition : IPersistStream
{
    HRESULT GetFilterName([in] DWORD name, [out, string] LPWSTR *ppszName);
    HRESULT GetTypeFlags([out] DWORD *pFlags);
    HRESULT GetPropertyKey([out] PROPERTYKEY *pkey);
    HRESULT GetCondition([out] ICondition **ppCondition);
}

[
    threading(both),
    uuid(f562a2c8-e850-4f05-8e7a-e7192e4e6c23)
]
coclass PSFactoryBuffer { interface IPSFactoryBuffer; }
