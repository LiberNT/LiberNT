LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_HLP_INTERFACE_SHOW "Displays information.\n"
    IDS_HLP_INTERFACE_SHOW_INTERFACE "Displays interfaces.\n"
    IDS_HLP_INTERFACE_SHOW_INTERFACE_EX "\nUsage:\n"

    IDS_HLP_IP_ADD "Adds a configuration entry to a table.\n"
    IDS_HLP_IP_ADD_ADDRESS     "Adds an IP address to the specified interface.\n"
    IDS_HLP_IP_ADD_ADDRESS_EX  "\nUsage: %1!s! [name=]<string> [[addr=]IP address [mask=]IP subnet mask]\n\
       [[gateway=]IP address [gwmetric=]integer]\n\n\
Parameters:\n\n\
      name         - The name of the IP interface.\n\
      addr         - The IP address to be added for the interface.\n\
      mask         - The IP subnet mask for the specified IP address.\n\
      gateway      - The default gateway for the specified IP address.\n\
      gwmetric     - The metric to the default gateway.\n\n\
Remarks: Adds IP addresses and default gateways to an interface. If DHCP\n\
         is enabled on the interface, it will be disabled.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" 10.0.0.2  255.0.0.0\n\
       %1!s! ""Local Area Connection"" gateway=10.0.0.3 gwmetric=2\n\n\
       The first command adds a static IP address of 10.0.0.2 with a subnet\n\
       mask of 255.0.0.0 to the Local Area Connection interface. The second\n\
       command adds the IP address of 10.0.0.3 as a second default gateway\n\
       for this interface with a gateway metric of 2.\n"

    IDS_HLP_IP_ADD_DNS    "Adds a static DNS server address.\n"
    IDS_HLP_IP_ADD_DNS_EX "\nUsage: %1!s! [name=]<string> [addr=]<IP address> [[index=]<integer>]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface where DNS servers are added.\n\
      addr         - The IP address for the DNS server you are adding.\n\
      index        - Specifies the index (preference) for the specified\n\
                     DNS server address.\n\n\
Remarks: Adds a new DNS server IP address to the statically-configured list.\n\
         By default, the DNS server is added to the end of the list.  If an\n\
         index is specified, the DNS server will be placed in that position\n\
         in the list, with other servers being moved down to make room.\n\
         If DNS servers were previously obtained through DHCP, the new\n\
         address will replace the old list.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" 10.0.0.1\n\
       %1!s! ""Local Area Connection"" 10.0.0.3 index=2\n"

    IDS_HLP_IP_DELETE            "Deletes a configuration entry from a table.\n"
    IDS_HLP_IP_DELETE_ADDRESS    "Deletes an IP address or default gateway from the specified interface.\n"
    IDS_HLP_IP_DELETE_ADDRESS_EX "\nUsage: %1!s! [name=]<string> [[addr=]IP address] [[gateway=]IP address|ALL]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface.\n\
      addr         - A static IP address for the interface specified by name.\n\
      gateway      - One of the following values:\n\
                     <IP address>: A specific default gateway IP address for\n\
                                   the static IP address you are deleting.\n\
                     ALL: Deletes all default gateway IP addresses for\n\
                          the static IP address you are deleting.\n\n\
Remarks: Deletes an IP address from an interface with multiple static IP\n\
         addresses, or deletes a default gateway from a specified interface.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" addr=10.0.0.1 gateway=all\n"

    IDS_HLP_IP_DELETE_ARPCACHE    "Flushes the ARP cache for one or all interfaces.\n"
    IDS_HLP_IP_DELETE_ARPCACHE_EX "\nUsage: %1!s! [name=]<string>\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The friendly name of a specific interface. If a name\n\
                     is not specified, the ARP caches for all interfaces\n\
                     are flushed.\n\n\
Remarks: Flushes the Address Resolution Protocol (ARP) cache on a specific\n\
         interface or all interfaces.\n\n\
Examples:\n\n\
       %1!s!\n\
       %1!s! name=""Local Area Connection""\n"

    IDS_HLP_IP_DELETE_DNS    "Deletes the DNS server from the specified interface.\n"
    IDS_HLP_IP_DELETE_DNS_EX "\nUsage: %1!s! [name=]<string> [[addr=]<IP address>|ALL ]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface where DNS servers are deleted.\n\
      addr         - One of the following values:\n\
                     <IP address>: A specific IP address of a DNS server\n\
                                   you are deleting.\n\
                     ALL: Deletes all configured IP addresses for DNS. servers.\n\n\
Remarks: Deletes statically configured DNS server IP addresses for a\n\
         specific interface.\n\n\
Examples:\n\n\
       %1!s! ""Local Area Connection"" 10.0.0.1\n\
       %1!s! ""Local Area Connection"" all\n"

    IDS_HLP_IP_SET             "Sets configuration information.\n"
    IDS_HLP_IP_SET_ADDRESS     "Sets the IP address or default gateway to the specified interface.\n"
    IDS_HLP_IP_SET_ADDRESS_EX  "\nUsage: %1!s! [name=]<string> \n\
       [[source=]dhcp | \n\
        [source=] static [addr=]IP address [mask=]IP subnet mask]\n\
       [[gateway=]<IP address>|none [gwmetric=]integer]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface.\n\
      source       - One of the following values:\n\
                     dhcp: Sets DHCP as the source for configuring IP\n\
                           addresses for the specific interface.\n\
                     static: Sets the source for configuring IP addresses\n\
                             to local static configuration.\n\
      gateway      - One of the following values:\n\
                     <IP address>: A specific default gateway for the\n\
                                   static IP address you are setting.\n\
                     none: No default gateways are set.\n\
      gwmetric     - The metric for the default gateway. This field should\n\
                     not be set if gateway is set to 'none'.\n\
      The following options are used only if source is 'static':\n\
      addr         - An IP address for the specified interface.\n\
      mask         - The subnet mask for the specified IP address.\n\n\
Remarks: Used to change the IP address configuration mode from either DHCP to\n\
         static mode or static mode to DHCP. Adds IP addresses on an\n\
         interface with static IP address or adds default gateways.\n\n\
Examples:\n\n\
       %1!s! name=""Local Area Connection"" source=dhcp\n\
       %1!s! local static 10.0.0.9 255.0.0.0 10.0.0.1 1\n"

    IDS_HLP_IP_SET_DNS         "Sets DNS server mode and addresses.\n"
    IDS_HLP_IP_SET_DNS_EX      "\nUsage: %1!s! [name=]<string> [source=]dhcp|static [addr=]<IP address>|none\n\
             [[register=]none|primary|both]\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of the interface.\n\
      source       - One of the following values:\n\
                     dhcp: Sets DHCP as the source for configuring DNS\n\
                           servers for the specific interface.\n\
                     static: Sets the source for configuring DNS servers\n\
                             to local static configuration.\n\
      addr         - One of the following values:\n\
                     <IP address>: An IP address for a DNS server.\n\
                     none: Clears the list of DNS servers.\n\
      register     - One of the following values:\n\
                     none: Disables Dynamic DNS registration.\n\
                     primary: Register under the primary DNS suffix only.\n\
                     both: Register under both the primary DNS suffix, as\n\
                           well as under the connection-specific suffix.\n\n\
Remarks: Sets DNS server configuration to either DHCP or static mode. Only\n\
         when source is 'static', is the 'addr' option also available for\n\
         configuring a static list of DNS server IP addresses for the\n\
         specified interface.\n\n\
Examples:\n\n\
       %1!s! name=""Local Area Connection"" source=dhcp\n\
       %1!s! ""Local Area Connection"" static 10.0.0.1 primary\n"

    IDS_HLP_IP_SHOW              "Displays IP information.\n"
    IDS_HLP_IP_SHOW_ADDRESSES    "Displays IP address configuration.\n"
    IDS_HLP_IP_SHOW_ADDRESSES_EX "\nUsage: %1!s! [[name=]string]\n\n\
Parameters:\n\n\
      Tag             Value\n\
      name            The name of a specific interface.\n\n\
Remarks: Displays the IP address configuration for a specific interface or interfaces.\n\n\
Examples:\n\n\
      %1!s! ""Local Area network""\n"
    IDS_HLP_IP_SHOW_CONFIG       "Displays IP address and additional information.\n"
    IDS_HLP_IP_SHOW_CONFIG_EX    "\nUsage: %1!s! [[name=]string]\n\n\
Parameters:\n\n\
      Tag             Value\n\
      name            The name of a specific interface.\n\n\
Remarks: Displays the IP address and DNS server configuration for a specific interface\nor interfaces.\n\n\
Examples:\n\n\
      %1!s! ""Local Area Network""\n"
    IDS_HLP_IP_SHOW_DNS          "Displays the DNS server addresses.\n"
    IDS_HLP_IP_SHOW_DNS_EX       "\nUsage: %1!s! [[name=]string]\n\n\
Parameters:\n\n\
      Tag             Value\n\
      name            The name of a specific interface.\n\n\
Remarks: Displays the DNS server configuration for a specific interface\nor interfaces.\n\n\
Examples:\n\n\
      %1!s! ""Local Area Network""\n"

    IDS_HLP_IP_RESET    "Resets TCP/IP and related components to a clean state.\n"
    IDS_HLP_IP_RESET_EX "\nUsage: %1!s! [name=]<string>\n\n\
Parameters:\n\n\
      Tag            Value\n\
      name         - The name of a file to which to append information\n\
                     regarding what settings were reset.\n\n\
Remarks: Resets TCP/IP and related components to a clean state.\n\n\
Examples:\n\n\
       %1!s! resetlog.txt\n"

    IDS_HLP_WINSOCK_RESET "Resets the Winsock Catalog to a clean state.\n"
    IDS_HLP_WINSOCK_RESET_EX "\nUsage: %1!s!\n\n\
Remarks: Resets the Winsock Catalog to a clean state.\n"
    IDS_HLP_WINSOCK_SHOW  "Displays information.\n"
    IDS_HLP_WINSOCK_SHOW_CATALOG "Displays contents of Winsock Catalog.\n"
    IDS_HLP_WINSOCK_SHOW_CATALOG_EX "\nUsage: %1!s! [[type=]full]\n\n\
Parameters:\n\n\
    \n"

    IDS_IP_HEADER        "\nConfiguration for interface ""%1!s!""\n"
    IDS_DHCP_ON          "    DHCP enabled:                         Yes\n"
    IDS_DHCP_OFF         "    DHCP enabled:                         No\n"
    IDS_NOIPADDRESS      "    IP Address:                           None\n"
    IDS_IPADDRESS        "    IP Address:                           %1!s!\n"
    IDS_IPADDRESSES      "    IP Addresses:                         %1!s!\n"
    IDS_NOSUBNETMASK     "    Subnet Mask:                          None\n"
    IDS_SUBNETMASK       "    Subnet Mask:                          %1!s!\n"
    IDS_SUBNETMASKS      "    Subnet Masks:                         %1!s!\n"
    IDS_DEFAULTGATEWAY   "    Default Gateway:                      %1!s!\n"
    IDS_GATEWAYMETRIC    "    Gateway Metric:                       %1!s!\n"
    IDS_INTERFACEMETRIC  "    Interface Metric:                     %1!s!\n"
    IDS_STATICNAMESERVER "    Statically configured DNS Servers:    %1!s!\n"
    IDS_DHCPNAMESERVER   "    DNS servers configured through DHCP:  %1!s!\n"
    IDS_EMPTYLINE        "                                          %1!s!\n"

    IDS_DUMP_NEWLINE     "\n"
    IDS_DUMP_HEADERLINE  "# ----------------------------------\n"

    IDS_DUMP_IP_HEADER    "# Interface IP Configuration\n"
    IDS_DUMP_IP_INTERFACE "# Interface IP Configuration for ""%1!s!""\n"
    IDS_DUMP_IP_FOOTER    "# End of Interface IP Configuration\n"

    IDS_ERROR_INVALID_INTERFACE  "\nInvalid interface %1!s! specified.\n"
    IDS_ERROR_BAD_VALUE "\n%1!s! is not an acceptable value for %2!s!.\n"
    IDS_ERROR_ALREADY_DHCP "\nDhcp is already enabled on this interface.\n"
    IDS_ERROR_GET_PROPERTIES "\nError obtaining configuration for interface %1!s!.\n"

    IDS_ERROR_ADD_DHCP_ADDRESS "\nCannot add a static IP address to an interface configured for DHCP.\n"
    IDS_ERROR_DELETE_DHCP_ADDRESS "\nCannot delete Dhcp configured IP Address.\n"
END

STRINGTABLE
BEGIN
    IDS_HLP_IPV6_ADD                  "Adds a configuration entry to a table.\n"
    IDS_HLP_IPV6_ADD_ADDRESS          "Adds an IPv6 address on an interface.\n"
    IDS_HLP_IPV6_ADD_ADDRESS_EX       "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>[/<integer>]\n             [[validlifetime=]<integer>|infinite] [[preferredlifetime=]<integer>|infinite]\n\nParameters:\n\n      Tag               Value\n      interface         Interface name or index.\n      address           IPv6 address to add, optionally followed by the\n                        subnet prefix length (default 64).\n      validlifetime     Lifetime over which the address is valid.\n      preferredlifetime Lifetime over which the address is preferred.\n\nExamples:\n\n      %1!s! ""Ethernet"" 2001:db8:1234::5/64\n"
    IDS_HLP_IPV6_ADD_DNSSERVERS       "Adds a static DNS server address.\n"
    IDS_HLP_IPV6_ADD_DNSSERVERS_EX    "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address> [[index=]<integer>]\n\nParameters:\n\n      Tag            Value\n      interface      Interface name or index.\n      address        IPv6 address of the DNS server.\n      index          Position of the server in the list.\n\nExamples:\n\n      %1!s! ""Ethernet"" 2001:db8:1234::1\n"
    IDS_HLP_IPV6_ADD_ROUTE            "Adds a route on an interface.\n"
    IDS_HLP_IPV6_ADD_ROUTE_EX         "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer> [interface=]<string>\n             [[nexthop=]<IPv6 address>] [[metric=]<integer>]\n\nParameters:\n\n      Tag            Value\n      prefix         Prefix for which to add a route.\n      interface      Interface name or index.\n      nexthop        Gateway address, if the prefix is not on-link.\n      metric         Route metric.\n\nExamples:\n\n      %1!s! ::/0 ""Ethernet"" fe80::1\n"
    IDS_HLP_IPV6_DELETE               "Deletes a configuration entry from a table.\n"
    IDS_HLP_IPV6_DELETE_ADDRESS       "Deletes an IPv6 address from an interface.\n"
    IDS_HLP_IPV6_DELETE_ADDRESS_EX    "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>\n\nParameters:\n\n      Tag            Value\n      interface      Interface name or index.\n      address        IPv6 address to delete.\n\nExamples:\n\n      %1!s! ""Ethernet"" 2001:db8:1234::5\n"
    IDS_HLP_IPV6_DELETE_DNSSERVERS    "Deletes a static DNS server address.\n"
    IDS_HLP_IPV6_DELETE_DNSSERVERS_EX "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>|all\n\nParameters:\n\n      Tag            Value\n      interface      Interface name or index.\n      address        IPv6 address of the DNS server, or all.\n\nExamples:\n\n      %1!s! ""Ethernet"" all\n"
    IDS_HLP_IPV6_DELETE_ROUTE         "Deletes a route.\n"
    IDS_HLP_IPV6_DELETE_ROUTE_EX      "\nUsage: %1!s! [prefix=]<IPv6 address>/<integer> [interface=]<string> [[nexthop=]<IPv6 address>]\n\nParameters:\n\n      Tag            Value\n      prefix         Prefix of the route to delete.\n      interface      Interface name or index.\n      nexthop        Gateway address of the route.\n\nExamples:\n\n      %1!s! ::/0 ""Ethernet"" fe80::1\n"
    IDS_HLP_IPV6_SHOW                 "Displays information.\n"
    IDS_HLP_IPV6_SHOW_ADDRESSES       "Shows IPv6 addresses.\n"
    IDS_HLP_IPV6_SHOW_ADDRESSES_EX    "\nUsage: %1!s! [[interface=]<string>]\n\nParameters:\n\n      Tag            Value\n      interface      Interface name or index.\n\nRemarks: Displays the IPv6 addresses of one or all interfaces.\n"
    IDS_HLP_IPV6_SHOW_DNSSERVERS      "Displays the DNS server addresses.\n"
    IDS_HLP_IPV6_SHOW_DNSSERVERS_EX   "\nUsage: %1!s! [[name=]<string>]\n"
    IDS_HLP_IPV6_SHOW_INTERFACES      "Shows interface parameters.\n"
    IDS_HLP_IPV6_SHOW_INTERFACES_EX   "\nUsage: %1!s!\n"
    IDS_HLP_IPV6_SHOW_NEIGHBORS       "Shows neighbor cache entries.\n"
    IDS_HLP_IPV6_SHOW_NEIGHBORS_EX    "\nUsage: %1!s!\n"
    IDS_HLP_IPV6_SHOW_PREFIXPOLICIES  "Shows prefix policy entries.\n"
    IDS_HLP_IPV6_SHOW_PREFIXPOLICIES_EX "\nUsage: %1!s!\n"
    IDS_HLP_IPV6_ADD_NEIGHBORS        "Adds a neighbor address.\n"
    IDS_HLP_IPV6_ADD_NEIGHBORS_EX     "\nUsage: %1!s! [interface=]<string> [address=]<IPv6 address>\n             [neighbor=]<string> [[store=]active|persistent]\n\nParameters:\n\n      Tag            Value\n      interface      Interface name or index.\n      address        IPv6 address of the neighbor.\n      neighbor       Link-layer address of the neighbor.\n      store          active: addition only lasts until next boot.\n                     persistent: addition is persistent. This is the default.\n\nExamples:\n\n      %1!s! ""Ethernet"" fe80::77 02-00-00-00-00-77\n"
    IDS_HLP_IPV6_DELETE_NEIGHBORS     "Deletes entries from the neighbor cache.\n"
    IDS_HLP_IPV6_DELETE_NEIGHBORS_EX  "\nUsage: %1!s! [interface=]<string> [[address=]<IPv6 address>] [[store=]active|persistent]\n\nParameters:\n\n      Tag            Value\n      interface      Interface name or index.\n      address        IPv6 address of the neighbor. All entries are deleted if omitted.\n      store          active: deletion only lasts until next boot.\n                     persistent: deletion is persistent. This is the default.\n\nExamples:\n\n      %1!s! ""Ethernet"" fe80::77\n"
    IDS_HLP_IPV6_SET                  "Sets configuration information.\n"
    IDS_HLP_IPV6_SET_INTERFACE        "Modifies interface configuration parameters.\n"
    IDS_HLP_IPV6_SET_INTERFACE_EX     "\nUsage: %1!s! [interface=]<string> [[metric=]<integer>] [[mtu=]<integer>]\n             [[siteprefixlength=]<integer>] [[routerdiscovery=]enabled|disabled|dhcp]\n             [[dadtransmits=]<integer>] [[basereachabletime=]<integer>]\n             [[retransmittime=]<integer>] [[forwarding=]enabled|disabled]\n             [[advertise=]enabled|disabled] [[managedaddress=]enabled|disabled]\n             [[otherstateful=]enabled|disabled] [[weakhostsend=]enabled|disabled]\n             [[weakhostreceive=]enabled|disabled] [[ignoredefaultroutes=]enabled|disabled]\n             [[advertisedefaultroute=]enabled|disabled] [[store=]active|persistent]\n\nParameters:\n\n      Tag                Value\n      interface          Interface name or index.\n      metric             Interface metric.\n      mtu                MTU of the interface.\n      siteprefixlength   Global prefix length of the site.\n      routerdiscovery    Router discovery behavior.\n      dadtransmits       Number of duplicate address detection transmits.\n      basereachabletime  Base reachable time, in milliseconds.\n      retransmittime     Retransmission interval, in milliseconds.\n      forwarding         Whether packets arriving here can be forwarded.\n      advertise          Whether router advertisements are sent.\n      managedaddress     Managed address configuration flag to advertise.\n      otherstateful      Other stateful configuration flag to advertise.\n      weakhostsend       Whether weak host sends are allowed.\n      weakhostreceive    Whether weak host receives are allowed.\n      ignoredefaultroutes Whether default routes on this interface are ignored.\n      advertisedefaultroute Whether a default route is advertised.\n      store              active: set only lasts until next boot.\n                         persistent: set is persistent. This is the default.\n\nExamples:\n\n      %1!s! ""Ethernet"" metric=20\n"
    IDS_HLP_IPV6_SHOW_ROUTE           "Shows route table entries.\n"
    IDS_HLP_IPV6_SHOW_ROUTE_EX        "\nUsage: %1!s!\n"
    IDS_IPV6_ADDRESS_HEADER  "\nInterface %1!lu!: %2!s!\n\nAddr Type  DAD State   Valid Life Pref. Life Address\n---------  ----------- ---------- ---------- ------------------------\n"
    IDS_IPV6_ROUTE_HEADER    "\nPublish  Type      Met  Prefix                    Idx  Gateway/Interface Name\n-------  --------  ---  ------------------------  ---  ------------------------\n"
    IDS_IPV6_INTERFACE_HEADER "\nIdx     Met         MTU          State                Name\n---  ----------  ----------  ------------  ---------------------------\n"
    IDS_IPV6_NEIGHBOR_HEADER "\nInterface %1!lu!: %2!s!\n\n\nInternet Address                              Physical Address   Type\n--------------------------------------------  -----------------  -----------\n"
    IDS_IPV6_DNS_HEADER      "\nConfiguration for interface ""%1!s!""\n"
    IDS_IPV6_DNS_DHCP        "    DNS servers configured through DHCP:  %1!s!\n"
    IDS_IPV6_DNS_STATIC      "    Statically Configured DNS Servers:    %1!s!\n"
    IDS_IPV6_DNS_NEXT        "                                          %1!s!\n"
    IDS_IPV6_DNS_SUFFIX      "    Register with which suffix:           Primary only\n"
    IDS_IPV6_OK              "Ok.\n\n"
    IDS_IPV6_POLICY_HEADER   "Querying active state...\n\nPrecedence  Label  Prefix\n----------  -----  --------------------------------\n"
END
