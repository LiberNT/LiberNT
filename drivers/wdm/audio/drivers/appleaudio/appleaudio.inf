[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%LiberNT%
DriverVer=11/06/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12
AppleAudio.CopyFiles=12

[Manufacturer]
%LiberNT%=AppleAudioModels,NTARM64

[AppleAudioModels.NTARM64]
%AppleAudio.DeviceDesc%=AppleAudio_Install,FDT\apple_macaudio

[AppleAudio_Install]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=AppleAudio.CopyFiles
AddReg=AppleAudio.AddReg

[AppleAudio_Install.Services]
AddService=appleaudio,0x00000002,AppleAudio_Service

[AppleAudio_Service]
DisplayName=%AppleAudio.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\appleaudio.sys

[AppleAudio.CopyFiles]
appleaudio.sys

[AppleAudio.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,appleaudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%AppleAudio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%AppleAudio.DeviceDesc%

[AppleAudio_Install.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,Wave,AppleAudio.WaveInterface
AddInterface=%KSCATEGORY_RENDER%,Wave,AppleAudio.WaveInterface
AddInterface=%KSCATEGORY_REALTIME%,Wave,AppleAudio.WaveInterface
AddInterface=%KSCATEGORY_CAPTURE%,Wave,AppleAudio.WaveInterface
AddInterface=%KSCATEGORY_AUDIO%,Topology,AppleAudio.TopologyInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,Topology,AppleAudio.TopologyInterface
AddInterface=%KSCATEGORY_AUDIO%,WaveSpeaker,AppleAudio.SpeakerWaveInterface
AddInterface=%KSCATEGORY_RENDER%,WaveSpeaker,AppleAudio.SpeakerWaveInterface
AddInterface=%KSCATEGORY_REALTIME%,WaveSpeaker,AppleAudio.SpeakerWaveInterface
AddInterface=%KSCATEGORY_AUDIO%,TopologySpeaker,AppleAudio.SpeakerTopologyInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologySpeaker,AppleAudio.SpeakerTopologyInterface

[AppleAudio.WaveInterface]
AddReg=AppleAudio.WaveInterface.AddReg

[AppleAudio.WaveInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AppleAudio.WaveName%

[AppleAudio.TopologyInterface]
AddReg=AppleAudio.TopologyInterface.AddReg

[AppleAudio.TopologyInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AppleAudio.TopologyName%

[AppleAudio.SpeakerWaveInterface]
AddReg=AppleAudio.SpeakerWaveInterface.AddReg

[AppleAudio.SpeakerWaveInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AppleAudio.SpeakerWaveName%

[AppleAudio.SpeakerTopologyInterface]
AddReg=AppleAudio.SpeakerTopologyInterface.AddReg

[AppleAudio.SpeakerTopologyInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AppleAudio.SpeakerTopologyName%

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
appleaudio.sys=1

[Strings]
LiberNT="LiberNT"
AppleAudio.DeviceDesc="Apple Silicon Audio"
AppleAudio.ServiceDesc="LiberNT Apple Silicon Audio Driver"
AppleAudio.WaveName="Headphones"
AppleAudio.TopologyName="Headphones Topology"
AppleAudio.SpeakerWaveName="Speakers"
AppleAudio.SpeakerTopologyName="Speakers Topology"
DiskName="LiberNT Installation Media"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
