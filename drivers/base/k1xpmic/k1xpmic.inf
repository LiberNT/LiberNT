; PROJECT:     LiberNT SpacemiT K1 PMIC Driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     SpacemiT K1 PMIC driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=k1xpmic.cat
DriverVer=10/03/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%ManufacturerName%=SpacemitMfg,NTRISCV64

[SpacemitMfg.NTRISCV64]
%K1XPMIC.DeviceDesc%=K1XPMIC_Inst,FDT\spacemit_spm8821
%K1XPMIC.PowerButtonDesc%=K1XPMIC_PowerButton,K1XPMIC\PowerButton

[K1XPMIC_Inst.NT]
CopyFiles=K1XPMIC_CopyFiles.NT

[K1XPMIC_CopyFiles.NT]
k1xpmic.sys

[K1XPMIC_Inst.NT.Services]
AddService=k1xpmic,0x00000002,K1XPMIC_Service_Inst

[K1XPMIC_PowerButton.NT]

[K1XPMIC_PowerButton.NT.Services]
AddService = , 0x00000002

[K1XPMIC_Service_Inst]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\k1xpmic.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
k1xpmic.sys=1

[Strings]
ProviderName="Ahmed ARIF"
ManufacturerName="SpacemiT"
DiskName="SpacemiT K1 PMIC Driver Disk"
K1XPMIC.DeviceDesc="SpacemiT K1 I2C controller"
K1XPMIC.PowerButtonDesc="SpacemiT P1 power button"
