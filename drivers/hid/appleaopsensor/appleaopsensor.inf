[Version]
Signature = "$Windows NT$"
Class = HIDClass
ClassGUID = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider = %LiberNT%
DriverVer = 11/11/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%StdMfg% = StdMfg

[StdMfg]
%AmbientLight.DeviceDesc% = AppleAopSensor_Inst,APPLEAOP\ALS
%LidAngle.DeviceDesc% = AppleAopSensor_Inst,APPLEAOP\LAS

[AppleAopSensor_Inst.NT]
CopyFiles = AppleAopSensor_CopyFiles

[AppleAopSensor_CopyFiles]
appleaopsensor.sys
hidclass.sys
hidparse.sys

[AppleAopSensor_Inst.NT.Services]
AddService = appleaopsensor,0x00000002,AppleAopSensor_Service

[AppleAopSensor_Service]
DisplayName = %AppleAopSensor.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\appleaopsensor.sys
LoadOrderGroup = Extended Base

[Strings]
LiberNT = "LiberNT Project"
StdMfg = "(Standard system devices)"
AmbientLight.DeviceDesc = "Apple Ambient Light Sensor"
LidAngle.DeviceDesc = "Apple Lid Angle Sensor"
AppleAopSensor.ServiceDesc = "Apple AOP Sensor HID Driver"
