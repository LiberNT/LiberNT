; PROJECT:     LiberNT SpacemiT K1 display miniport
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     SpacemiT K1 display driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%LiberNT%
DriverVer=10/03/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%LiberNT%=LiberNT,NTriscv64

[LiberNT.NTriscv64]
%K1xDpu.DeviceDesc%=K1xDpu_Install,FDT\spacemit_dpu

[K1xDpu_Install]
CopyFiles=K1xDpu_CopyFiles
AddReg=K1xDpu_SoftwareSettings

[K1xDpu_CopyFiles]
k1xdpu.sys

[K1xDpu_SoftwareSettings]
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,framebuf
HKR,,VgaCompatible,%REG_DWORD%,0
HKR,,"Device Description",%REG_SZ%,"%K1xDpu.DeviceDesc%"
HKR,,"OpenGLDriverName",%REG_SZ%,"mesa_gallium.dll"
HKR,,"OpenGLVersion",%REG_DWORD%,1
HKR,,"OpenGLFlags",%REG_DWORD%,0

[K1xDpu_Install.Services]
AddService=k1xdpu,0x00000002,K1xDpu_Service

[K1xDpu_Service]
DisplayName=%K1xDpu.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=0
ServiceBinary=%12%\k1xdpu.sys
LoadOrderGroup=Video

[Strings]
LiberNT="LiberNT"
K1xDpu.DeviceDesc="SpacemiT K1 Display (WDDM)"
K1xDpu.ServiceDesc="LiberNT SpacemiT K1 WDDM Display Driver"
REG_MULTI_SZ=0x00010000
REG_DWORD=0x00010001
REG_SZ=0x00000000
