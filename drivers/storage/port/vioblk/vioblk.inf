;
; PROJECT:     LiberNT StorPort VirtIO block miniport
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     Installs the StorPort VirtIO block miniport on VirtIO block devices
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>
;

[Version]
Signature  = "$Windows NT$"
Class      = SCSIAdapter
ClassGuid  = {4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider   = %ROS%
DriverVer  = 11/06/2026,10.0.0.1

[SourceDisksNames]
1 = %DeviceDesc%,,,

[SourceDisksFiles]
vioblk.sys = 1

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ROS% = VIOBLK

[VIOBLK]
%VIOBLK.DeviceDesc% = vioblk_Inst, PCI\VEN_1AF4&DEV_1001
%VIOBLK.DeviceDesc% = vioblk_Inst, PCI\VEN_1AF4&DEV_1042

[ControlFlags]
ExcludeFromSelect = *

[vioblk_Inst]
CopyFiles = vioblk_CopyFiles

[vioblk_Inst.HW]
AddReg = vioblk_HW_AddReg

[vioblk_HW_AddReg]
HKR, "Interrupt Management",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MSISupported", %REG_DWORD%, 0x00000001
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MessageNumberLimit", %REG_DWORD%, 0x00000002

[vioblk_Inst.Services]
AddService = vioblk, %SPSVCINST_ASSOCSERVICE%, vioblk_Service_Inst, Miniport_EventLog_Inst

[vioblk_Service_Inst]
DisplayName    = %DeviceDesc%
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_CRITICAL%
ServiceBinary  = %12%\vioblk.sys
LoadOrderGroup = SCSI Miniport
AddReg         = vioblk_Service_AddReg

[vioblk_CopyFiles]
vioblk.sys,,,1

[vioblk_Service_AddReg]
HKR, "Parameters\PnpInterface", "5", %REG_DWORD%, 0x00000001
HKR, "Parameters", "BusType", %REG_DWORD%, 0x00000001

[Miniport_EventLog_Inst]
AddReg = Miniport_EventLog_AddReg

[Miniport_EventLog_AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
ROS                     = "LiberNT"
DeviceDesc              = "VirtIO Block Driver"
VIOBLK.DeviceDesc       = "VirtIO Block Device"

SPSVCINST_ASSOCSERVICE = 0x00000002
SERVICE_KERNEL_DRIVER  = 1
SERVICE_BOOT_START     = 0
SERVICE_ERROR_CRITICAL = 3
REG_EXPAND_SZ          = 0x00020000
REG_DWORD              = 0x00010001
