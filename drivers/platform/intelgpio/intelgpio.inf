[Version]
Signature = "$Windows NT$"
Class = System
ClassGUID = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider = %LiberNT%
DriverVer = 08/04/2026,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%LiberNT% = LiberNT

[LiberNT]
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT344B
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT3451
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT345D
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT3450
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT34BB
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT3455
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT34C3
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT34C5
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT34C6
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1055
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT34C8
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1056
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1057
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1085
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC105E
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1083
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1082
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INTC1084
%IntelGpio.DeviceDesc% = IntelGpio_Inst,ACPI\INT34C4

[IntelGpio_Inst.NT]
CopyFiles = IntelGpio_CopyFiles

[IntelGpio_CopyFiles]
intelgpio.sys

[IntelGpio_Inst.NT.Services]
AddService = INTELGPIO,0x00000002,IntelGpio_Service

[IntelGpio_Service]
DisplayName = %IntelGpio.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\intelgpio.sys
LoadOrderGroup = Extended Base

[Strings]
LiberNT = "LiberNT Project"
IntelGpio.DeviceDesc = "Intel Serial I/O GPIO Host Controller"
IntelGpio.ServiceDesc = "LiberNT Intel GPIO Controller Driver"
