[Version]
Signature  = "$Windows NT$"
LayoutFile = layout.inf
Class      = Keyboard
ClassGUID  = {4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider   = %LiberNT%
DriverVer  = 10/21/2026,1.00

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%MicrosoftMfg% = MicrosoftMfg

[MicrosoftMfg]
%HyperKbd.DeviceDesc% = HyperKbd_Inst,VMBUS\{f912ad6d-2b17-48ea-bd65-f927a61c7684}

[HyperKbd_Inst.NT]
CopyFiles = HyperKbd_CopyFiles.NT

[HyperKbd_CopyFiles.NT]
hyperkbd.sys

[HyperKbd_Inst.NT.Services]
AddService = hyperkbd, 0x00000002, HyperKbd_Service_Inst

[HyperKbd_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\hyperkbd.sys
LoadOrderGroup = Keyboard Port

[Strings]
LiberNT = "LiberNT Project"
MicrosoftMfg = "Microsoft"
HyperKbd.DeviceDesc = "Microsoft Hyper-V Virtual Keyboard"
