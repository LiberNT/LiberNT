[IntelI2c_Inst.NT]
CopyFiles = IntelI2c_CopyFiles

[IntelI2c_CopyFiles]
inteli2c.sys

[IntelI2c_Inst.NT.Services]
AddService = INTELI2C,0x00000002,IntelI2c_Service

[IntelI2c_Service]
DisplayName = %IntelI2c.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\inteli2c.sys
LoadOrderGroup = Extended Base

[Strings]
LiberNT = "LiberNT Project"
IntelI2c.DeviceDesc = "Intel Serial I/O I2C Host Controller"
IntelI2c.ServiceDesc = "LiberNT Intel Serial I/O I2C Driver"
