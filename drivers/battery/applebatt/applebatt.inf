[Version]
Signature = "$Windows NT$"
Class = Battery
ClassGUID = {72631E54-78A4-11D0-BCF7-00AA00B7B32A}
Provider = %LiberNT%
DriverVer = 11/06/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[ClassInstall32.NT]
AddReg = BatteryClass.NT.AddReg

[BatteryClass.NT.AddReg]
HKR, , ,               0, %BatteryClassName%
HKR, , Icon, 0, "2"

[Manufacturer]
%StdMfg% = StdMfg

[StdMfg]
%AppleBatt.DeviceDesc% = AppleBatt_Inst,APPLESMC\BATTERY

[AppleBatt_Inst.NT]
AddReg = AppleBatt_AddReg
CopyFiles = AppleBatt_CopyFiles

[AppleBatt_AddReg]
HKR,,PowerSourceType,1,00,00,00,00

[AppleBatt_CopyFiles]
applebatt.sys
battc.sys

[AppleBatt_Inst.NT.Services]
AddService = applebatt,0x00000002,AppleBatt_Service

[AppleBatt_Service]
DisplayName = %AppleBatt.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\applebatt.sys

[Strings]
LiberNT = "LiberNT Project"
StdMfg = "(Standard system devices)"
AppleBatt.DeviceDesc = "Apple silicon internal battery"
AppleBatt.ServiceDesc = "Apple Silicon Battery Driver"
BatteryClassName = "Batteries"
