; PROJECT:     LiberNT StarFive JH7110 display miniport
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     StarFive JH7110 display driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%LiberNT%
DriverVer=10/10/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%LiberNT%=LiberNT,NTriscv64

[LiberNT.NTriscv64]
%Jh7110Dc.DeviceDesc%=Jh7110Dc_Install,FDT\starfive_jh7110-voutcrg

[Jh7110Dc_Install]
CopyFiles=Jh7110Dc_CopyFiles
AddReg=Jh7110Dc_SoftwareSettings

[Jh7110Dc_CopyFiles]
jh7110dc.sys

[Jh7110Dc_SoftwareSettings]
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,framebuf
HKR,,VgaCompatible,%REG_DWORD%,0
HKR,,"Device Description",%REG_SZ%,"%Jh7110Dc.DeviceDesc%"

[Jh7110Dc_Install.Services]
AddService=jh7110dc,0x00000002,Jh7110Dc_Service

[Jh7110Dc_Service]
DisplayName=%Jh7110Dc.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=0
ServiceBinary=%12%\jh7110dc.sys
LoadOrderGroup=Video

[Strings]
LiberNT="LiberNT"
Jh7110Dc.DeviceDesc="StarFive JH7110 Display (WDDM)"
Jh7110Dc.ServiceDesc="LiberNT StarFive JH7110 WDDM Display Driver"
REG_MULTI_SZ=0x00010000
REG_DWORD=0x00010001
REG_SZ=0x00000000
