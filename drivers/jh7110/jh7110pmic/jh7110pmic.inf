; PURPOSE:     StarFive JH7110 PMIC driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=jh7110pmic.cat
DriverVer=10/10/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%ManufacturerName%=StarFiveMfg,NTRISCV64

[StarFiveMfg.NTRISCV64]
%JH7110PMIC.DeviceDesc%=JH7110PMIC_Inst,FDT\snps_designware-i2c

[JH7110PMIC_Inst.NT]
CopyFiles=JH7110PMIC_CopyFiles.NT

[JH7110PMIC_CopyFiles.NT]
jh7110pmic.sys

[JH7110PMIC_Inst.NT.Services]
AddService=jh7110pmic,0x00000002,JH7110PMIC_Service_Inst

[JH7110PMIC_Service_Inst]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\jh7110pmic.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
jh7110pmic.sys=1

[Strings]
ProviderName="Ahmed ARIF"
ManufacturerName="StarFive"
DiskName="StarFive JH7110 PMIC Driver Disk"
JH7110PMIC.DeviceDesc="StarFive JH7110 PMIC bus"
