; PROJECT:     LiberNT VMXNET3 Ethernet Driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     Installation file for the VMXNET3 virtual Ethernet adapter
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature  = "$Windows NT$"
LayoutFile = layout.inf
Class      = Net
ClassGUID  = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider   = %LiberNT%
DriverVer  = 01/01/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%VMwareMfg% = VMwareMfg

[VMwareMfg]
%VMXNET3.DeviceDesc% = VMX3_Inst.ndi,PCI\VEN_15AD&DEV_07B0

[VMX3_Inst.ndi.NT]
Characteristics = 0x4
*IfType = 6
*MediaType = 0
*PhysicalMediaType = 14
BusType = 5
AddReg = VMX3_AddReg.NT
CopyFiles = VMX3_CopyFiles.NT

[VMX3_CopyFiles.NT]
vmx3.sys

[VMX3_AddReg.NT]
HKR, Ndi,            Service,    0, "vmx3"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[VMX3_Inst.ndi.NT.Services]
AddService = vmx3, 0x00000002, VMX3_Service_Inst

[VMX3_Service_Inst]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\vmx3.sys
LoadOrderGroup = NDIS

[Strings]
LiberNT = "LiberNT Project"
VMwareMfg = "VMware, Inc."
VMXNET3.DeviceDesc = "VMXNET3 Ethernet Adapter"
