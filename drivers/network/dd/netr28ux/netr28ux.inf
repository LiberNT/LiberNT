; NT specific
;*******************************************************************************************
[RTUSB_OS61.ndi.NT.reg]
HKR, Ndi,                   Service,            0, "netr28ux"
HKR, Ndi\Interfaces,        UpperRange,         0, "ndis5"
HKR, Ndi\Interfaces,        LowerRange,         0, "wlan,ethernet,vwifi"

[RTUSB_CTV1W.ndi.NT.reg]
HKR, Ndi,                   Service,            0, "CTV1W"
HKR, Ndi\Interfaces,        UpperRange,         0, "ndis5"
HKR, Ndi\Interfaces,        LowerRange,         0, "wlan,ethernet,vwifi"

[Generic.Service]
DisplayName                 = %Generic.Service.DispName%
ServiceType                 = 1                             ;%SERVICE_KERNEL_DRIVER%
StartType                   = 3                             ;%SERVICE_AUTO_START%
ErrorControl                = 1                             ;%SERVICE_ERROR_NORMAL%
ServiceBinary               = %12%\netr28ux.sys
LoadOrderGroup              = NDIS

[CTV1W.Service]
DisplayName                 = %CTV1W.Service.DispName%
ServiceType                 = 1                             ;%SERVICE_KERNEL_DRIVER%
StartType                   = 3                             ;%SERVICE_AUTO_START%
ErrorControl                = 1                             ;%SERVICE_ERROR_NORMAL%
ServiceBinary               = %12%\CTV1W.sys
LoadOrderGroup              = NDIS

