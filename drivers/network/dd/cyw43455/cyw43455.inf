; PROJECT:     LiberNT Broadcom/Cypress CYW43xx Native 802.11 Miniport
; LICENSE:     GPL-2.0-or-later (https://spdx.org/licenses/GPL-2.0-or-later)
; PURPOSE:     CYW43xx SDIO Native Wi-Fi miniport installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %LiberNT%
DriverVer   = 06/25/2026,1.0.0.0
CatalogFile = cyw43455.cat

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%LiberNT% = Models,NTamd64,NTARM64

[Models]
%cyw43430.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_A9A6&FN_2
%cyw.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_A9BF&FN_2
%cyw.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_4345&FN_2

[Models.NTamd64]
%cyw43430.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_A9A6&FN_2
%cyw.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_A9BF&FN_2
%cyw.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_4345&FN_2

[Models.NTARM64]
%cyw43430.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_A9A6&FN_2
%cyw.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_A9BF&FN_2
%cyw.DeviceDesc% = cyw.ndi, SD\VID_02D0&PID_4345&FN_2
%cyw4387.DeviceDesc% = cyw.pcie.ndi, PCI\VEN_14E4&DEV_4433
%cyw4388.DeviceDesc% = cyw.pcie.ndi, PCI\VEN_14E4&DEV_4434

[cyw.ndi]
Characteristics = 0x84
*IfType          = 71
*MediaType       = 16
*PhysicalMediaType = 9
AddReg          = cyw.reg
CopyFiles       = cyw.CopyFiles

[cyw.ndi.Services]
AddService = cyw43455, 2, cyw.Service, cyw.EventLog

[cyw.pcie.ndi]
Characteristics = 0x84
AddReg          = cyw.reg
CopyFiles       = cyw.CopyFiles

[cyw.pcie.ndi.HW]
AddReg = cyw.pcie.HW.reg

[cyw.pcie.ndi.Services]
AddService = cyw43455, 2, cyw.Service, cyw.EventLog

[cyw.pcie.HW.reg]
HKR, "Interrupt Management",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MSISupported", 0x00010001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", "MessageNumberLimit", 0x00010001, 1

[cyw.reg]
HKR, ,                   *IfType,    0x00010001, 71
HKR, ,                   *MediaType, 0x00010001, 16
HKR, ,                   *PhysicalMediaType, 0x00010001, 9
HKR, Ndi,               Service,    0, "cyw43455"
HKR, Ndi\Interfaces,    UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,    LowerRange, 0, "nativewifi"

[cyw.CopyFiles]
cyw43455.sys

[cyw.Service]
DisplayName    = %cyw.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\cyw43455.sys
LoadOrderGroup = NDIS

[cyw.EventLog]
AddReg = cyw.EventLog.Reg

[cyw.EventLog.Reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
cyw43455.sys = 1

[Strings]
LiberNT         = "LiberNT Team"
cyw43430.DeviceDesc = "Broadcom BCM43430 802.11n SDIO WiFi Adapter"
cyw.DeviceDesc  = "Broadcom CYW43455 802.11ac SDIO WiFi Adapter"
cyw4387.DeviceDesc = "Broadcom BCM4387 802.11ax PCIe WiFi Adapter"
cyw4388.DeviceDesc = "Broadcom BCM4388 802.11ax PCIe WiFi Adapter"
cyw.ServiceDesc = "LiberNT CYW43xx WiFi Driver"
DiskName        = "LiberNT CYW43xx WiFi Driver Installation Disk"
