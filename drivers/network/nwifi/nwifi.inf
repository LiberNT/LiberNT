; LiberNT Native WiFi (802.11) filter - nwifi.sys
; Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>
;
; NDIS 6.x media-converting lightweight filter installed as a network service
; (NetService). It attaches to every Native 802.11 miniport and presents it
; as an 802.3 adapter to the protocols bound above it.

[Version]
Signature   = "$Windows NT$"
Class       = NetService
ClassGUID   = {4D36E974-E325-11CE-BFC1-08002BE10318}
Provider    = %LiberNT%
DriverVer   = 11/12/2026,1.1.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%LiberNT% = LiberNTDevices,NTx86,NTamd64,NTARM64

[LiberNTDevices.NTx86]
%Nwifi.DeviceDesc% = Nwifi.Install, nwifi

[LiberNTDevices.NTamd64]
%Nwifi.DeviceDesc% = Nwifi.Install, nwifi

[LiberNTDevices.NTARM64]
%Nwifi.DeviceDesc% = Nwifi.Install, nwifi

[Nwifi.Install]
AddReg           = Nwifi.Ndi.Reg
Characteristics  = 0x40000
NetCfgInstanceId = "{DDB50DEB-F71C-464F-91D6-AC8825F5A2D9}"
CopyFiles        = Nwifi.CopyFiles

[Nwifi.Install.Services]
AddService = Nwifi, 0, Nwifi.Service, Nwifi.EventLog

[Nwifi.Ndi.Reg]
HKR, Ndi,            Service,          0, "Nwifi"
HKR, Ndi,            CoServices,       0x00010000, "Nwifi"
HKR, Ndi,            HelpText,         0, %Nwifi.HelpText%
HKR, Ndi,            FilterClass,      0, "ms_medium_converter_top"
HKR, Ndi,            FilterType,       0x00010001, 2
HKR, Ndi,            FilterRunType,    0x00010001, 2
HKR, Ndi\Interfaces, FilterMediaTypes, 0, "wlan"
HKR, Ndi\Interfaces, UpperRange,       0, "ndis5"
HKR, Ndi\Interfaces, LowerRange,       0, "wlan"

[Nwifi.CopyFiles]
nwifi.sys

[Nwifi.Service]
DisplayName    = %Nwifi.ServiceDesc%
ServiceType    = 1      ; SERVICE_KERNEL_DRIVER
StartType      = 1      ; SERVICE_SYSTEM_START
ErrorControl   = 1      ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\nwifi.sys
LoadOrderGroup = NDIS

[Nwifi.EventLog]
AddReg = Nwifi.EventLog.Reg

[Nwifi.EventLog.Reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[Strings]
LiberNT            = "LiberNT Project"
Nwifi.DeviceDesc   = "LiberNT Native WiFi Filter"
Nwifi.ServiceDesc  = "LiberNT Native WiFi Service"
Nwifi.HelpText     = "Presents Native 802.11 adapters as 802.3 adapters to the TCP/IP stack"
