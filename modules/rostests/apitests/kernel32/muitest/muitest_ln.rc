#include <windef.h>
#include <winuser.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 MUI
BEGIN
    0xFECDFECDL, 0x000000E8L, 0x00010000L, 0x00000000L,
    0x00000011L, 0x00000000L, 0x00000002L,
    0x22222222L, 0x22222222L, 0x22222222L, 0x22222222L,
    0x11111111L, 0x11111111L, 0x11111111L, 0x11111111L,
    0x00000000L, 0x00000000L, 0x00000000L, 0x00000000L, 0x00000000L, 0x00000000L,
    0x00000088L, 0x0000001EL,
    0x000000A8L, 0x00000008L,
    0x000000B0L, 0x00000018L,
    0x000000C8L, 0x0000000CL,
    0x00000000L, 0x00000000L,
    0x000000D8L, 0x0000000CL,
    0x00000000L,
    L"MUI\0ZLNTYPE\0\0", 0x0000, 0x0000, 0x0000,
    0x0000000AL, 0x00000010L,
    L"ZMUITYPE\0\0", 0x0000, 0x0000,
    0x00000006L, 0x0000000AL, 0x00000010L, 0x00000000L,
    L"en-US\0", 0x0000, 0x0000
END

1 RCDATA
BEGIN
    L"ln one\0"
END

2 RCDATA
BEGIN
    L"ln two\0"
END

1 ZLNTYPE
BEGIN
    L"ln custom\0"
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "LiberNT MUI test module"
            VALUE "FileVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
