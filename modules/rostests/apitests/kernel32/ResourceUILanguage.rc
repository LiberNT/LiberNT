#include <windef.h>

#define IDS_RESOURCE_UI_LANGUAGE 4700

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_RESOURCE_UI_LANGUAGE "en"
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
