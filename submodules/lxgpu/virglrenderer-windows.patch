+      VkExternalMemoryBufferCreateInfo *info = (VkExternalMemoryBufferCreateInfo *)prev->pNext;
+      stripped = (info->handleTypes & VKR_FD_MEMORY_HANDLE_TYPES) != 0;
+      info->handleTypes &= ~VKR_FD_MEMORY_HANDLE_TYPES;
+      if (!info->handleTypes)
+         prev->pNext = (VkBaseOutStructure *)info->pNext;
+   }
+   return stripped;
+}
