diff --git a/src/venus/vkr_os.h b/src/venus/vkr_os.h
new file mode 100644
index 0000000..58c0bd9
--- /dev/null
+++ b/src/venus/vkr_os.h
@@ -0,0 +1,99 @@
+/*
+ * Copyright 2026 Ahmed ARIF
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_OS_H
+#define VKR_OS_H
+
+#include <stdint.h>
+
+#ifdef _WIN32
+
+#include <windows.h>
+
+/* On Windows a shared memory "fd" is a section handle value */
+#define VKR_SHM_MAP_FAILED NULL
+
+static inline int
+vkr_shm_create(uint64_t size)
+{
+   /* the Linux side maps shared memory with execute permission, like Linux shm */
+   HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_EXECUTE_READWRITE,
+                                       (DWORD)(size >> 32), (DWORD)size, NULL);
+   return section ? (int)(intptr_t)section : -1;
+}
+
+static inline void *
+vkr_shm_map(int fd, uint64_t size)
+{
+   return MapViewOfFile((HANDLE)(intptr_t)fd, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, (SIZE_T)size);
+}
+
+static inline void
+vkr_shm_unmap(void *ptr, uint64_t size)
+{
+   (void)size;
+   UnmapViewOfFile(ptr);
+}
+
+static inline void
+vkr_fd_close(int fd)
+{
+   CloseHandle((HANDLE)(intptr_t)fd);
+}
+
+static inline int
+vkr_fd_dup(int fd)
+{
+   HANDLE copy;
+
+   if (!DuplicateHandle(GetCurrentProcess(), (HANDLE)(intptr_t)fd, GetCurrentProcess(), &copy, 0, FALSE,
+                        DUPLICATE_SAME_ACCESS))
+      return -1;
+   return (int)(intptr_t)copy;
+}
+
+#else
+
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "util/anon_file.h"
+#include "util/os_file.h"
+
+#define VKR_SHM_MAP_FAILED MAP_FAILED
+
+static inline int
+vkr_shm_create(uint64_t size)
+{
+   return os_create_anonymous_file(size, "vkr-shmem");
+}
+
+static inline void *
+vkr_shm_map(int fd, uint64_t size)
+{
+   return mmap(NULL, size, PROT_WRITE | PROT_READ, MAP_SHARED, fd, 0);
+}
+
+static inline void
+vkr_shm_unmap(void *ptr, uint64_t size)
+{
+   munmap(ptr, size);
+}
+
+static inline void
+vkr_fd_close(int fd)
+{
+   close(fd);
+}
+
+static inline int
+vkr_fd_dup(int fd)
+{
+   return os_dupfd_cloexec(fd);
+}
+
+#endif
+
+#endif /* VKR_OS_H */
