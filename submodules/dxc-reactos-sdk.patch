diff --git a/include/dxc/dxcapi.h b/include/dxc/dxcapi.h
index d4cdc69c..02cd58b5 100644
--- a/include/dxc/dxcapi.h
+++ b/include/dxc/dxcapi.h
@@ -26,10 +26,55 @@
 #ifdef _WIN32
 
 #ifndef CROSS_PLATFORM_UUIDOF
+#ifdef __MINGW32__
+constexpr unsigned char dxc_mingw_hex(char c) {
+  return c >= '0' && c <= '9'   ? c - '0'
+         : c >= 'a' && c <= 'f' ? c - 'a' + 10
+         : c >= 'A' && c <= 'F' ? c - 'A' + 10
+                                : 0;
+}
+constexpr unsigned char dxc_mingw_byte(const char *s) {
+  return static_cast<unsigned char>(dxc_mingw_hex(s[0]) << 4 | dxc_mingw_hex(s[1]));
+}
+constexpr GUID dxc_mingw_guid(const char *s) {
+  return GUID{static_cast<unsigned long>(dxc_mingw_byte(s)) << 24 |
+                  static_cast<unsigned long>(dxc_mingw_byte(s + 2)) << 16 |
+                  static_cast<unsigned long>(dxc_mingw_byte(s + 4)) << 8 |
+                  dxc_mingw_byte(s + 6),
+              static_cast<unsigned short>(dxc_mingw_byte(s + 9) << 8 | dxc_mingw_byte(s + 11)),
+              static_cast<unsigned short>(dxc_mingw_byte(s + 14) << 8 | dxc_mingw_byte(s + 16)),
+              {dxc_mingw_byte(s + 19), dxc_mingw_byte(s + 21), dxc_mingw_byte(s + 24),
+               dxc_mingw_byte(s + 26), dxc_mingw_byte(s + 28), dxc_mingw_byte(s + 30),
+               dxc_mingw_byte(s + 32), dxc_mingw_byte(s + 34)}};
+}
+#ifdef __REACTOS__
+#define CROSS_PLATFORM_UUIDOF(interface, spec)                                 \
+  struct __declspec(uuid(spec)) interface;                                     \
+  extern "C++" {                                                               \
+  template <> struct __reactos_uuidof_s<interface> {                           \
+    static constexpr GUID value = dxc_mingw_guid(spec);                        \
+    static constexpr const GUID &get() { return value; }                       \
+  };                                                                           \
+  }
+#else
+#define CROSS_PLATFORM_UUIDOF(interface, spec)                                 \
+  struct __declspec(uuid(spec)) interface;                                     \
+  extern "C++" {                                                               \
+  template <> inline const GUID &__mingw_uuidof<interface>() {                 \
+    static const GUID guid = dxc_mingw_guid(spec);                             \
+    return guid;                                                               \
+  }                                                                            \
+  template <> inline const GUID &__mingw_uuidof<interface *>() {               \
+    return __mingw_uuidof<interface>();                                        \
+  }                                                                            \
+  }
+#endif
+#else
 // Warning: This macro exists in WinAdapter.h as well
 #define CROSS_PLATFORM_UUIDOF(interface, spec)                                 \
   struct __declspec(uuid(spec)) interface;
 #endif
+#endif
 
 #else
 
