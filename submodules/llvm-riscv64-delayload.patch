   ThunkChunkRISCV64(Defined *i, Chunk *tm) : imp(i), tailMerge(tm) {
@@ -1334,6 +1386,10 @@ Chunk *DelayLoadContents::newTailMergePDataChunk(SymbolTable &symtab,
     if (!symtab.tailMergeUnwindInfoChunk)
       symtab.tailMergeUnwindInfoChunk = make<TailMergeUnwindInfoARM64>();
     return make<TailMergePDataChunkARM64>(tm, symtab.tailMergeUnwindInfoChunk);
+  case RISCV64:
+    if (!symtab.tailMergeUnwindInfoChunk)
+      symtab.tailMergeUnwindInfoChunk = make<TailMergeUnwindInfoRISCV64>();
+    return make<TailMergePDataChunkRISCV64>(tm, symtab.tailMergeUnwindInfoChunk);
     // FIXME: Add support for other architectures.
