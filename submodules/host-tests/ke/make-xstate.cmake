file(READ "${XSTATE_SOURCE}" SOURCE)
file(READ "${FIXTURE}" TEST)
string(FIND "${SOURCE}" "static\nVOID\nKiGetXStateConfiguration(" BEGIN)
string(FIND "${SOURCE}" "\nCODE_SEG(\"INIT\")\nstatic\nVOID\nValidateXStateConfig(" END)
if(BEGIN LESS 0 OR END LESS BEGIN)
    message(FATAL_ERROR "Unable to find the XSTATE configuration routine")
endif()
math(EXPR LENGTH "${END} - ${BEGIN}")
string(SUBSTRING "${SOURCE}" ${BEGIN} ${LENGTH} FUNCTION)
string(FIND "${TEST}" "@XSTATE_FUNCTION@" MARKER)
if(MARKER LESS 0)
    message(FATAL_ERROR "Unable to find the XSTATE fixture marker")
endif()
string(REPLACE "@XSTATE_FUNCTION@" "${FUNCTION}" TEST "${TEST}")
file(WRITE "${OUTPUT}" "${TEST}")
