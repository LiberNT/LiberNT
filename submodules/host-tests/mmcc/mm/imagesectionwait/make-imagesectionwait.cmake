file(READ "${NTSECTION_SOURCE}" SOURCE)
file(READ "${FIXTURE}" TEST)
string(FIND "${SOURCE}" "static\nNTSTATUS\nMiCreateImageControlAreaWaiting(" BEGIN)
string(FIND "${SOURCE}" "\nstatic\nVOID\nNTAPI\nMiDeleteSection(" END)
if(BEGIN LESS 0 OR END LESS BEGIN)
    message(FATAL_ERROR "Unable to find the waiting image control area routine")
endif()
math(EXPR LENGTH "${END} - ${BEGIN}")
string(SUBSTRING "${SOURCE}" ${BEGIN} ${LENGTH} FUNCTION)
string(FIND "${TEST}" "@NTSECTION_FUNCTION@" MARKER)
if(MARKER LESS 0)
    message(FATAL_ERROR "Unable to find the image section fixture marker")
endif()
string(REPLACE "@NTSECTION_FUNCTION@" "${FUNCTION}" TEST "${TEST}")
file(WRITE "${OUTPUT}" "${TEST}")
