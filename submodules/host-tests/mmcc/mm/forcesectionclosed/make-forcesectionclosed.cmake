file(READ "${NTSECTION_SOURCE}" SOURCE)
file(READ "${FIXTURE}" TEST)
string(FIND "${SOURCE}" "BOOLEAN\nNTAPI\nMmForceSectionClosedEx(" BEGIN)
string(FIND "${SOURCE}" "\nBOOLEAN\nNTAPI\nMmDisableModifiedWriteOfSection(" END)
if(BEGIN LESS 0 OR END LESS BEGIN)
    message(FATAL_ERROR "Unable to find MmForceSectionClosedEx")
endif()
math(EXPR LENGTH "${END} - ${BEGIN}")
string(SUBSTRING "${SOURCE}" ${BEGIN} ${LENGTH} FUNCTION)
string(FIND "${TEST}" "@NTSECTION_FUNCTION@" MARKER)
if(MARKER LESS 0)
    message(FATAL_ERROR "Unable to find the fixture marker")
endif()
string(REPLACE "@NTSECTION_FUNCTION@" "${FUNCTION}" TEST "${TEST}")
file(WRITE "${OUTPUT}" "${TEST}")
