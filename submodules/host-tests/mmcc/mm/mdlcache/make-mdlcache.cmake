file(READ "${NTMDL_SOURCE}" SOURCE)
file(READ "${FIXTURE}" TEST)
string(FIND "${SOURCE}" "PMDL\nNTAPI\nMmAllocatePagesForMdlEx(" BEGIN)
string(FIND "${SOURCE}" "\nPMDL\nNTAPI\nMmAllocatePagesForMdl(" END)
if(BEGIN LESS 0 OR END LESS BEGIN)
    message(FATAL_ERROR "Unable to find the MDL allocation routine")
endif()
math(EXPR LENGTH "${END} - ${BEGIN}")
string(SUBSTRING "${SOURCE}" ${BEGIN} ${LENGTH} FUNCTION)
string(FIND "${TEST}" "@NTMDL_FUNCTION@" MARKER)
if(MARKER LESS 0)
    message(FATAL_ERROR "Unable to find the MDL fixture marker")
endif()
string(REPLACE "@NTMDL_FUNCTION@" "${FUNCTION}" TEST "${TEST}")
file(WRITE "${OUTPUT}" "${TEST}")
