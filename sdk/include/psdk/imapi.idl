cpp_quote("DEFINE_GUID(CLSID_MSDiscMasterObj, 0x520cca63, 0x51a5, 0x11d3, 0x91, 0x44, 0x00, 0x10, 0x4b, 0xa1, 0x1c, 0x5e);")
cpp_quote("DEFINE_GUID(CLSID_MSEnumDiscRecordersObj, 0x8a03567a, 0x63cb, 0x4ba8, 0xba, 0xf6, 0x52, 0x11, 0x98, 0x16, 0xd1, 0xef);")
