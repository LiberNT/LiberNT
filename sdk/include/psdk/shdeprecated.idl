    IShellView          *_psv;
    IShellFolder        *_psf;
    HWND                _hwndView;
    LPWSTR              _pszTitleCur;

    PIDLIST_ABSOLUTE    _pidlPending;
    IShellView          *_psvPending;
    IShellFolder        *_psfPending;
    HWND                _hwndViewPending;
    LPWSTR              _pszTitlePending;

    BOOL                _fIsViewMSHTML;
    BOOL                _fPrivacyImpacted;
