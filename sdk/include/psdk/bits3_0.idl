    HRESULT GetOwnerIntegrityLevel([out, ref] ULONG *level);
    HRESULT GetOwnerElevationState([out, ref] BOOL *elevated);
    HRESULT SetMaximumDownloadTime(ULONG timeout);
    HRESULT GetMaximumDownloadTime([out,ref] ULONG *timeout);
}

