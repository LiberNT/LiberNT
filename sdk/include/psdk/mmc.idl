  int      nBitmap;
  int      idCommand;
  BYTE     fsState;
  BYTE     fsType;
  LPOLESTR lpButtonText;
  LPOLESTR lpTooltipText;
} MMCBUTTON, *LPMMCBUTTON;
#pragma pack(pop)


