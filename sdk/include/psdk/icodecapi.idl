import "unknwn.idl";
import "oaidl.idl";

interface IStream;

struct CodecAPIEventData
{
    GUID  guid;
    DWORD dataLength;
    DWORD reserved[3];
};

[
    uuid(901db4c7-31ce-41a2-85dc-8fa0bf41b8da),
    local,
    object,
    pointer_default(unique)
]
interface ICodecAPI : IUnknown
{
    HRESULT IsSupported ([in] const GUID *api);
    HRESULT IsModifiable ([in] const GUID *api);

    HRESULT GetParameterRange ([in] const GUID *api, [out] VARIANT *min, [out] VARIANT *max, [out] VARIANT *delta);
    HRESULT GetParameterValues ([in] const GUID *api, [out, size_is(,*count)] VARIANT **values, [out] ULONG *count);
    HRESULT GetDefaultValue ([in] const GUID *api, [out] VARIANT *value);

    HRESULT GetValue ([in] const GUID *api, [out] VARIANT *value);
    HRESULT SetValue ([in] const GUID *api, [in] VARIANT *value);

    HRESULT RegisterForEvent ([in] const GUID *api, [in] LONG_PTR userData);
    HRESULT UnregisterForEvent ([in] const GUID *api);

    HRESULT SetAllDefaults(void);

    HRESULT SetValueWithNotify ([in] const GUID *api, [in] VARIANT *value, [out, size_is(,*count)] GUID **param, [out] ULONG *count);

    HRESULT SetAllDefaultsWithNotify([out, size_is(,*count)] GUID **param, [out] ULONG *count);

    HRESULT GetAllSettings([in] IStream *stream);
    HRESULT SetAllSettings([in] IStream *stream);

    HRESULT SetAllSettingsWithNotify([in] IStream* stream, [out, size_is(,*count)] GUID **param, [out] ULONG *count);
}

cpp_quote("struct ICodecAPIVtbl")
cpp_quote("{")
cpp_quote("    HRESULT (WINAPI *QueryInterface)(ICodecAPI *, const IID *const , void **);")
cpp_quote("    ULONG (WINAPI *AddRef)(ICodecAPI *);")
cpp_quote("    ULONG (WINAPI *Release)(ICodecAPI *);")
cpp_quote("    HRESULT (WINAPI *IsSupported)(ICodecAPI *, const GUID *);")
cpp_quote("    HRESULT (WINAPI *IsModifiable)(ICodecAPI *, const GUID *);")
cpp_quote("    HRESULT (WINAPI *GetParameterRange)(ICodecAPI *, const GUID *, VARIANT *, VARIANT *, VARIANT *);")
cpp_quote("    HRESULT (WINAPI *GetParameterValues)(ICodecAPI *, const GUID *, VARIANT **, ULONG *);")
cpp_quote("    HRESULT (WINAPI *GetDefaultValue)(ICodecAPI *, const GUID *, VARIANT *);")
cpp_quote("    HRESULT (WINAPI *GetValue)(ICodecAPI *, const GUID *, VARIANT *);")
cpp_quote("    HRESULT (WINAPI *SetValue)(ICodecAPI *, const GUID *, VARIANT *);")
cpp_quote("    HRESULT (WINAPI *RegisterForEvent)(ICodecAPI *, const GUID *, LONG_PTR);")
cpp_quote("    HRESULT (WINAPI *UnregisterForEvent)(ICodecAPI *, const GUID *);")
cpp_quote("    HRESULT (WINAPI *SetAllDefaults)(ICodecAPI *);")
cpp_quote("    HRESULT (WINAPI *SetValueWithNotify)(ICodecAPI *, const GUID *, VARIANT *, GUID **, ULONG *);")
cpp_quote("    HRESULT (WINAPI *SetAllDefaultsWithNotify)(ICodecAPI *, GUID **, ULONG *);")
cpp_quote("    HRESULT (WINAPI *GetAllSettings)(ICodecAPI *, IStream *);")
cpp_quote("    HRESULT (WINAPI *SetAllSettings)(ICodecAPI *, IStream *);")
cpp_quote("    HRESULT (WINAPI *SetAllSettingsWithNotify)(ICodecAPI *, IStream *, GUID **, ULONG *);")
cpp_quote("};")
