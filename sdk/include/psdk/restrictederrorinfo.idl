import "oaidl.idl";

[
    object,
    uuid(82ba7092-4c88-427d-a7bc-16dd93feb67e),
    pointer_default(unique)
]
interface IRestrictedErrorInfo : IUnknown
{
    HRESULT GetErrorDetails (
        [out] BSTR *desc,
        [out] HRESULT *error,
        [out] BSTR *restricted_desc,
        [out] BSTR *sid);

    HRESULT GetReference ([out] BSTR *reference);
}

