    ADS_CHASE_REFERRALS_ALWAYS      = ADS_CHASE_REFERRALS_SUBORDINATE | ADS_CHASE_REFERRALS_EXTERNAL
} ADS_CHASE_REFERRALS_ENUM;

typedef enum
{
    ADS_STATUS_S_OK,
    ADS_STATUS_INVALID_SEARCHPREF,
