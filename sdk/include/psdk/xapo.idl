cpp_quote("#define IXAPO_AddRef(This) ((This) -> lpVtbl -> AddRef(This))")
cpp_quote("#define IXAPO_CalcInputFrames(This, OutputFrameCount) ((This) -> lpVtbl -> CalcInputFrames(This, OutputFrameCount))")
cpp_quote("#define IXAPO_CalcOutputFrames(This, InputFrameCount) ((This) -> lpVtbl -> CalcOutputFrames(This, InputFrameCount))")
cpp_quote("#define IXAPO_GetRegistrationProperties(This, ppRegistrationProperties) ((This) -> lpVtbl -> GetRegistrationProperties(This, ppRegistrationProperties))")
cpp_quote("#define IXAPO_Initialize(This, pData, DataByteSize) ((This) -> lpVtbl -> Initialize(This, pData, DataByteSize))")
cpp_quote("#define IXAPO_IsInputFormatSupported(This, pOutputFormat, pRequestedInputFormat, ppSupportedInputFormat) ((This) -> lpVtbl -> IsInputFormatSupported(This, pOutputFormat, pRequestedInputFormat, ppSupportedInputFormat))")
cpp_quote("#define IXAPO_IsOutputFormatSupported(This, pInputFormat, pRequestedOutputFormat, ppSupportedOutputFormat) ((This) -> lpVtbl -> IsOutputFormatSupported(This, pInputFormat, pRequestedOutputFormat, ppSupportedOutputFormat))")
cpp_quote("#define IXAPO_LockForProcess(This, InputLockedParameterCount, pInputLockedParameters, OutputLockedParameterCount, pOutputLockedParameters) ((This) -> lpVtbl -> LockForProcess(This, InputLockedParameterCount, pInputLockedParameters, OutputLockedParameterCount, pOutputLockedParameters))")
cpp_quote("#define IXAPO_Process(This, InputProcessParameterCount, pInputProcessParameters, OutputProcessParameterCount, pOutputProcessParameters, IsEnabled) ((This) -> lpVtbl -> Process(This, InputProcessParameterCount, pInputProcessParameters, OutputProcessParameterCount, pOutputProcessParameters, IsEnabled))")
cpp_quote("#define IXAPO_QueryInterface(This, riid, ppInterface) ((This) -> lpVtbl -> QueryInterface(This, riid, ppInterface))")
cpp_quote("#define IXAPO_Release(This) ((This) -> lpVtbl -> Release(This))")
cpp_quote("#define IXAPO_Reset(This) ((This) -> lpVtbl -> Reset(This))")
cpp_quote("#define IXAPO_UnlockForProcess(This) ((This) -> lpVtbl -> UnlockForProcess(This))")
cpp_quote("#define IXAPOParameters_AddRef(This) ((This) -> lpVtbl -> AddRef(This))")
cpp_quote("#define IXAPOParameters_GetParameters(This, pParameters, ParameterByteSize) ((This) -> lpVtbl -> GetParameters(This, pParameters, ParameterByteSize))")
cpp_quote("#define IXAPOParameters_QueryInterface(This, riid, ppInterface) ((This) -> lpVtbl -> QueryInterface(This, riid, ppInterface))")
cpp_quote("#define IXAPOParameters_Release(This) ((This) -> lpVtbl -> Release(This))")
cpp_quote("#define IXAPOParameters_SetParameters(This, pParameters, ParameterByteSize) ((This) -> lpVtbl -> SetParameters(This, pParameters, ParameterByteSize))")
cpp_quote("#define XAPOAlloc(size) CoTaskMemAlloc(size)")
cpp_quote("#define XAPOFree(p) CoTaskMemFree(p)")

