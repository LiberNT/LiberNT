set(RV64X_CLANG "" CACHE FILEPATH "Clang with the RV64X pass (submodules/llvm-rv64x.patch)")
unset(RV64X_COMPILER_LAUNCHER CACHE)
unset(RV64X_COMPILER_LAUNCHER)
if(RV64X_CLANG AND ENABLE_FELIX86)
    execute_process(COMMAND ${CMAKE_C_COMPILER} -print-resource-dir
                    OUTPUT_VARIABLE _rv64x_resource_dir OUTPUT_STRIP_TRAILING_WHITESPACE)
    file(WRITE ${CMAKE_BINARY_DIR}/rv64x-cc
         "#!/bin/sh\nshift\nexec \"${RV64X_CLANG}\" -resource-dir \"${_rv64x_resource_dir}\" \"$@\"\n")
    file(CHMOD ${CMAKE_BINARY_DIR}/rv64x-cc PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE
         WORLD_READ WORLD_EXECUTE)
    set(RV64X_COMPILER_LAUNCHER ${CMAKE_BINARY_DIR}/rv64x-cc)
endif()

option(RV64X_SYSTEM "Build every user-mode module of a riscv64 build as RV64X; needs RV64X_CLANG" OFF)
if(RV64X_COMPILER_LAUNCHER AND RV64X_SYSTEM)
    set(CMAKE_C_COMPILER_LAUNCHER ${RV64X_COMPILER_LAUNCHER})
    set(CMAKE_CXX_COMPILER_LAUNCHER ${RV64X_COMPILER_LAUNCHER})
    add_compile_options("$<$<AND:$<COMPILE_LANGUAGE:C,CXX>,$<NOT:$<BOOL:$<TARGET_PROPERTY:RV64X_EXCLUDE>>>>:SHELL:-mllvm -riscv-rv64x>")
endif()

function(_rv64x_collect_targets _dir _out)
    get_property(_targets DIRECTORY ${_dir} PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_subdirs DIRECTORY ${_dir} PROPERTY SUBDIRECTORIES)
    foreach(_subdir IN LISTS _subdirs)
        _rv64x_collect_targets(${_subdir} _sub)
        list(APPEND _targets ${_sub})
    endforeach()
    set(${_out} ${_targets} PARENT_SCOPE)
endfunction()

function(_rv64x_linked_libraries _target _out)
    set(_libraries)
    get_target_property(_type ${_target} TYPE)
    if(NOT _type STREQUAL "INTERFACE_LIBRARY")
        get_target_property(_linked ${_target} LINK_LIBRARIES)
        if(_linked)
            list(APPEND _libraries ${_linked})
        endif()
    endif()
    get_target_property(_interface ${_target} INTERFACE_LINK_LIBRARIES)
    if(_interface)
        list(APPEND _libraries ${_interface})
    endif()
    set(_result)
    foreach(_library IN LISTS _libraries)
        if(TARGET ${_library})
            get_target_property(_imported ${_library} IMPORTED)
            get_target_property(_library_type ${_library} TYPE)
            if(NOT _imported AND _library_type MATCHES "^(STATIC_LIBRARY|OBJECT_LIBRARY|INTERFACE_LIBRARY)$")
                list(APPEND _result ${_library})
            endif()
        endif()
    endforeach()
    set(${_out} ${_result} PARENT_SCOPE)
endfunction()

function(_rv64x_library_closure _roots _out)
    set(_pending ${_roots})
    set(_closure)
    while(_pending)
        list(POP_FRONT _pending _library)
        if(_library IN_LIST _closure)
            continue()
        endif()
        list(APPEND _closure ${_library})
        _rv64x_linked_libraries(${_library} _libraries)
        list(APPEND _pending ${_libraries})
    endwhile()
    set(${_out} ${_closure} PARENT_SCOPE)
endfunction()

function(rv64x_exclude_kernel_libraries)
    if(NOT (RV64X_COMPILER_LAUNCHER AND RV64X_SYSTEM))
        return()
    endif()
    _rv64x_collect_targets(${CMAKE_SOURCE_DIR} _all)
    set(_kernel_roots)
    set(_user_roots)
    foreach(_target IN LISTS _all)
        get_target_property(_type ${_target} TYPE)
        if(NOT _type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
            continue()
        endif()
        _rv64x_linked_libraries(${_target} _libraries)
        get_target_property(_exclude ${_target} RV64X_EXCLUDE)
        if(_exclude)
            list(APPEND _kernel_roots ${_libraries})
        else()
            list(APPEND _user_roots ${_libraries})
        endif()
    endforeach()
    _rv64x_library_closure("${_kernel_roots}" _kernel)
    _rv64x_library_closure("${_user_roots}" _user)
    foreach(_library IN LISTS _kernel)
        get_target_property(_type ${_library} TYPE)
        if(NOT _type STREQUAL "INTERFACE_LIBRARY" AND NOT _library IN_LIST _user)
            set_target_properties(${_library} PROPERTIES RV64X_EXCLUDE ON)
        endif()
    endforeach()
endfunction()
