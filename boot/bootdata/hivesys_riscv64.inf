; PROJECT:     ReactOS RISC-V64 system hive
; LICENSE:     GPL-3.0-or-later
; PURPOSE:     RISC-V64-specific registry entries
; COPYRIGHT:   Copyright 2026 Ahmed ARIF

[AddReg]
HKLM,"SOFTWARE\Microsoft\Wow64\x86",,0x00000000,"wow64felix.dll"
HKLM,"SOFTWARE\Microsoft\.NETFramework","InstallRoot",0x00000000,"C:\Windows\Microsoft.NET\Framework64\"
HKLM,"SOFTWARE\Wow6432Node",,0x00000012
HKLM,"SOFTWARE\Classes\Wow6432Node",,0x00000012

; Private native print environment. Keep this synchronized with
; prtprocenv.h and SetupAPI's DIRID_PRINTPROCESSOR directory token.
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\ReactOS RISC-V64","Directory",,"riscv64"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\ReactOS RISC-V64\Print Processors",,0x00000010
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\ReactOS RISC-V64\Print Processors\winprint","Driver",,"winprint.dll"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT x86","Directory",,"W32X86"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT x86\Drivers\Version-3","Directory",,"3"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT x86\Drivers\Version-3","MajorVersion",0x00010001,3
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT x86\Drivers\Version-3","MinorVersion",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT x86\Print Processors",,0x00000010

; The HAL enumerates the device-tree platform and implements no ACPI interfaces,
; so acpi.sys is not built.
; TODO(riscv64): take the ARM64 ACPI path once the HAL implements it.
HKLM,"SYSTEM\CurrentControlSet\Services\acpi","Start",0x00010001,0x00000004
