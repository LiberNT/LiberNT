; FILE:        boot/bootdata/hivesys_arm64.inf
; PURPOSE:     ARM64 boot-start driver registry entries
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[AddReg]

HKLM,"SOFTWARE\Microsoft\Wow64\x86",,0x00000000,"wow64fex.dll"
HKLM,"SOFTWARE\Microsoft\.NETFramework","InstallRoot",0x00000000,"C:\Windows\Microsoft.NET\Framework64\"
HKLM,"SOFTWARE\Wow6432Node",,0x00000012
HKLM,"SOFTWARE\Classes\Wow6432Node",,0x00000012

HKLM,"SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management","LargeStackSize",0x00010001,0x00028000

; Native print environment. Keep this synchronized with winprint packaging.
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows ARM64","Directory",,"ARM64"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows ARM64\Print Processors",,0x00000010
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows ARM64\Print Processors\winprint","Driver",,"winprint.dll"

; Raspberry Pi 5 RP1 southbridge: no OS bus driver. The UEFI firmware exposes
; the RP1 functions (USB XHC0/XHC1, Ethernet ETH0) as standard ACPI devices
; under the RP1B ACPI0004 container and hides the RP1 PCIe endpoint, so acpi.sys
; enumerates them generically and in-box/generic function drivers bind directly
; (ETH0 -> ACPI\RPI5ETH -> rp1gem). This matches how Windows consumes RP1, so no
; rp1.sys (and no PCI\VEN_1DE4 CriticalDeviceDatabase seed) is required.

; The RP1 Ethernet controller (RP1\GEM) is intentionally not seeded here:
; it is a regular PnP NDIS miniport, installed at runtime from netrp1gem.inf
; so that netcfgx creates NetCfgInstanceId, Linkage, the Connection object
; and the Tcpip interface parameters.

; The software-only vwifi test adapter is not enumerated by default.
; Its ROOT\VWIFI device can be installed manually with netvwifi.inf.

HKLM,"SYSTEM\CurrentControlSet\Services\cyw43455","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\cyw43455","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\cyw43455","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\cyw43455","ImagePath",0x00020000,"system32\drivers\cyw43455.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\cyw43455","Group",0x00000000,"NDIS"
HKLM,"SYSTEM\CurrentControlSet\Services\cyw43455","DisplayName",0x00000000,"ReactOS CYW43455 WiFi Driver"
