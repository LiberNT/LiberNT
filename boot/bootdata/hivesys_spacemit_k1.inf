[AddReg]

HKLM,"SYSTEM\CurrentControlSet\Services\k1xdwc3","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\k1xdwc3","Group",0x00000000,"Boot Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\k1xdwc3","ImagePath",0x00020000,"system32\drivers\k1xdwc3.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\k1xdwc3","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\k1xdwc3","Type",0x00010001,0x00000001

HKLM,"SYSTEM\CurrentControlSet\Services\k1xpmic","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\k1xpmic","ImagePath",0x00020000,"system32\drivers\k1xpmic.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\k1xpmic","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\k1xpmic","Type",0x00010001,0x00000001

HKLM,"SYSTEM\CurrentControlSet\Services\k1xthermal","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\k1xthermal","ImagePath",0x00020000,"system32\drivers\k1xthermal.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\k1xthermal","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\k1xthermal","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\k1xwdt","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\k1xwdt","ImagePath",0x00020000,"system32\drivers\k1xwdt.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\k1xwdt","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\k1xwdt","Type",0x00010001,0x00000001
