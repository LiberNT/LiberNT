; PROJECT:     ReactOS AMD64 system hive
; LICENSE:     GPL-2.0+
; PURPOSE:     AMD64-specific registry entries

[AddReg]

HKLM,"SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management","LargeStackSize",0x00010001,0x00028000
HKLM,"SOFTWARE\Microsoft\.NETFramework","InstallRoot",0x00000000,"C:\Windows\Microsoft.NET\Framework64\"

; Native print environment. Keep this synchronized with winprint packaging.
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows x64","Directory",,"x64"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows x64\Print Processors",,0x00000010
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows x64\Print Processors\winprint","Driver",,"winprint.dll"

HKLM,"SYSTEM\CurrentControlSet\Services\vmbus","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\vmbus","Group",0x00000000,"System Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\vmbus","ImagePath",0x00020000,"system32\drivers\vmbus.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\vmbus","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\vmbus","Type",0x00010001,0x00000001

HKLM,"SYSTEM\CurrentControlSet\Services\storvsc","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\storvsc","Group",0x00000000,"SCSI Miniport"
HKLM,"SYSTEM\CurrentControlSet\Services\storvsc","ImagePath",0x00020000,"system32\drivers\storvsc.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\storvsc","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\storvsc","Type",0x00010001,0x00000001
