; Processor devices

[Version]
Signature  = "$Windows NT$"
Class      = Processor
ClassGuid  = {50127DC3-0F36-415E-A6CC-4CB3BE910B65}
Provider   = %LiberNT%
DriverVer  = 10/05/2026,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

[ClassInstall32.NT]
AddProperty=ClassProperties.AddProperty
AddReg = ProcessorClass.NT.AddReg

[ProcessorClass.NT.AddReg]
HKR, , , 0, %ProcessorClassName%
HKR, , Icon, 0, "-28"
HKR, , NoInstallClass, 0, "1"

[Manufacturer]
%StdMfg% = StdMfg

[StdMfg]
%processor.DeviceDesc% = Processor_Inst, ACPI\VEN_ACPI&DEV_0007
%processor.DeviceDesc% = Processor_Inst, ACPI\ACPI0007
%processor.DeviceDesc% = Processor_Inst, ACPI\Processor

[Processor_Inst.NT]
CopyFiles = Processor_CopyFiles

[Processor_CopyFiles]
processr.sys

[Processor_Inst.NT.Services]
AddService = Processor, 0x00000002, Processor_Service

[Processor_Service]
DisplayName    = %Processor.SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\processr.sys
LoadOrderGroup = Extended Base

[ClassProperties.AddProperty]
{6a3433f4-5626-40e8-a9b9-dbd9ecd2884b},3,0x11,,1
{6a3433f4-5626-40e8-a9b9-dbd9ecd2884b},4,0x11,,1
{6a3433f4-5626-40e8-a9b9-dbd9ecd2884b},6,0x11,,1

[Strings]
LiberNT = "LiberNT Team"
ProcessorClassName = "Processors"
StdMfg = "(Standard processor types)"
processor.DeviceDesc = "Processor"
Processor.SvcDesc = "Processor Driver"
